{% include 'admin/overall_header.html.twig' %}
<div class="stack">
<nav class="tabs" aria-label="{{ LNG.ad_editor_title }}">
  <a href="{{ path('admin_account_editor_show') }}">{{ icon('layout-dashboard') }}{{ LNG.ad_editor_title }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'buildings'}) }}">{{ icon('building-2') }}{{ LNG.ad_editor_buildings }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'ships'}) }}">{{ icon('rocket') }}{{ LNG.ad_editor_ships }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'defenses'}) }}">{{ icon('shield') }}{{ LNG.ad_editor_defenses }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'researchs'}) }}">{{ icon('flask-conical') }}{{ LNG.ad_editor_researchs }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'resources'}) }}">{{ icon('database') }}{{ LNG.ad_editor_resources }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'planets'}) }}" aria-current="page">{{ icon('orbit') }}{{ LNG.ad_editor_planets }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'personal'}) }}">{{ icon('user') }}{{ LNG.ad_editor_personal }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'alliances'}) }}">{{ icon('handshake') }}{{ LNG.ad_editor_alliances }}</a>
  <a href="{{ path('admin_account_editor_tab', {tab: 'achievements'}) }}">{{ icon('award') }}{{ LNG.ad_editor_achievements }}</a>
</nav>
  <form action="" method="post" data-track-dirty>
    <div class="stack">
      <section class="card">
        <header class="card__head"><h2 class="card__title">{{ icon('orbit') }}{{ LNG.ad_pla_title }}</h2></header>
        <div class="card__body form-grid">
          <div class="field-row">
            <label for="ae-id">{{ LNG.input_id_p_m }}</label>
            <div class="field-control"><input id="ae-id" name="id" type="text" inputmode="numeric"></div>
          </div>
          <div class="field-row">
            <label for="ae-name">{{ LNG.ad_pla_edit_name }}</label>
            <div class="field-control"><input id="ae-name" name="name" type="text"></div>
          </div>
          <div class="field-row">
            <label for="ae-diameter">{{ LNG.ad_pla_edit_diameter }}</label>
            <div class="field-control"><input id="ae-diameter" class="num" name="diameter" type="text" inputmode="numeric"></div>
          </div>
          <div class="field-row">
            <label for="ae-fields">{{ LNG.ad_pla_edit_fields }}</label>
            <div class="field-control"><input id="ae-fields" class="num" name="fields" type="text" inputmode="numeric"></div>
          </div>
          <div class="field-row">
            <span class="field-label"><a href="#" class="tooltip" data-tooltip-content="{{ LNG.ad_pla_title_l }}">{{ LNG.ad_pla_change_p }}</a></span>
            <div class="stack">
              <label class="check"><input name="change_position" type="checkbox">{{ LNG.ad_pla_change_pp }}</label>
              <div class="fields">
                <div class="field"><label for="ae-galaxy">G</label><input id="ae-galaxy" name="galaxy" class="num" type="text" inputmode="numeric"></div>
                <div class="field"><label for="ae-system">S</label><input id="ae-system" name="system" class="num" type="text" inputmode="numeric"></div>
                <div class="field"><label for="ae-planet">P</label><input id="ae-planet" name="planet" class="num" type="text" inputmode="numeric"></div>
              </div>
            </div>
            <div class="field-help">{{ LNG.ad_pla_title_l }}</div>
          </div>
        </div>
      </section>
      <section class="card card--danger">
        <header class="card__head"><h2 class="card__title">{{ icon('trash-2') }}{{ LNG.adm_ae_wipe }}</h2></header>
        <div class="card__body stack">
          <div class="notice notice--warning">{{ icon('triangle-alert') }}<div>{{ LNG.adm_ae_wipe_hint }}</div></div>
          <div class="stack">
            <label class="check"><input name="0_buildings" type="checkbox">{{ LNG.ad_pla_delete_b }}</label>
            <label class="check"><input name="0_ships" type="checkbox">{{ LNG.ad_pla_delete_s }}</label>
            <label class="check"><input name="0_defenses" type="checkbox">{{ LNG.ad_pla_delete_d }}</label>
            <label class="check"><input name="0_c_hangar" type="checkbox">{{ LNG.ad_pla_delete_hd }}</label>
            <label class="check"><input name="0_c_buildings" type="checkbox">{{ LNG.ad_pla_delete_cb }}</label>
          </div>
        </div>
      </section>
      <div class="form-actions">
        <button type="reset">{{ icon('eraser') }}{{ LNG.button_reset }}</button>
        <button type="submit" class="btn--primary">{{ icon('save') }}{{ LNG.button_submit }}</button>
      </div>
    </div>
  </form>
</div>
{% include 'admin/overall_footer.html.twig' %}
