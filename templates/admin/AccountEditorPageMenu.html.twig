{% include 'admin/overall_header.html.twig' %}
<div class="stack">
  <div class="notice notice--info">{{ icon('info') }}<div>{{ LNG.adm_ae_menu_hint }}</div></div>
  <div class="cols">
    <section class="card">
      <header class="card__head"><h2 class="card__title">{{ LNG.adm_ae_group_player }}</h2></header>
      <div class="card__body">
        <div class="quick-links">
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'personal'}) }}">{{ icon('user') }}<span>{{ LNG.ad_editor_personal }}</span></a>
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'researchs'}) }}">{{ icon('flask-conical') }}<span>{{ LNG.ad_editor_researchs }}</span></a>
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'alliances'}) }}">{{ icon('handshake') }}<span>{{ LNG.ad_editor_alliances }}</span></a>
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'achievements'}) }}">{{ icon('award') }}<span>{{ LNG.ad_editor_achievements }}</span></a>
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'relics'}) }}">{{ icon('star') }}<span>{{ LNG.ad_editor_relics }}</span></a>
        </div>
      </div>
    </section>
    <section class="card">
      <header class="card__head"><h2 class="card__title">{{ LNG.adm_ae_group_planet }}</h2></header>
      <div class="card__body">
        <div class="quick-links">
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'planets'}) }}">{{ icon('orbit') }}<span>{{ LNG.ad_editor_planets }}</span></a>
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'resources'}) }}">{{ icon('database') }}<span>{{ LNG.ad_editor_resources }}</span></a>
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'buildings'}) }}">{{ icon('building-2') }}<span>{{ LNG.ad_editor_buildings }}</span></a>
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'ships'}) }}">{{ icon('rocket') }}<span>{{ LNG.ad_editor_ships }}</span></a>
          <a class="quick-link" href="{{ path('admin_account_editor_tab', {tab: 'defenses'}) }}">{{ icon('shield') }}<span>{{ LNG.ad_editor_defenses }}</span></a>
        </div>
      </div>
    </section>
  </div>
</div>
{% include 'admin/overall_footer.html.twig' %}
