{#
  Start page frame (login area): head with the configured game name in title, meta and structured
  data, top bar (brand, navigation, language), {% block main %}, footer. Variants: layout.light
  (homepage), layout.normal (content pages in a card), layout.popup (messages without navigation);
  account/layout.site puts the board in this frame for visitors without login.
#}
{% set currentPage = (app.request.attributes.get('_page')|default('index'))|lower %}
<!DOCTYPE html>
<html lang="{{ html_lang(lang) }}" data-dialog-ok="{{ LNG.dialog_ok }}" data-dialog-cancel="{{ LNG.dialog_cancel }}">
<head>
  <meta charset="utf-8">
  {# pages live below the site root (/account/board, /news/7): relative asset URLs resolve against the universe directory #}
  <base href="{{ app.request.basePath }}/{{ app.request.attributes.get('uni') }}">
  {{ csrf_meta() }}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# versions all ES modules by mtime (imported modules carry no ?v=): App\\Twig\\GameExtension::importMap #}
  {{ import_map() }}
  {# pages fill "title" (also the card heading); defined here once, rendered via block() #}
  {% if false %}{% block title %}{% endblock %}{% endif %}
  {% set pageTitle = block('title') is defined ? block('title')|striptags|trim : '' %}
  <title>{% if pageTitle and currentPage != 'index' %}{{ pageTitle }} · {% endif %}{{ gameName }}</title>
  <meta name="description" content="{{ LNG.format('home_meta_description', gameName) }}">
  <meta property="og:title" content="{{ gameName }}">
  <meta property="og:type" content="website">
  <meta property="og:description" content="{{ LNG.format('home_meta_description', gameName) }}">
  <meta property="og:image" content="{{ basepath }}memes/solo-scouting.webp">
  <meta name="twitter:card" content="summary_large_image">
  {% include 'shared/icons.html.twig' with {p: './'} only %}
  <link rel="preload" href="styles/resource/fonts/michroma/michroma-eu.woff2" as="font" type="font/woff2" crossorigin>
  {# same token source as the game: base layers, the theme contract and the V0Game theme (tokens only), then the site styles #}
  <link rel="stylesheet" href="styles/resource/css/app/base.css?v={{ asset_version }}">
  <link rel="stylesheet" href="styles/resource/css/app/theme-contract.css?v={{ asset_version }}">
  <link rel="stylesheet" href="styles/theme/v0game/theme.css?v={{ asset_version }}">
  <link rel="stylesheet" href="styles/resource/css/login/login.css?v={{ asset_version }}">
  <link rel="stylesheet" href="styles/resource/css/app/rte.css?v={{ asset_version }}">
  <script type="module" src="scripts/app/main.js?v={{ asset_version }}"></script>
  <script type="module" src="scripts/login/main.js?v={{ asset_version }}"></script>
  {% block script %}{% endblock %}
  <script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@type': ['VideoGame', 'WebApplication'],
    'name': gameName,
    'url': basepath,
    'image': basepath ~ 'memes/solo-scouting.webp',
    'description': LNG.format('home_meta_description', gameName),
    'inLanguage': languages|keys,
    'genre': ['Strategy', 'Browser game', 'MMOG'],
    'gamePlatform': 'Browser',
    'playMode': 'MultiPlayer',
    'offers': {'@type': 'Offer', 'price': '0', 'priceCurrency': 'EUR'}
  }|json_script }}</script>
</head>
<body id="{{ currentPage }}" class="site site--{{ bodyclass }}{% block body_class %}{% endblock %}">
  {% if bodyclass != 'popup' %}
    <header class="site-header">
      <div class="site-wrap site-header__inner">
        <a class="site-brand" href="./">{% if gameName is empty or gameName == 'V0Game' %}<span class="wordmark">V<b>0</b>Game</span>{% else %}<span class="wordmark">{{ gameName }}</span>{% endif %}</a>
        <button type="button" class="icon-button site-menu-toggle" data-site-menu aria-expanded="false" aria-controls="site-nav">{{ icon('menu', LNG.home_menu) }}</button>
        <nav class="site-nav" id="site-nav" aria-label="{{ LNG.home_menu }}">
          <a href="{{ path('login_news_show') }}"{% if currentPage == 'news' %} aria-current="page"{% endif %}>{{ LNG.menu_news }}</a>
          <a href="{{ path('login_hof_show') }}"{% if currentPage == 'hof' %} aria-current="page"{% endif %}>{{ LNG.siteTitleHOF }}</a>
          <a href="{{ path('login_battle_hall_show') }}"{% if currentPage == 'battlehall' %} aria-current="page"{% endif %}>{{ LNG.menu_battlehall }}</a>
          <a href="{{ path('login_screens_show') }}"{% if currentPage == 'screens' %} aria-current="page"{% endif %}>{{ LNG.buttonScreenshot }}</a>
          <a href="{{ path('login_rules') }}"{% if currentPage == 'rules' %} aria-current="page"{% endif %}>{{ LNG.menu_rules }}</a>
          {% if game_config('board_enabled', '1') != '0' %}
            <a href="{{ path('account_board_show') }}"{% if currentPage == 'board' %} aria-current="page"{% endif %}>{{ LNG.forum }}</a>
          {% endif %}
        </nav>
        {% if loginAccountName is defined and loginAccountName is not null and currentPage != 'index' %}
          <nav class="site-account" aria-label="{{ loginAccountName }}">
            <a class="site-account__name" href="account" title="{{ LNG.home_account_lobby }}">{{ icon('user') }}<span>{{ loginAccountName }}</span></a>
            <a class="site-account__logout" data-method="post" href="{{ path('account_logout_show') }}" title="{{ LNG.lm_logout }}">{{ icon('log-out') }}<span class="visually-hidden">{{ LNG.lm_logout }}</span></a>
          </nav>
        {% endif %}
        {% if languages|length > 1 %}
          {# language picker: a button with the current language, the full list in a modal (plain ?lang= links, so the
             choice is stored by the locale handling and works without scripts once the dialog is open) #}
          {% set currentLangName = lang %}
          {% for langKey, langName in languages %}
            {% if langName is iterable %}{% for subKey, subName in langName %}{% if subKey == lang %}{% set currentLangName = subName %}{% endif %}{% endfor %}
            {% elseif langKey == lang %}{% set currentLangName = langName %}{% endif %}
          {% endfor %}
          <button type="button" class="site-lang" data-lang-open aria-haspopup="dialog" aria-controls="lang-dialog">{{ icon('languages') }}<span>{{ currentLangName }}</span><span class="visually-hidden">· {{ LNG.registerLanguage }}</span></button>
        {% endif %}
      </div>
    </header>
  {% endif %}

  {% block main %}{% endblock %}
  {% if languages|length > 1 and bodyclass != 'popup' %}
    {% set langBase = app.request.baseUrl ~ app.request.pathInfo %}
    <dialog class="modal modal--inline lang-dialog" id="lang-dialog" aria-labelledby="lang-dialog-title">
      <header class="modal__header"><h2 class="modal__title" id="lang-dialog-title">{{ LNG.registerLanguage }}</h2></header>
      <div class="modal__body">
        <ul class="lang-grid">
          {% for langKey, langName in languages %}{% if langName is not iterable %}
            <li><a href="{{ langBase }}?lang={{ langKey }}" lang="{{ html_lang(langKey) }}" hreflang="{{ html_lang(langKey) }}"{% if langKey == lang %} aria-current="true"{% endif %}><span>{{ langName }}</span><code>{{ langKey }}</code></a></li>
          {% endif %}{% endfor %}
        </ul>
        {% for langKey, langName in languages %}{% if langName is iterable %}
          <h3 class="lang-grid__group">{{ langKey }}</h3>
          <ul class="lang-grid">
            {% for subKey, subName in langName %}
              <li><a href="{{ langBase }}?lang={{ subKey }}" lang="{{ html_lang(subKey) }}"{% if subKey == lang %} aria-current="true"{% endif %}><span>{{ subName }}</span><code>{{ subKey }}</code></a></li>
            {% endfor %}
          </ul>
        {% endif %}{% endfor %}
      </div>
      <form method="dialog"><button type="submit" class="modal__close" aria-label="{{ LNG.dialog_cancel }}">{{ icon('x') }}</button></form>
    </dialog>
  {% endif %}


  {% if bodyclass != 'popup' %}
    <footer class="site-footer">
      <div class="site-wrap site-footer__inner">
        <span>© {{ 'now'|date('Y') }} {% if gameName is empty or gameName == 'V0Game' %}V0Game{% else %}{{ gameName }} · V0Game{% endif %} · {{ LNG.shell_footer_credits }} · AGPL-3.0</span>
        <nav aria-label="Footer">
          <a href="{{ path('login_team_show') }}">{{ LNG.home_team }}</a>
          <a href="{{ path('login_ban_list_show') }}">{{ LNG.menu_banlist }}</a>
          <a href="{{ path('login_disclamer_show') }}">{{ LNG.menu_disclamer }}</a>
          <a href="{{ path('login_data_privacy_show') }}">{{ LNG.siteTitleDataPrivacy }}</a>
          {% set sourceUrl = game_config('source_url') %}
          {% if sourceUrl %}<a href="{{ sourceUrl|e('html_attr') }}" target="_blank" rel="noopener" title="AGPL-3.0">{{ LNG.source_code }}</a>{% endif %}
        </nav>
      </div>
    </footer>
  {% endif %}
  {% if bodyclass != 'popup' %}{% include 'shared/cookie_notice.html.twig' %}{% endif %}
  <script type="application/json" id="login-config">{{ {
    isMultiUniverse: isMultiUniverse,
    unisWildcast: unisWildcast,
    referralEnable: referralEnable,
    basePath: basepath,
  }|json_script }}</script>
</body>
</html>
