{# Start page frame for pages rendered by Symfony controllers (rules); same look as login/layout.base.html.twig. #}
{%- set base = app.request.basePath -%}
{%- set gameName = game_config('game_name') -%}
{%- set language_names = languages() -%}
<!DOCTYPE html>
<html lang="{{ html_lang(app.request.locale) }}">
<head>
  <meta charset="utf-8">
  {{ csrf_meta() }}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# versions all ES modules by mtime (imported modules carry no ?v=): App\\Twig\\GameExtension::importMap #}
  {{ import_map() }}
  <title>{% block title %}{% endblock %} · {{ gameName }}</title>
  <meta property="og:title" content="{{ gameName }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="{{ base }}/memes/solo-scouting.webp">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="{{ base }}/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="{{ base }}/styles/resource/css/app/base.css?v={{ asset_version }}">
  <link rel="stylesheet" href="{{ base }}/styles/resource/css/login/login.css?v={{ asset_version }}">
  <link rel="stylesheet" href="{{ base }}/styles/resource/css/app/rte.css?v={{ asset_version }}">
  <script type="module" src="{{ base }}/scripts/login/main.js?v={{ asset_version }}"></script>
  {% block script %}{% endblock %}
</head>
<body id="{% block page_id %}overview{% endblock %}" class="site site--normal">
  <header class="site-header">
    <div class="site-wrap site-header__inner">
      <a class="site-brand" href="{{ base }}/"><span>{{ gameName }}</span></a>
      <button type="button" class="icon-button site-menu-toggle" data-site-menu aria-expanded="false" aria-controls="site-nav">{{ icon('menu', 'menu') }}</button>
      <nav class="site-nav" id="site-nav">
        <a href="{{ path('login_news_show') }}">{{ 'menu_news'|trans({}, 'public') }}</a>
        <a href="{{ path('login_hof_show') }}">{{ 'siteTitleHOF'|trans({}, 'public') }}</a>
        <a href="{{ path('login_battle_hall_show') }}">{{ 'menu_battlehall'|trans({}, 'public') }}</a>
        <a href="{{ path('login_screens_show') }}">{{ 'buttonScreenshot'|trans({}, 'public') }}</a>
        <a href="{{ path('login_rules') }}" aria-current="page">{{ 'menu_rules'|trans({}, 'public') }}</a>
      </nav>
      {% if language_names|length > 1 %}
        <label class="site-lang">{{ icon('languages') }}<span class="visually-hidden">{{ 'registerLanguage'|trans({}, 'public') }}</span>
          <select data-language-select>
            {% for code, name in language_names %}<option value="{{ code }}"{% if code == app.request.locale %} selected{% endif %}>{{ name }}</option>{% endfor %}
          </select>
        </label>
      {% endif %}
    </div>
  </header>

  <main class="page" id="content">
    <div class="site-wrap">
      <section class="panel page-card">
        <h1 class="panel__head">{{ block('title') }}</h1>
        <div class="panel__body">{% block content %}{% endblock %}</div>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="site-wrap site-footer__inner">
      <span>{% if gameName is empty or gameName == 'V0Game' %}© Project V0Game{% else %}© {{ gameName }} on Project V0Game{% endif %}</span>
      <nav aria-label="Footer">
        <a href="{{ path('login_team_show') }}">{{ 'home_team'|trans({}, 'public') }}</a>
        <a href="{{ path('login_ban_list_show') }}">{{ 'menu_banlist'|trans({}, 'public') }}</a>
        <a href="{{ path('login_disclamer_show') }}">{{ 'menu_disclamer'|trans({}, 'public') }}</a>
        <a href="{{ path('login_data_privacy_show') }}">{{ 'siteTitleDataPrivacy'|trans({}, 'public') }}</a>
        {% set sourceUrl = game_config('source_url') %}
        {% if sourceUrl %}<a href="{{ sourceUrl }}" target="_blank" rel="noopener" title="AGPL-3.0">{{ 'source_code'|trans({}, 'public') }}</a>{% endif %}
      </nav>
    </div>
  </footer>
  <script type="application/json" id="login-config">{{ {
    isMultiUniverse: false,
    unisWildcast: false,
    referralEnable: game_config('ref_active') == '1',
    basePath: app.request.schemeAndHttpHost ~ base ~ '/',
  }|json_script }}</script>
</body>
</html>
