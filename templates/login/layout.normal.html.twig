{% extends 'login/layout.base.html.twig' %}
{# content pages: page head (title) + one panel, like a game page #}
{% block main %}
  <main class="page" id="content">
    <div class="site-wrap">
      <header class="page-head"><h1>{{ block('title') }}</h1></header>
      <section class="panel page-card">
        <div class="panel__body">{% block content %}{% endblock %}</div>
      </section>
    </div>
  </main>
{% endblock %}
