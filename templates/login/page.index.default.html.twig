{% extends layout_template %}
{% block title %}{{ LNG.siteTitleIndex }}{% endblock %}
{#
  Start page, compact: row 1 = pitch with the register call and universe status | login (what returning players
  need first); row 2 = the comic (large, the page's eye-catcher) | latest news + explore links. Phones stack it
  in that order. Styles: css/login/login.css (.home, .hero, .panel).
#}
{% block content %}
<div class="home site-wrap">
  <div class="home__top">
    <section class="hero" aria-labelledby="hero-title">
      <h1 class="hero__title" id="hero-title">{{ LNG.format('loginWelcome', gameName) }}</h1>
      <p class="hero__text">{{ LNG.format('loginServerDesc', gameName) }}</p>
      <ul class="hero__steps">
        <li>{{ icon('hammer') }}<span>{{ LNG.home_step_build }}</span></li>
        <li>{{ icon('rocket') }}<span>{{ LNG.home_step_fleet }}</span></li>
        <li>{{ icon('users') }}<span>{{ LNG.home_step_alliance }}</span></li>
      </ul>
      <div class="hero__actions">
        {% if loginAccountName is null %}
          <a class="button btn--primary btn-hero" href="{{ path('login_register_show') }}">{{ icon('user-plus') }}{{ LNG.buttonRegister }}</a>
        {% endif %}
        <a class="button btn-hero" href="{{ path('login_screens_show') }}">{{ icon('layers') }}{{ LNG.buttonScreenshot }}</a>
      </div>
      {% if universeStarts %}
        <ul class="uni-starts">
          {% for universeStart in universeStarts %}
            <li class="uni-start">
              <span class="status-dot" aria-hidden="true"></span>
              <strong>{{ universeStart.name }}</strong>
              <span class="uni-start__date">{{ universeStart.date }}</span>
              <span class="uni-countdown" data-start-timestamp="{{ universeStart.timestamp }}" data-text-in="{{ LNG.home_starts_in }}" data-text-done="{{ LNG.home_started }}" aria-live="polite"></span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>

    <section class="panel panel--login" id="login">
      {% if loginAccountName is not null %}
      <h2 class="panel__head">{{ LNG.home_logged_in_head }}</h2>
      <div class="panel__body">
        <div class="login-form login-form--session">
          <p>{{ LNG.format('home_logged_in_as', loginAccountName) }}</p>
          <a class="button btn--primary" href="account">{{ LNG.home_continue }}</a>
          <a class="button" data-method="post" href="{{ path('account_logout_show') }}">{{ LNG.lm_logout }}</a>
        </div>
      </div>
      {% else %}
      <h2 class="panel__head">{{ LNG.loginHeader }}</h2>
      <div class="panel__body">
        {% if code %}
          <div class="notice notice--danger" role="alert">{{ icon('circle-alert') }}<div>{{ code }}</div></div>
        {% endif %}
        <form class="login-form" id="login-form" name="login" action="{{ path('login_login_send') }}" data-action="{{ universe_path('login_login_send') }}" method="post">
          <label>{{ LNG.loginEmail }}<input name="email" id="email" type="email" maxlength="64" autocomplete="username" required></label>
          <label>{{ LNG.loginPassword }}<input name="password" id="password" type="password" autocomplete="current-password" required></label>
          {% if rememberMeDays > 0 %}
          <label class="login-form__remember"><input type="checkbox" name="_remember_me" value="1" aria-describedby="remember-hint"> {{ LNG.format('loginRememberMe', rememberMeDays) }}</label>
          <small class="field__help" id="remember-hint">{{ LNG.loginRememberHint }}</small>
          {% endif %}
          <button type="submit" class="btn--primary">{{ LNG.loginButton }}</button>
        </form>
        {% include 'login/_social_buttons.html.twig' %}
        <div class="login-meta">
          {% if mailEnable %}<a href="{{ path('login_lost_password_show') }}">{{ LNG.buttonLostPassword }}</a>{% else %}{% set teamLink %}<a href="{{ path('login_team_show') }}">{{ LNG.loginContactTeam }}</a>{% endset %}<span>{{ LNG.format('loginLostPasswordOff', teamLink) }}</span>{% endif %}
          {% set rulesLink %}<a href="{{ rulesUrl }}">{{ LNG.menu_rules }}</a>{% endset %}
          <span>{{ LNG.format('loginInfo', rulesLink) }}</span>
        </div>
      </div>
      {% endif %}
    </section>
  </div>

  <div class="home__more">
    {% if meme %}
      <figure class="home__art">
        <img src="{{ meme.src }}"{% if meme.srcset %} srcset="{{ meme.srcset }}" sizes="(max-width: 60rem) calc(100vw - 2rem), 46rem"{% endif %} width="{{ meme.width }}" height="{{ meme.height }}" alt="{{ meme.alt|e('html_attr') }}" fetchpriority="high" decoding="async">
      </figure>
    {% endif %}
    <div class="home__side">
    {% if latestNews %}
    <section class="panel panel--news">
      <h2 class="panel__head">{{ LNG.news_latest }}<a class="panel__more" href="{{ path('login_news_show') }}">{{ LNG.news_all }}{{ icon('chevron-right') }}</a></h2>
      <ul class="news-teasers">
        {% for item in latestNews %}
          <li><a href="{{ path('login_news_article', {id: item.id}) }}"><span class="news-teasers__title">{{ item.title }}</span><time>{{ item.date }}</time></a></li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section class="panel panel--explore">
      <h2 class="panel__head">{{ LNG.home_explore }}</h2>
      <ul class="link-list">
        {% if discordWidget %}
          <li>
            {% set discordInner %}{{ icon('discord', null, 'link-list__icon link-list__icon--discord') }}<span class="link-list__text"><span>{{ discordWidget.url ? LNG.home_discord_join : 'Discord' }}</span><small><span class="status-dot" aria-hidden="true"></span>{{ LNG.home_discord_online }} <strong>{{ discordWidget.online|number_format(0, ',', '.') }}</strong></small></span>{% endset %}
            {% if discordWidget.url %}<a href="{{ discordWidget.url|e('html_attr') }}" target="_blank" rel="noopener">{{ discordInner }}{{ icon('chevron-right', null, 'link-list__chevron') }}</a>{% else %}<span class="link-list__static">{{ discordInner }}</span>{% endif %}
          </li>
        {% elseif game_config('discord_url') %}
          <li><a href="{{ game_config('discord_url')|e('html_attr') }}" target="_blank" rel="noopener">{{ icon('discord', null, 'link-list__icon link-list__icon--discord') }}<span class="link-list__text"><span>{{ LNG.home_discord_join }}</span></span>{{ icon('chevron-right', null, 'link-list__chevron') }}</a></li>
        {% endif %}
        {% if game_config('wiki_url') %}
          <li><a href="{{ game_config('wiki_url')|e('html_attr') }}" target="_blank" rel="noopener">{{ icon('book-open', null, 'link-list__icon') }}<span class="link-list__text"><span>Wiki</span></span>{{ icon('chevron-right', null, 'link-list__chevron') }}</a></li>
        {% endif %}
        <li><a href="{{ path('login_hof_show') }}">{{ icon('trophy', null, 'link-list__icon') }}<span class="link-list__text"><span>{{ LNG.siteTitleHOF }}</span><small>{{ LNG.home_hof_desc }}</small></span>{{ icon('chevron-right', null, 'link-list__chevron') }}</a></li>
        <li><a href="{{ path('login_battle_hall_show') }}">{{ icon('swords', null, 'link-list__icon') }}<span class="link-list__text"><span>{{ LNG.menu_battlehall }}</span><small>{{ LNG.home_battlehall_desc }}</small></span>{{ icon('chevron-right', null, 'link-list__chevron') }}</a></li>
        <li><a href="{{ rulesUrl }}">{{ icon('scroll-text', null, 'link-list__icon') }}<span class="link-list__text"><span>{{ LNG.menu_rules }}</span></span>{{ icon('chevron-right', null, 'link-list__chevron') }}</a></li>
      </ul>
    </section>
    </div>
  </div>
</div>
{% endblock %}
