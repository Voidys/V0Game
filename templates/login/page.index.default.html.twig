{% extends layout_template %}
{% block title %}{{ LNG.siteTitleIndex }}{% endblock %}
{% block content %}
<div class="home site-wrap">
  <div class="home__main">
    <section class="hero">
      <h1 class="hero__title">{{ LNG.format('loginWelcome', gameName) }}</h1>
      <p class="hero__text">{{ LNG.format('loginServerDesc', gameName) }}</p>
      <ul class="hero__steps">
        <li>{{ icon('hammer') }}<span>{{ LNG.home_step_build }}</span></li>
        <li>{{ icon('rocket') }}<span>{{ LNG.home_step_fleet }}</span></li>
        <li>{{ icon('users') }}<span>{{ LNG.home_step_alliance }}</span></li>
        <li>{{ icon('scroll-text') }}<span>{% set rulesLink %}<a href="{{ rulesUrl }}">{{ LNG.menu_rules }}</a>{% endset %}{{ LNG.format('home_step_rules', rulesLink) }}</span></li>
      </ul>
      {% if loginAccountName is null %}
        <div class="hero__actions">
          <a class="button btn--primary btn-hero" href="{{ path('login_register_show') }}">{{ LNG.buttonRegister }}</a>
        </div>
      {% endif %}
      {% if universeStarts %}
        <div class="uni-starts">
          {% for universeStart in universeStarts %}
            <span class="uni-start">
              <span><strong>{{ universeStart.name }}</strong> · {{ universeStart.date }}</span>
              <span class="uni-countdown" data-start-timestamp="{{ universeStart.timestamp }}" data-text-in="{{ LNG.home_starts_in }}" data-text-done="{{ LNG.home_started }}" aria-live="polite"></span>
            </span>
          {% endfor %}
        </div>
      {% endif %}
    </section>

    <section class="panel" id="login">
      {% if loginAccountName is not null %}
      <h2 class="panel__head">{{ icon('user') }}{{ LNG.home_logged_in_head }}</h2>
      <div class="panel__body">
        <div class="login-form login-form--session">
          <p>{{ LNG.format('home_logged_in_as', loginAccountName) }}</p>
          <a class="button btn--primary" href="account">{{ LNG.home_continue }}</a>
          <a class="button" data-method="post" href="{{ path('account_logout_show') }}">{{ LNG.lm_logout }}</a>
        </div>
      </div>
      {% else %}
      <h2 class="panel__head">{{ icon('lock') }}{{ LNG.loginHeader }}</h2>
      <div class="panel__body">
        {% if code %}
          <div class="notice notice--danger" role="alert">{{ icon('circle-alert') }}<div>{{ code }}</div></div>
        {% endif %}
        <form class="login-form" id="login-form" name="login" action="{{ path('login_login_send') }}" data-action="{{ universe_path('login_login_send') }}" method="post">
          <label>{{ LNG.loginEmail }}<input name="email" id="email" type="email" maxlength="64" autocomplete="username" required></label>
          <label>{{ LNG.loginPassword }}<input name="password" id="password" type="password" autocomplete="current-password" required></label>
          {% if rememberMeDays > 0 %}
          <label class="login-form__remember"><input type="checkbox" name="_remember_me" value="1" aria-describedby="remember-hint"> {{ LNG.format('loginRememberMe', rememberMeDays) }}</label>
          <small class="field__help" id="remember-hint">{{ LNG.loginRememberHint }}</small>
          {% endif %}
          <button type="submit" class="btn--primary">{{ LNG.loginButton }}</button>
        </form>
        {% include 'login/_social_buttons.html.twig' %}
        <div class="login-meta">
          {% if mailEnable %}<a href="{{ path('login_lost_password_show') }}">{{ LNG.buttonLostPassword }}</a>{% else %}{% set teamLink %}<a href="{{ path('login_team_show') }}">{{ LNG.loginContactTeam }}</a>{% endset %}<span>{{ LNG.format('loginLostPasswordOff', teamLink) }}</span>{% endif %}
          {% set rulesLink %}<a href="{{ rulesUrl }}">{{ LNG.menu_rules }}</a>{% endset %}
          <span>{{ LNG.format('loginInfo', rulesLink) }}</span>
        </div>
      </div>
      {% endif %}
    </section>

    {% if latestNews %}
    <section class="panel panel--news">
      <h2 class="panel__head">{{ icon('newspaper') }}{{ LNG.news_latest }}</h2>
      <div class="panel__body">
        <ul class="news-teasers">
          {% for item in latestNews %}
            <li><a href="{{ path('login_news_article', {id: item.id}) }}"><span class="news-teasers__title">{{ item.title }}</span><time>{{ item.date }}</time></a></li>
          {% endfor %}
        </ul>
        <a class="news-teasers__all" href="{{ path('login_news_show') }}">{{ LNG.news_all }} {{ icon('chevron-right') }}</a>
      </div>
    </section>
    {% endif %}
  </div>

  <div class="home__side">
    {% if meme %}
      <figure class="hero__art">
        <img src="{{ meme.src }}"{% if meme.srcset %} srcset="{{ meme.srcset }}" sizes="(max-width: 60rem) min(calc(100vw - 2rem), 40rem), min(50vw, 37rem)"{% endif %} width="{{ meme.width }}" height="{{ meme.height }}" alt="{{ meme.alt|e('html_attr') }}" fetchpriority="high" decoding="async">
      </figure>
    {% endif %}

    {% if discordWidget %}
    {% set discordInner %}{{ icon('discord', null, 'discord-box__logo') }}<span class="discord-box__text"><span class="discord-box__count"><span class="discord-box__dot" aria-hidden="true"></span>{{ LNG.home_discord_online }} <strong>{{ discordWidget.online|number_format(0, ',', '.') }}</strong></span>{% if discordWidget.url %}<span class="discord-box__join">{{ LNG.home_discord_join }}</span>{% endif %}</span>{% endset %}
    <section class="panel panel--discord" aria-label="Discord">
      {% if discordWidget.url %}
        <a class="discord-box" href="{{ discordWidget.url|e('html_attr') }}" target="_blank" rel="noopener">{{ discordInner }}{{ icon('chevron-right', null, 'discord-box__chevron') }}</a>
      {% else %}
        <div class="discord-box">{{ discordInner }}</div>
      {% endif %}
    </section>
    {% endif %}

    <section class="panel panel--links">
      <div class="panel__body">
        <div class="links">
          {% if game_config('discord_url') and not discordWidget %}<a href="{{ game_config('discord_url')|e('html_attr') }}" target="_blank" rel="noopener">{{ icon('message-circle') }}Discord</a>{% endif %}
          {% if game_config('wiki_url') %}<a href="{{ game_config('wiki_url')|e('html_attr') }}" target="_blank" rel="noopener">{{ icon('book-open') }}Wiki</a>{% endif %}
          <a href="{{ path('login_hof_show') }}" title="{{ LNG.home_hof_desc|e('html_attr') }}">{{ icon('trophy') }}{{ LNG.siteTitleHOF }}</a>
          <a href="{{ path('login_battle_hall_show') }}" title="{{ LNG.home_battlehall_desc|e('html_attr') }}">{{ icon('swords') }}{{ LNG.menu_battlehall }}</a>
          <a href="{{ path('login_screens_show') }}">{{ icon('layers') }}{{ LNG.buttonScreenshot }}</a>
          <a href="{{ path('login_news_show') }}">{{ icon('newspaper') }}{{ LNG.menu_news }}</a>
        </div>
      </div>
    </section>
  </div>
</div>
{% endblock %}
