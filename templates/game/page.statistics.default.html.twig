{% import '_macros/forms.html.twig' as forms -%}
{% import '_macros/ui.html.twig' as ui -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_statistics }}{{ parent() }}{% endblock %}
{% block pagehead %}{% set statMeta %}{{ LNG.st_statistics }} ({{ LNG.st_updated }}: {{ stat_date }}){% endset %}{{ ui.page_head(LNG.lm_statistics, 'chart-column', statMeta) }}{% endblock %}
{% block content %}
<form class="toolbar" name="stats" id="stats" method="get" action="{{ path('game_statistics_show') }}">
	<span class="control-group"><label for="who">{{ LNG.st_show }}</label><select name="who" id="who" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.who, 'selected': who}) }}</select></span>
	<span class="control-group"><label for="type">{{ LNG.st_per }}</label><select name="type" id="type" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.type, 'selected': type}) }}</select></span>
	<span class="control-group"><label for="range">{{ LNG.st_in_the_positions }}</label><select name="range" id="range" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.range, 'selected': range}) }}</select>
		{% if rangePrev %}<a class="button btn-sm" href="{{ path('game_statistics_show', {who: who, type: type, range: rangePrev}) }}" title="{{ LNG.st_prev_range|e('html_attr') }}" aria-label="{{ LNG.st_prev_range|e('html_attr') }}">{{ icon('chevron-left') }}</a>{% endif %}
		{% if rangeNext %}<a class="button btn-sm" href="{{ path('game_statistics_show', {who: who, type: type, range: rangeNext}) }}" title="{{ LNG.st_next_range|e('html_attr') }}" aria-label="{{ LNG.st_next_range|e('html_attr') }}">{{ icon('chevron-right') }}</a>{% endif %}</span>
	{% if who == 1 and RangeList|filter(r => r.id == CUser_id)|length %}<span class="toolbar__spacer"></span><a class="button btn-sm" href="#my-rank">{{ icon('user') }}{{ LNG.st_my_rank }}</a>{% endif %}
</form>
<section class="panel panel--flush">
	<table class="data stats-table">
	{% if who == 1 %}
		{% include 'game/shared.statistics.playerTable.html.twig' %}
	{% elseif who == 2 %}
		{% include 'game/shared.statistics.allianceTable.html.twig' %}
	{% endif %}
	</table>
	<div class="panel__foot stats-legend">
		<span><span class="tag tag--warn">{{ LNG.gl_short_newbie }}</span> {{ LNG.st_legend_noob }}</span>
		<span><span class="tag tag--info">{{ LNG.gl_short_vacation }}</span> {{ LNG.gl_vacation }}</span>
		<span><span class="tag tag--muted">{{ LNG.gl_short_inactive }}</span> {{ LNG.gl_inactive_seven }}</span>
		<span><span class="tag tag--muted">{{ LNG.gl_short_long_inactive }}</span> {{ LNG.gl_inactive_twentyeight }}</span>
		<span><span class="tag tag--neg">{{ LNG.gl_short_ban }}</span> {{ LNG.gl_banned }}</span>
	</div>
</section>
{% endblock %}

{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/statistics.js?v={{ asset_version }}"></script>
{% endblock %}
