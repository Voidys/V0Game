{% extends layout_template %}
{% block title %}{{ pageTitle }}{{ parent() }}{% endblock %}
{% block content %}
{% import 'game/shared.mission.raport.macros.html.twig' as cr %}
{% set reduced = Info is defined and Info is not null %}
{% set lastRound = Raport.rounds|length - 1 %}

{# parties of the hero #}
{% set heroAttackers = [] %}
{% set heroDefenders = [] %}
{% if reduced %}
	{% set heroAttackers = [{name: Info[0]}] %}
	{% set heroDefenders = [{name: Info[1]}] %}
{% else %}
	{% for fleet in Raport.rounds[0].attackers %}
		{% set heroAttackers = heroAttackers|merge([{id: fleet.player.id ?? 0, name: fleet.player.username, coords: '[' ~ fleet.fleetDetail.start_galaxy ~ ':' ~ fleet.fleetDetail.start_system ~ ':' ~ fleet.fleetDetail.start_planet ~ ']' ~ (fleet.fleetDetail.start_type is defined and fleet.fleetDetail.start_type is not null ? ' (' ~ LNG["type_planet_short_#{fleet.fleetDetail.start_type}"] ~ ')' : '')}]) %}
	{% endfor %}
	{% for fleet in Raport.rounds[0].defenders %}
		{% set heroDefenders = heroDefenders|merge([{id: fleet.player.id ?? 0, name: fleet.player.username, coords: '[' ~ fleet.fleetDetail.start_galaxy ~ ':' ~ fleet.fleetDetail.start_system ~ ':' ~ fleet.fleetDetail.start_planet ~ ']' ~ (fleet.fleetDetail.start_type is defined and fleet.fleetDetail.start_type is not null ? ' (' ~ LNG["type_planet_short_#{fleet.fleetDetail.start_type}"] ~ ')' : '')}]) %}
	{% endfor %}
{% endif %}

{# defence rebuild rows: repaired units against the defences that were destroyed in total (start minus end of the planet fleet, the last defender entry) #}
{% set repairRows = [] %}
{% if Raport.repaired %}
	{% set planetKey = Raport.rounds[0].defender.Roundstats|keys|last %}
	{% for ShipID, ShipData in Raport.repaired %}
		{% set destroyed = (Raport.rounds[0].defender.Roundstats[planetKey][ShipID].amount ?? 0) - (Raport.rounds[lastRound].defender.Roundstats[planetKey][ShipID].amount ?? 0) %}
		{% set repairRows = repairRows|merge([{id: ShipID, units: ShipData.units, destroyed: destroyed, percent: ShipData.percent, left: destroyed - ShipData.units}]) %}
	{% endfor %}
{% endif %}

{% include 'game/shared.mission.raport.head.html.twig' %}
	{% include 'game/shared.mission.raport.extras.html.twig' %}

	<section class="cr-rounds" aria-labelledby="cr-rounds-title">
		<h2 class="cr-h" id="cr-rounds-title">{{ icon('activity') }}{{ LNG.cr_rounds }} <span class="cr-unit">{{ lastRound }}</span></h2>
		{% for Round, RoundInfo in Raport.rounds %}
		{% if not loop.first and (not reduced or Round == 1) %}
		<div class="cr-exchange">
			<p class="cr-exchange__att">{{ icon('crosshair') }}<span>{{ LNG.fleet_attack_1 }} <strong>{{ pretty_number(RoundInfo.attacker.Statistics.damage_done.sum + RoundInfo.attacker.Statistics.damage_dead.sum + RoundInfo.attacker.Statistics.shield_hit.sum + RoundInfo.attacker.Statistics.shield_bounced.sum) }}</strong> {{ LNG.fleet_attack_2 }} <strong>{{ pretty_number(RoundInfo.attacker.Statistics.shield_bounced.sum + RoundInfo.attacker.Statistics.shield_hit.sum) }}</strong> {{ LNG.damage }}</span></p>
			<p class="cr-exchange__def">{{ icon('shield') }}<span>{{ LNG.fleet_defs_1 }} <strong>{{ pretty_number(RoundInfo.defender.Statistics.damage_done.sum + RoundInfo.defender.Statistics.damage_dead.sum + RoundInfo.defender.Statistics.shield_hit.sum + RoundInfo.defender.Statistics.shield_bounced.sum) }}</strong> {{ LNG.fleet_defs_2 }} <strong>{{ pretty_number(RoundInfo.defender.Statistics.shield_bounced.sum + RoundInfo.defender.Statistics.shield_hit.sum) }}</strong> {{ LNG.damage }}</span></p>
		</div>
		{% endif %}
		{% if not (reduced and Round > 0 and not loop.last) %}
		{% set sums = {attacker: 0, defender: 0} %}
		{% for side in ['attacker', 'defender'] %}
			{% set sum = 0 %}
			{% for fleetShips in RoundInfo[side].Roundstats %}{% for ShipData in fleetShips %}{% set sum = sum + ShipData.amount %}{% endfor %}{% endfor %}
			{% set sums = sums|merge({(side): sum}) %}
		{% endfor %}
		<details class="cr-round"{% if loop.first or loop.last %} open{% endif %}>
			<summary>{{ cr.round_title(Round == 0 ? LNG.cr_start : LNG.sys_attack_round ~ ' ' ~ Round, sums.attacker, sums.defender) }}</summary>
			<div class="cr-round__body">
				{% for side in ['attacker', 'defender'] %}
				<div class="cr-side cr-side--{{ side }}">
					{% for fleetId, ships in RoundInfo[side].Roundstats %}
					{% set fleet = Raport.rounds[0][side ~ 's'][fleetId] %}
					{% set alive = 0 %}
					{% set stunnedAny = 0 %}
					{% for ShipData in ships %}{% set alive = alive + ShipData.amount %}{% set stunnedAny = stunnedAny + ShipData.stunned %}{% endfor %}
					<section class="cr-fleet">
						{{ cr.fleet_head(side, fleet.player.username, '[' ~ fleet.fleetDetail.start_galaxy ~ ':' ~ fleet.fleetDetail.start_system ~ ':' ~ fleet.fleetDetail.start_planet ~ ']' ~ (fleet.fleetDetail.start_type is defined and fleet.fleetDetail.start_type is not null ? ' (' ~ LNG["type_planet_short_#{fleet.fleetDetail.start_type}"] ~ ')' : ''), [fleet.player.military_tech * 10 + 100, fleet.player.shield_tech * 10 + 100, fleet.player.defence_tech * 10 + 100], reduced, Round > 0 and alive == 0, reduced ? 0 : (fleet.player.id ?? 0)) }}
						<div class="cr-scroll">
							<table class="cr-table cr-ships">
								<thead>
									<tr>
										<th scope="col">{{ LNG.sys_ship_type }}</th>
										<th scope="col" class="num">{{ LNG.sys_ship_count }}</th>
										{% if Round > 0 %}
										<th scope="col" class="num">{{ LNG.cr_lost_round }}</th>
										<th scope="col" class="num">{{ LNG.cr_lost_total }}</th>
										{% if stunnedAny > 0 %}<th scope="col" class="num">{{ LNG.battle_stats_stunned_done }}</th>{% endif %}
										{% endif %}
										{% if not reduced %}
										<th scope="col" class="num">{{ LNG.sys_ship_weapon }}</th>
										<th scope="col" class="num">{{ LNG.sys_ship_shield }}</th>
										<th scope="col" class="num">{{ LNG.sys_ship_armour }}</th>
										{% endif %}
									</tr>
								</thead>
								<tbody>
									{% for shipId, ShipData in ships %}
									{% set start = Raport.rounds[0][side].Roundstats[fleetId][shipId].amount ?? ShipData.amount %}
									{% set lostTotal = start - ShipData.amount %}
									<tr{% if Round > 0 and ShipData.amount == 0 %} class="is-gone"{% endif %}>
										<th scope="row">{{ LNG.shortNames[shipId] }}</th>
										<td class="num"><span class="cr-count">{{ pretty_number(ShipData.amount) }}</span>{% if Round > 0 %}{{ cr.keep_bar(ShipData.amount, start) }}{% endif %}</td>
										{% if Round > 0 %}
										<td class="num">{% if ShipData.lost > 0 %}<span class="cr-loss">&minus;{{ pretty_number(ShipData.lost) }}</span>{% else %}<span class="cr-none">0</span>{% endif %}</td>
										<td class="num">{% if lostTotal > 0 %}<span class="cr-loss">&minus;{{ pretty_number(lostTotal) }}</span>{% else %}<span class="cr-none">0</span>{% endif %}</td>
										{% if stunnedAny > 0 %}<td class="num">{% if ShipData.stunned > 0 %}<span class="cr-stun">{{ icon('timer') }}{{ pretty_number(ShipData.stunned) }}</span>{% else %}<span class="cr-none">0</span>{% endif %}</td>{% endif %}
										{% endif %}
										{% if not reduced %}
										<td class="num">{{ pretty_number(ShipData.attack) }}</td>
										<td class="num">{{ pretty_number(ShipData.shield) }}</td>
										<td class="num">{{ pretty_number(ShipData.hull) }}</td>
										{% endif %}
									</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</section>
					{% endfor %}
				</div>
				{% endfor %}
			</div>
		</details>
		{% endif %}
		{% endfor %}
	</section>

	{# battle statistics: filled by scripts/game/raport.js (not for viewers without access) #}
	<section class="cr-card cr-statswrap" aria-labelledby="cr-stats">
		<h3 class="cr-card__title" id="cr-stats">{{ icon('chart-column') }}{{ LNG.cr_stats }}</h3>
		<div id="battle-statistics" class="battle-stats-container"></div>
	</section>
</article>
{% endblock %}

{# ===== Statistics data (JSON island) & script ===== #}
{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/raportshare.js?v={{ asset_version }}"></script>
{% if Info is not defined or Info is null %}
{{ data_island('raport-data', {
  raportData: Raport,
  shipNames: LNG.shortNames,
  raportLNG: {
    damage_done: LNG.battle_stats_damage_done,
    damage_dead: LNG.battle_stats_damage_dead,
    shield_hit: LNG.battle_stats_shield_hit,
    ship_destroyed: LNG.battle_stats_ship_destroyed,
    shield_bounced: LNG.battle_stats_shield_bounced,
    rapid_fire_done: LNG.battle_stats_rapid_fire_done,
    explosion_triggered: LNG.battle_stats_explosion_triggered,
    stunned_done: LNG.battle_stats_stunned_done,
    fleet: LNG.sys_spy_fleet,
    target: LNG.battle_stats_target,
    total: LNG.battle_stats_total,
    total_all_targets: LNG.battle_stats_total_all_targets,
    total_all_fleets: LNG.battle_stats_total_all_fleets,
    attacker: LNG.sys_attack_attacker_pos,
    defender: LNG.sys_attack_defender_pos,
    round: LNG.sys_attack_round
  }
}) }}
<script type="module" src="./scripts/game/raport.js?v={{ asset_version }}"></script>
{% endif %}
{% endblock %}
