{% if tutorial %}
    <details class="panel accordion tutorial-accordion" id="tutorial-accordion" data-key="tutorial" data-default="closed">
    <summary id="tutorial-header" class="panel__head tutorial-header accordion__head">
        {% set openGoals = [] %}
        {% for elementID, goal in tutorial.goals|default([]) %}{% if goal.owned < goal.ammount %}{% set openGoals = openGoals|merge([goal]) %}{% endif %}{% endfor %}
        <span class="accordion__title"><span><b>Tutorial:</b> {{ tutorial.title }}
        {% if openGoals %}<span class="tutorial-header__goal">&middot; {{ openGoals[0].name }}: {{ openGoals[0].owned }}/{{ openGoals[0].ammount }}{% if openGoals|length > 1 %} (+{{ openGoals|length - 1 }}){% endif %}</span>{% elseif tutorial.fullfilled %}<span class="tutorial-header__goal colorPositive">&middot; &#10003;</span>{% endif %}</span></span>
        <span class="accordion__sign" aria-hidden="true"></span>
    </summary>
    <div id="tutorial" class="tutorial panel__body">
        <div class="tutorial-text">
            {{ tutorial.text }}<br>
        </div>
        <div class="tutorial-goals">
            {% if tutorial.goals %}
                <b>{{ LNG.tutorial_goals_header }}</b><br>
                <ul>
                    {% for elementID, goal in tutorial.goals %}
                        <li>{{ goal.name }}&nbsp;:&nbsp;{{ goal.owned }}/{{ goal.ammount }}{% if goal.skippable %} <a data-method="post" href="{{ path('game_tutorial_skip', {goal: elementID}) }}">{{ LNG.tutorial_goals_ignore }}</a>{% endif %}</li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if tutorial.rewards %}
                <b>{{ LNG.tutorial_rewards_header }}</b><br>
                <ul>
                    {% for elementID, reward in tutorial.rewards %}
                        <li>{{ reward.name }}&nbsp;:&nbsp;{{ reward.ammount }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
        <div class="tutorial-buttons">
            {% if tutorial.fullfilled and tutorial.last %}
                <a data-method="post" href="{{ path('game_tutorial_claim') }}"><button>{{ LNG.tutorial_buttons_finalize }}</button></a>
            {% elseif tutorial.fullfilled and tutorial.rewards %}
                <a data-method="post" href="{{ path('game_tutorial_claim') }}"><button>{{ LNG.tutorial_buttons_claim }}</button></a>
            {% elseif tutorial.fullfilled %}
                <a data-method="post" href="{{ path('game_tutorial_claim') }}"><button>{{ LNG.tutorial_buttons_continue }}</button></a>
            {% elseif tutorial.skippable %}
                <a data-method="post" href="{{ path('game_tutorial_skip') }}"><button>{{ LNG.tutorial_buttons_skip }}</button></a>
                &nbsp;
                <a data-method="post" href="{{ path('game_tutorial_skip_all') }}" data-confirm="{{ LNG.tutorial_buttons_skipAll_confirm|e('html_attr') }}"><button >{{ LNG.tutorial_buttons_skipAll }}</button></a>
            {% else %}
                <a data-method="post" href="{{ path('game_tutorial_skip_all') }}" data-confirm="{{ LNG.tutorial_buttons_skipAll_confirm|e('html_attr') }}"><button>{{ LNG.tutorial_buttons_skipAll }}</button></a>
            {% endif %}
        </div>
    </div>
    </details>
{% endif %}
<script type="module" src="./scripts/game/tutorial.js?v={{ asset_version }}"></script>
