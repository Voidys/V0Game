{% import '_macros/forms.html.twig' as forms -%}
<section class="panel panel--flush">
<table class="data">
	<tbody>
		<tr>
			<th colspan="3">{{ LNG.in_jump_gate_select_ships }}</th>
		</tr>
		{% if gateData.restTime != 0 %}
		<tr>
			<td colspan="3">{{ LNG.in_jump_gate_wait_time }} {{ gateData.nextTime }}&nbsp;(<span class="countdown" data-time="{{ gateData.restTime }}">{{ getRestTimeFormat(gateData.restTime) }}</span>)</td>
		</tr>
		{% else %}
			<tr>
				<td>{{ LNG.in_jump_gate_start_moon }}</td>
				<td colspan="2">{{ gateData.startLink }}</td>
			</tr>
			{% if gateData.gateList %}
				<tr>
					<td>{{ LNG.in_jump_gate_finish_moon }}</td>
					<td colspan="2">{{ forms.html_options({'options': gateData.gateList, 'name': "jmpto", 'class': "jumpgate"}) }}</td>
				</tr>
				<tr>
					<th>{{ LNG.fl_ship_type }}</th>
					<th class="num">{{ LNG.fl_ship_available }}</th>
					<th></th>
				</tr>
				{% for fleetID, amount in gateData.fleetList %}
				<tr>
					<td>{{ LNG.tech[fleetID] }}</td>
					<td class="num"><span id="ship{{ fleetID }}_value" data-count="{{ amount }}">{{ pretty_number(amount) }}</span></td>
					<td class="num"><span class="control-group"><input class="jumpgate num" name="ship[{{ fleetID }}]" id="ship{{ fleetID }}_input" value="0" type="text"><input data-action="gate-max" data-id="{{ fleetID }}" value="max" type="button"></span></td>
				</tr>
				{% endfor %}
				<tr>
					<td colspan="3" class="form-actions"><input value="{{ LNG.in_jump_gate_jump }}" type="button" data-action="gate-submit" data-url="{{ path('game_information_send_fleet') }}"></td>
				</tr>
			{% else %}
				<tr>
					<td colspan="3"><span class="colorNegative">{{ LNG.in_jump_gate_no_target }}</span></td>
				</tr>
			{% endif %}
		{% endif %}
	</tbody>
</table>
</section>