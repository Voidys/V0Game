{% import '_macros/ui.html.twig' as ui -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_fleet }}{{ parent() }}{% endblock %}
{% block pagehead %}
  {% set actions %}<span class="tag tag--info">{{ LNG.fl_fleets }} {{ activeFleetSlots }} / {{ maxFleetSlots }}</span> <span class="tag tag--info">{{ LNG.fl_planets }} {{ currentPlanetCount }} / {{ maxPlanetCount }}</span> <span class="tag tag--info">{{ LNG.fl_expeditions }} {{ activeExpedition }} / {{ maxExpedition }}</span>{% endset %}
  {{ ui.page_head(LNG.lm_fleet, 'send', null, actions) }}
{% endblock %}
{% block content %}
  {% if notice %}
  <div class="globalWarning" role="alert" id="fleet-notice">{{ icon('triangle-alert') }}<span>{{ notice }}</span></div>
  {% endif %}
  {# experience points and cargo capacity per ship type for the live sums (scripts/game/fleetTable.js) #}
  {% include 'game/shared.missionColors.html.twig' %}
  {% set ships = [] %}
  {% for elementID, fleetArray in shiptypes %}
    {% set ships = ships|merge([{id: fleetArray.id, expo: fleetArray.expo, capacity: fleetArray.capacity}]) %}
  {% endfor %}
  {{ data_island('fleet-table-data', {ships: ships}) }}
  <section class="panel panel--flush">
  {{ ui.panel_head(LNG.fl_fleets, activeFleetSlots) }}
  <div class="flyingFleets-scroll">
  <table class="flyingFleets data">
    {% if FlyingFleetList %}
    <tr class="fleet-head">
      <td class="fleet-col-id ctr">{{ LNG.fl_number }}</td>
      <td class="fleet-col-mission ctr">{{ LNG.fl_mission }}</td>
      <td class="num">{{ LNG.fl_ammount }}</td>
      <td class="num">{{ LNG.fl_resources }}</td>
      <td class="ctr">{{ LNG.fl_beginning }}</td>
      <td class="ctr">{{ LNG.fl_arrival_target }}</td>
      <td class="ctr">{{ LNG.fl_destiny }}</td>
      <td class="ctr">{{ LNG.fl_return_home }}</td>
      <td class="ctr">{{ LNG.fl_objective }}</td>
      <td class="act">{{ LNG.fl_order }}</td>
    </tr>
    {% endif %}
      {% for FlyingFleetRow in FlyingFleetList %}
        <tr class="fleet-row">
          <td class="fleet-col-id ctr">{{ loop.index }}</td>
          <td class="fleet-col-mission ctr fl-mission{% if FlyingFleetRow.cssClass %} {{ FlyingFleetRow.cssClass }}{% endif %}">
            {% set tt_res %}<table class='tt-fleet-res'><tr><td>{{ LNG['tech'][901] }}</td><td>{{ FlyingFleetRow.metal }}</td></tr><tr><td>{{ LNG['tech'][902] }}</td><td>{{ FlyingFleetRow.crystal }}</td></tr><tr><td>{{ LNG['tech'][903] }}</td><td>{{ FlyingFleetRow.deuterium }}</td></tr></table>{% endset %}
            <a
              data-tooltip-content="{{ tt_res|e('html') }}"
              class="tooltip">
                {{ LNG["type_mission_#{FlyingFleetRow.mission}"] }}
            </a>
              {% if FlyingFleetRow.state == 1 %}
                <br>
                <a title="{{ LNG.fl_returning }}">{{ LNG.fl_r }}</a>
              {% else %}
                <br>
                <a title="{{ LNG.fl_onway }}">{{ LNG.fl_a }}</a>
              {% endif %}
          </td>
          {% set tt_ships %}<table><tr><th colspan='2' class='text-center'>{{ LNG.fl_info_detail }}</th></tr>{% for shipID, shipCount in FlyingFleetRow.FleetList %}<tr><td class='transparent'>{{ LNG.tech[shipID] }}:</td><td class='transparent'>{{ shipCount }}</td></tr>{% endfor %}</table>{% endset %}
          <td class="num fl-amount" data-label="{{ LNG.fl_ammount }}"><a class="tooltip_sticky"
                 data-tooltip-content="{{ tt_ships|e('html') }}">{{ FlyingFleetRow.amount }}</a>
          </td>
          <td class="num fl-res" data-label="{{ LNG.fl_resources }}">
            {% if FlyingFleetRow.metal + FlyingFleetRow.crystal + FlyingFleetRow.deuterium > 0 %}
              {% for resKey, resId in {metal: 901, crystal: 902, deuterium: 903} %}
                {% set resAmount = attribute(FlyingFleetRow, resKey) %}
                <span class="fl-res__item{% if resAmount <= 0 %} is-zero{% endif %}" title="{{ LNG['tech'][resId] }}: {{ pretty_number(resAmount) }}"><img src="{{ theme_asset('images/' ~ resKey ~ '.gif') }}" alt="{{ LNG['tech'][resId] }}" width="16" height="11">{{ shortly_number(resAmount, null, true) }}</span>
              {% endfor %}
            {% else %}-{% endif %}
          </td>
          <td class="ctr fl-from" data-label="{{ LNG.fl_beginning }}"><a
              href="{{ path('game_galaxy_show', {galaxy: FlyingFleetRow.startGalaxy, system: FlyingFleetRow.startSystem}) }}">[{{ FlyingFleetRow.startGalaxy }}:{{ FlyingFleetRow.startSystem }}:{{ FlyingFleetRow.startPlanet }}]({{ LNG["type_planet_short_#{FlyingFleetRow.startType}"] }})</a></td>
          <td class="ctr fl-dep{% if FlyingFleetRow.state == 0 %} fleet-active-time{% endif %}" data-label="{{ LNG.fl_arrival_target }}">{{ FlyingFleetRow.startTime }}{% if FlyingFleetRow.state == 0 and FlyingFleetRow.mission != 4 and FlyingFleetRow.targetRest > 0 %}<br><span class="hint">(<span class="fleets fl-target-eta" data-fleet-time="{{ FlyingFleetRow.targetRest }}">{{ getRestTimeFormat(FlyingFleetRow.targetRest) }}</span>)</span>{% endif %}</td>
          <td class="ctr fl-to" data-label="{{ LNG.fl_destiny }}"><a
              href="{{ path('game_galaxy_show', {galaxy: FlyingFleetRow.endGalaxy, system: FlyingFleetRow.endSystem}) }}">[{{ FlyingFleetRow.endGalaxy }}:{{ FlyingFleetRow.endSystem }}:{{ FlyingFleetRow.endPlanet }}]({{ LNG["type_planet_short_#{FlyingFleetRow.endType}"] }})</a></td>
            {% if FlyingFleetRow.mission == 4 and FlyingFleetRow.state == 0 %}
              <td class="ctr fl-arr" data-label="{{ LNG.fl_return_home }}">-</td>
            {% else %}
              <td class="ctr fl-arr{% if FlyingFleetRow.state != 0 %} fleet-active-time{% endif %}" data-label="{{ LNG.fl_return_home }}">{{ FlyingFleetRow.endTime }}</td>
            {% endif %}
          <td id="fleettime_{{ loop.index }}" class="fleets ctr fl-time" data-label="{{ LNG.fl_objective }}"
              data-fleet-end-time="{{ FlyingFleetRow.returntime }}"
              data-fleet-time="{{ FlyingFleetRow.resttime }}">{{ getRestTimeFormat(FlyingFleetRow.resttime) }}</td>
          <td class="act fl-act">
              {% if not isVacation and FlyingFleetRow.state != 1 and FlyingFleetRow.no_returnable != 1 %}
                <form action="{{ path('game_fleet_table_recall') }}" method="post">
                  <input name="fleetID" value="{{ FlyingFleetRow.id }}" type="hidden">
                  <input value="{{ LNG.fl_send_back }}" type="submit" data-confirm="{{ LNG.fl_recall_confirm|replace({'%s': FlyingFleetRow.recallTime})|e('html') }}" data-confirm-tpl="{{ LNG.fl_recall_confirm|e('html') }}">
                </form>
                <span class="aborttime" title="{{ LNG.fl_recall_return }}" starttime="{{ FlyingFleetRow.startTimestamp }}"></span>
                  {% if FlyingFleetRow.mission == 1 %}
                    <form action="{{ path('game_fleet_table_acs') }}" method="post">
                      <input name="fleetID" value="{{ FlyingFleetRow.id }}" type="hidden">
                      <input value="{{ LNG.fl_acs }}" type="submit">

                    </form>
                  {% endif %}
              {% else %}
                &nbsp;-&nbsp;
              {% endif %}
              {% if FlyingFleetRow.repeatQuery and not isVacation %}
                <a class="fleet-repeat" href="{{ path('game_fleet_step1_show', FlyingFleetRow.repeatQuery) }}" title="{{ LNG.fl_send_again_title }}">{{ icon('refresh-cw') }}<span>{{ LNG.fl_send_again }}</span></a>
              {% endif %}
          </td>
        </tr>
          {% else %}
        <tr>
          <td colspan="10"><div class="empty-state empty-state--inline">{{ icon('rocket') }}<p>{{ LNG.fl_no_fleets }}</p></div></td>
        </tr>
      {% endfor %}
      {% if maxFleetSlots == activeFleetSlots %}
        <tr>
          <td colspan="10">{{ LNG.fl_no_more_slots }}</td>
        </tr>
      {% endif %}
  </table>
  </div>
  </section>
    {% if acsData %}
        {% include 'game/shared.fleetTable.acsTable.html.twig' %}
    {% endif %}
  <form action="{{ path('game_fleet_step1_show') }}" method="post" id="fleet-form" data-on-submit="fleet-validate" data-empty-msg="{{ LNG.fl_no_ship_selected|e('html_attr') }}">
    <input type="hidden" name="galaxy" value="{{ targetGalaxy }}">
    <input type="hidden" name="system" value="{{ targetSystem }}">
    <input type="hidden" name="planet" value="{{ targetPlanet }}">
    <input type="hidden" name="type" value="{{ targetType }}">
    <input type="hidden" name="target_mission" value="{{ targetMission }}">
    {% if directTarget %}<input type="hidden" name="direct" value="1">{% endif %}
    {% set selectTitle %}{{ LNG.fl_new_mission_title }}{% if targetMission > 0 %}: {{ LNG["type_mission_#{targetMission}"] }} [{{ targetGalaxy }}:{{ targetSystem }}:{{ targetPlanet }}]{% endif %}{% endset %}
    <div class="stack">
    <section class="panel panel--flush">
    {{ ui.panel_head(selectTitle) }}
    <table class="fleet-select">
      <tbody id="ship-rows">
      <tr class="fleet-select__head">
        <td aria-sort="none"><button type="button" class="link sort-link" data-action="sort-ships" data-key="name">{{ LNG.fl_ship_type }}</button></td>
        <td class="num fl-col-speed" aria-sort="none"><button type="button" class="link sort-link" data-action="sort-ships" data-key="speed">{{ LNG.fl_max_speed }}</button></td>
        <td class="num fl-col-cap" aria-sort="none"><button type="button" class="link sort-link" data-action="sort-ships" data-key="cap">{{ LNG.fl_cargo_capacity }}</button></td>
        <td class="num" aria-sort="none"><button type="button" class="link sort-link" data-action="sort-ships" data-key="count">{{ LNG.fl_ship_available }}</button></td>
        <td class="num fl-col-exp">{% if game_config('wiki_url') %}<a{% if targetMission > 0 and targetMission != 15 %} hidden{% endif %} href="{{ game_config('wiki_url')|trim('/', 'right')|e('html_attr') }}/wiki/{% if lang != 'de' and lang != 'of' and lang != 'pi' %}En/{% endif %}Expeditionen" class="tooltip url" data-tooltip-content="{{ LNG.fl_expocap_explain|e('html_attr') }}" id="expocount" expocap="{{ maxExpo }}">-</a>{% else %}<span{% if targetMission > 0 and targetMission != 15 %} hidden{% endif %} class="tooltip" data-tooltip-content="{{ LNG.fl_expocap_explain|e('html_attr') }}" id="expocount" expocap="{{ maxExpo }}">-</span>{% endif %}</td>
      </tr>
        {% for FleetRow in FleetsOnPlanet %}
          <tr class="ship-row" data-name="{{ LNG.tech[FleetRow.id] }}" data-count="{{ FleetRow.count }}" data-speed="{{ FleetRow.speed }}" data-cap="{{ shiptypes[FleetRow.id].capacity|default(0) }}">
            <td>{{ LNG.tech[FleetRow.id] }}{% if FleetRow.speed != 0 %}<span class="ship-meta"><span title="{{ LNG.fl_max_speed }}">{{ icon('rocket') }} {{ pretty_number(FleetRow.speed) }}</span> <span title="{{ LNG.fl_cargo_capacity }}">{{ icon('truck') }} {{ pretty_number(shiptypes[FleetRow.id].capacity|default(0)) }}</span></span>{% endif %}</td>
            <td class="num fl-col-speed">{% if FleetRow.speed != 0 %}{{ pretty_number(FleetRow.speed) }}{% else %}-{% endif %}</td>
            <td class="num fl-col-cap">{{ pretty_number(shiptypes[FleetRow.id].capacity|default(0)) }}</td>
            <td class="num" id="ship{{ FleetRow.id }}_value" data-count="{{ FleetRow.count }}">{{ pretty_number(FleetRow.count) }}</td>
            <td class="num">
              {% if FleetRow.speed != 0 %}
                <span class="control-group">
                  <button type="button" class="link" data-action="no-ship" data-ship="ship{{ FleetRow.id }}">{{ LNG.fl_null }}</button>
                  <input type="number" name="ship{{ FleetRow.id }}" id="ship{{ FleetRow.id }}_input" value="0" min="0" class="fleet-amount" aria-label="{{ LNG.tech[FleetRow.id] }}">
                  <button type="button" class="link" data-action="max-ship" data-ship="ship{{ FleetRow.id }}">{{ LNG.fl_max }}</button>
                </span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
      <tr>
        <td colspan="5"><div class="fleet-select__foot">
          <span id="cargospace" data="{{ LNG['in_capacity'] }}">&nbsp;</span>
          {% if FleetsOnPlanet|length == 0 %}
            <span>{{ LNG.fl_no_ships }}</span>
          {% else %}
            <span class="control-group">
              <button type="button" class="link" data-action="no-ships">{{ LNG.fl_remove_all_ships }}</button>
              <button type="button" class="link" data-action="max-ships">{{ LNG.fl_select_all_ships }}</button>
            </span>
          {% endif %}
        </div></td>
      </tr>
      <tr><td colspan="5" class="quick-fleets"><span class="quick-fleets__label">{{ LNG.fl_quick_fleets }}</span> <span id="customfleets" class="quick-fleets__list"></span><span id="customfleets-hint" class="hint" hidden>{{ LNG.fl_quick_fleets_hint }}</span></td></tr>
    </table>
    </section>
    <section class="panel panel--flush">
    {{ ui.panel_head(LNG.fl_resources) }}
    <table>
      <tr>
        <td>{{ LNG['tech'][901] }}</td>
        <td>{{ LNG['tech'][902] }}</td>
        <td>{{ LNG['tech'][903] }}</td>
      </tr>
      <tr>
        <td><input name="met_storage"
                   type="number" min="0" class="fleet-amount fleet-amount--fill"
                   placeholder="0" aria-label="{{ LNG['tech'][901] }}"></td>
        <td><input name="krist_storage" type="number" min="0" class="fleet-amount fleet-amount--fill"
                   placeholder="0" aria-label="{{ LNG['tech'][902] }}"></td>
        <td><input name="deut_storage" type="number" min="0" class="fleet-amount fleet-amount--fill"
                   placeholder="0" aria-label="{{ LNG['tech'][903] }}"></td>
      </tr>
      <tr>
        <td colspan="3" class="ctr">
          <button type="button" id="gt_select">{{ LNG['tech'][203] }}<span id="gt_amt"></span></button>
          <button type="button" id="kt_select">{{ LNG['tech'][202] }}<span id="kt_amt"></span></button>
          <button type="button" class="link" data-action="clear-resources">{{ LNG.fl_load_clear }}</button>
          <span class="hint">{{ LNG.fl_load_hint }}</span>
        </td>
      </tr>
    </table>
    </section>
    {% if maxFleetSlots != activeFleetSlots %}
    <div class="panel fleet-dock"><footer class="panel__foot"><input type="submit" value="{{ LNG.fl_continue }}"></footer></div>
    {% endif %}
    </div>
  </form>

  <section class="panel panel--flush">
  {{ ui.panel_head(LNG.fl_cargo_options) }}
  <div class="table-scroll">
  <table class="data">
    <thead>
      <tr>
        <th>{{ LNG.fl_cargo_preset }}</th>
        <th class="num">{{ LNG['tech'][901] }}</th>
        <th class="num">{{ LNG['tech'][902] }}</th>
        <th class="num">{{ LNG['tech'][903] }}</th>
        <th class="num">{{ LNG.fl_cargo_needed }} <span title="{{ LNG['tech'][202] }}">{{ icon('car') }}</span> / <span title="{{ LNG['tech'][203] }}">{{ icon('truck') }}</span></th>
        <th class="ctr">{{ LNG.fl_cargo_select }}</th>
      </tr>
    </thead>
    <tbody>
      {% for key, entry in watchList %}
          <tr>
            <td>{% if key==0 %}{{ entry.name }}{% else %}{{ entry.coords }} {{ entry.name }} ({{ entry.level }}){% endif %}</td>
            <td class="num {{ (resourceTable[901].current>=entry.metal) ? 'colorPositive':'colorNegative' }}">{{ pretty_number(entry.metal) }}</td>
            <td class="num {{ (resourceTable[902].current>=entry.crystal) ? 'colorPositive':'colorNegative' }}">{{ pretty_number(entry.crystal) }}</td>
            <td class="num {{ (resourceTable[903].current>=entry.deuterium) ? 'colorPositive':'colorNegative' }}">{{ pretty_number(entry.deuterium) }}</td>
            <td class="num">
              <span class="{% if FleetsOnPlanet[202].count >= entry.needed202 %}colorPositive{% else %}colorNegative{% endif %}">{{ pretty_number(entry.needed202) }}</span> / <span class="{% if FleetsOnPlanet[203].count >= entry.needed203 %}colorPositive{% else %}colorNegative{% endif %}">{{ pretty_number(entry.needed203) }}</span>
            </td>
            <td class="ctr">
              <span class="{% if FleetsOnPlanet[202].count == 0 %}colorNegative{% else %}{% if FleetsOnPlanet[202].count >= entry.needed202 %}colorPositive{% else %}colorNeutral{% endif %}{% endif %} clickable" data-action="cargo-preset" data-type="202" data-galaxy="{{ entry.galaxy }}" data-system="{{ entry.system }}" data-planet="{{ entry.planet }}" data-planet-type="{{ entry.planet_type }}" data-metal="{{ entry.metal }}" data-crystal="{{ entry.crystal }}" data-deuterium="{{ entry.deuterium }}" data-total="{{ entry.total }}" data-ship202="{{ FleetsOnPlanet[202].count|default(0) }}" data-ship203="{{ FleetsOnPlanet[203].count|default(0) }}" data-needed202="{{ entry.needed202 }}" data-needed203="{{ entry.needed203 }}" data-capacity202="{{ shiptypes[202].capacity }}" data-capacity203="{{ shiptypes[203].capacity }}">{{ icon('car') }}</span> /
              <span class="{% if FleetsOnPlanet[203].count == 0 %}colorNegative{% else %}{% if FleetsOnPlanet[203].count >= entry.needed203 %}colorPositive{% else %}colorNeutral{% endif %}{% endif %} clickable" data-action="cargo-preset" data-type="203" data-galaxy="{{ entry.galaxy }}" data-system="{{ entry.system }}" data-planet="{{ entry.planet }}" data-planet-type="{{ entry.planet_type }}" data-metal="{{ entry.metal }}" data-crystal="{{ entry.crystal }}" data-deuterium="{{ entry.deuterium }}" data-total="{{ entry.total }}" data-ship202="{{ FleetsOnPlanet[202].count|default(0) }}" data-ship203="{{ FleetsOnPlanet[203].count|default(0) }}" data-needed202="{{ entry.needed202 }}" data-needed203="{{ entry.needed203 }}" data-capacity202="{{ shiptypes[202].capacity }}" data-capacity203="{{ shiptypes[203].capacity }}">{{ icon('truck') }}</span>
            </td>
          </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="hint panel__body">{{ LNG.fl_cargo_options_hint }}</p>
  </section>
  <section class="panel panel--flush">
  {{ ui.panel_head(LNG.fl_bonus) }}
  <table class="fleet-bonus">
    <tr>
      <th>{{ LNG.fl_bonus_attack }}</th>
      <th>{{ LNG.fl_bonus_shield }}</th>
      <th>{{ LNG.fl_bonus_defensive }}</th>
    </tr>
    <tr>
      <td>+{{ bonusAttack }} %</td>
      <td>+{{ bonusShield }} %</td>
      <td>+{{ bonusDefensive }} %</td>
    </tr>
    <tr>
      <th>{{ LNG.tech[115] }}</th>
      <th>{{ LNG.tech[117] }}</th>
      <th>{{ LNG.tech[118] }}</th>
    </tr>
    <tr>
      <td>+{{ bonusCombustion }} %</td>
      <td>+{{ bonusImpulse }} %</td>
      <td>+{{ bonusHyperspace }} %</td>
    </tr>
  </table>
  </section>
  <section class="panel panel--flush">
  <header class="panel__head clickable" data-action="toggle-custom-fleet"><h2><span id="c_fleet_span">▼</span> {{ LNG["custom_fleet"] }}</h2></header>
  <table id="customfleet" style="display: none" data-noname="{{ LNG['fleet_table_custom_empty_name'] }}" data-delconf="{{ LNG['custom_fleet_confirm'] }}" data-saved="{{ LNG['al_saved'] }}">
    <tr>
      <th colspan=3><select id="cfleet_select" class="control-wide">

        </select></th>
    </tr>
    <tr>
      <th colspan=3><input id="cfleet_name" placeholder="name" class="control-wide"></th>
    </tr>
    <tr>
      <td colspan=1>{{ LNG['type_mission_15'] }}</td>
      <td colspan=2 id="ship_expo_points"></td>
    </tr>
    <tr>
      <td colspan=1>{{ LNG['in_capacity'] }}</td>
      <td colspan=2 id="ship_cargo_points"></td>
    </tr>

    <tr>
      <th colspan="2">{{ LNG.tech[200] }}</th>
      <th colspan="1" class="num">{{ LNG['rec_count'] }}</th>
    </tr>
      {% for elementID, fleetArray in shiptypes %}
        <tr>
          <td colspan="2">{{ LNG.tech[fleetArray.id] }}</td>
          <td colspan="1" class="num"><input id="ship_{{ fleetArray.id }}" type="number" value="0"></td>
        </tr>
      {% endfor %}

    <tr>
      <td colspan="3" class="form-actions">
        <button id="cf_save">
            {{ LNG['al_save'] }}
        </button>
        <button id="cf_del">
            {{ LNG['al_dlte'] }}
        </button>
      </td>
    </tr>


  </table>
  </section>
{% endblock %}
{% block script %}{{ parent() }}
  <script type="module" src="scripts/game/fleetTable.js?v={{ asset_version }}"></script>
{% endblock %}
