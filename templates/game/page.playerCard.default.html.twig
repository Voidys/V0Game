{% import '_macros/ui.html.twig' as ui -%}
{% macro row(label, value, pct, lockText) %}
<tr>
	<td>{% if lockText %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10" alt=""><span class="tooltiptext">{{ lockText }}</span></div> {% endif %}{{ label }}</td>
	{% if pct == '' %}<td class="num" colspan="2">{{ value }}</td>{% else %}<td class="num">{{ value }}</td><td class="num">{{ pct }}</td>{% endif %}
</tr>
{% endmacro %}
{% macro prow(label, locked, lockText, points, percent, rank) %}
<tr>
	<td>{% if locked %}<div class="tooltip1"><img src="./styles/resource/images/icons/lock.webp" height="10" width="10" alt=""><span class="tooltiptext">{{ lockText }}</span></div> {% endif %}{{ label }}</td>
	<td class="num">{% if locked %}-{% else %}{{ points }}{% endif %}</td>
	<td class="num">{% if not locked %}{{ percent }}%{% endif %}</td>
	<td class="num">{% if not locked %}{{ rank }}{% endif %}</td>
</tr>
{% endmacro %}
{% extends layout_template %}
{% block title %}{{ LNG.lm_playercard }}{{ parent() }}{% endblock %}
{% block content %}
<script type="module" src="./scripts/game/playercard.js?v={{ asset_version }}"></script>
{% set lock6 = LNG.spytech_playercard.level6 %}
{% set cardMeta %}{{ LNG.pl_range }} {{ total_rank }} &middot; {{ total_points }} {{ LNG.pl_points }}{% endset %}
{% set cardActions %}{% if id != yourid %}
	<a class="button btn-sm" href="#" data-action="dialog-pm" data-id="{{ id }}">{{ icon('mail') }}{{ LNG.pl_message }}</a>
	<a class="button btn-sm" href="#" data-action="dialog-buddy" data-id="{{ id }}">{{ icon('user-plus') }}{{ LNG.pl_buddy }}</a>
	<a class="button btn-sm" href="{{ path('game_galaxy_show', {galaxy: galaxy, system: system}) }}">{{ icon('galaxy') }}{{ LNG.pl_galaxy_view }}</a>
	<a class="button btn-sm" href="{{ path('game_notes_new') }}">{{ icon('sticky-note') }}{{ LNG.pl_note }}</a>
{% endif %}{% endset %}
{{ ui.page_head(name, 'user', cardMeta, cardActions) }}

<div class="stats">
	<div class="stat"><span class="stat__label">{{ LNG.pl_homeplanet }}</span><span class="stat__value">{{ homeplanet }} <a href="{{ path('game_galaxy_show', {galaxy: galaxy, system: system}) }}">[{{ galaxy }}:{{ system }}:{{ planet }}]</a></span></div>
	<div class="stat"><span class="stat__label">{{ LNG.pl_ally }}</span><span class="stat__value">{% if allyname %}<a href="{{ path('game_alliance_info', {id: allyid}) }}">{{ allyname }}</a>{% else %}-{% endif %}</span></div>
	<div class="stat"><span class="stat__label">{{ LNG.pl_points }}</span><span class="stat__value">{{ total_points }}</span></div>
	<div class="stat"><span class="stat__label">{{ LNG.pl_range }}</span><span class="stat__value">{{ total_rank }}</span></div>
</div>

<section class="panel panel--flush">
	{{ ui.panel_head(LNG.pl_overview) }}
	<table class="data">
		<thead>
			<tr>
				<th></th>
				<th class="num">{{ LNG.pl_points }}</th>
				<th class="num">%</th>
				<th class="num">{{ LNG.pl_range }}</th>
			</tr>
		</thead>
		<tbody>
			{{ _self.prow(LNG.pl_builds, not showBuild, LNG.spytech_playercard.level2, build_points, build_percent, build_rank) }}
			{{ _self.prow(LNG.pl_tech, not showTech, LNG.spytech_playercard.level4, tech_points, tech_percent, tech_rank) }}
			{{ _self.prow(LNG.pl_fleet, not showFleet, lock6, fleet_points, fleet_percent, fleet_rank) }}
			{{ _self.prow(LNG.pl_def, not showDef, lock6, defs_points, defs_percent, defs_rank) }}
			{{ _self.prow(LNG.pl_total, false, '', total_points, 100, total_rank) }}
		</tbody>
	</table>
</section>

<div class="grid-2">
	<section class="panel panel--flush">
		{{ ui.panel_head(LNG.pl_fightstats) }}
		<table class="data">
			<thead>
				<tr>
					<th></th>
					<th class="num">{{ LNG.pl_fights }}</th>
					<th class="num">{{ LNG.pl_fprocent }}</th>
				</tr>
			</thead>
			<tbody>
			{% if showBattle == true %}
				{{ _self.row(LNG.pl_fightwon, wons, siegprozent ~ '%', '') }}
				{{ _self.row(LNG.pl_fightdraw, draws, drawsprozent ~ '%', '') }}
				{{ _self.row(LNG.pl_fightlose, loos, loosprozent ~ '%', '') }}
				{{ _self.row(LNG.pl_totalfight, totalfights, '100%', '') }}
			{% else %}
				{{ _self.row(LNG.pl_fightwon, '-', '', lock6) }}
				{{ _self.row(LNG.pl_fightdraw, '-', '', lock6) }}
				{{ _self.row(LNG.pl_fightlose, '-', '', lock6) }}
				{{ _self.row(LNG.pl_totalfight, '-', '', lock6) }}
			{% endif %}
			</tbody>
		</table>
	</section>

	{% if not showBattle or isModuleAvailable(constant('MODULE_HONORPOINTS')) %}
	<section class="panel panel--flush">
		{{ ui.panel_head(LNG.honorpoints) }}
		<table class="data">
			<tbody>
			{% if showBattle == true %}
				{{ _self.row(LNG.honorpoints, honorpoints, '', '') }}
				{{ _self.row(LNG.honor_rank, honor_rank, '', '') }}
			{% else %}
				{{ _self.row(LNG.honorpoints, '-', '', lock6) }}
				{{ _self.row(LNG.honor_rank, '-', '', lock6) }}
			{% endif %}
			</tbody>
		</table>
		<table class="data">
			<thead>
				<tr>
					<th>{{ LNG.honorfights }}</th>
					<th class="num">{{ LNG.pl_fights }}</th>
					<th class="num">{{ LNG.pl_fprocent }}</th>
				</tr>
			</thead>
			<tbody>
			{% if showBattle == true %}
				{{ _self.row(LNG.honorable_fights, honorable_fights, honorable_percent ~ '%', '') }}
				{{ _self.row(LNG.dishonorable_fights, dishonorable_fights, dishonorable_percent ~ '%', '') }}
				{{ _self.row(LNG.neutral_fights, neutral_fights, neutral_percent ~ '%', '') }}
			{% else %}
				{{ _self.row(LNG.honorable_fights, '-', '', lock6) }}
				{{ _self.row(LNG.dishonorable_fights, '-', '', lock6) }}
				{{ _self.row(LNG.neutral_fights, '-', '', lock6) }}
			{% endif %}
			</tbody>
		</table>
	</section>
	{% endif %}
</div>

<div class="grid-2">
	<section class="panel panel--flush">
		{{ ui.panel_head(playerdestory) }}
		<table class="data">
			<tbody>
			{% if showBattle == true %}
				{{ _self.row(LNG.pl_unitsshot, desunits, '', '') }}
				{{ _self.row(LNG.pl_unitslose, lostunits, '', '') }}
				{{ _self.row(LNG.pl_dermetal, kbmetal, '', '') }}
				{{ _self.row(LNG.pl_dercrystal, kbcrystal, '', '') }}
			{% else %}
				{{ _self.row(LNG.pl_unitsshot, '-', '', lock6) }}
				{{ _self.row(LNG.pl_unitslose, '-', '', lock6) }}
				{{ _self.row(LNG.pl_dermetal, '-', '', lock6) }}
				{{ _self.row(LNG.pl_dercrystal, '-', '', lock6) }}
			{% endif %}
			</tbody>
		</table>
	</section>
	<section class="panel panel--flush">
		{{ ui.panel_head(realdestory) }}
		<table class="data">
			<tbody>
			{% if showBattle == true %}
				{{ _self.row(LNG.pl_unitsshot, realdesunits, '', '') }}
				{{ _self.row(LNG.pl_unitslose, reallostunits, '', '') }}
				{{ _self.row(LNG.pl_dermetal, realmetal, '', '') }}
				{{ _self.row(LNG.pl_dercrystal, realcrystal, '', '') }}
			{% else %}
				{{ _self.row(LNG.pl_unitsshot, '-', '', lock6) }}
				{{ _self.row(LNG.pl_unitslose, '-', '', lock6) }}
				{{ _self.row(LNG.pl_dermetal, '-', '', lock6) }}
				{{ _self.row(LNG.pl_dercrystal, '-', '', lock6) }}
			{% endif %}
			</tbody>
		</table>
	</section>
</div>

{% if id != yourid and targetRights == 0 %}
<section class="panel">
	{{ ui.panel_head(LNG.pl_block_head) }}
	<div class="panel__body">
		<div class="toolbar">
			<label class="control-group" for="blockTrade">{{ LNG.blockTrade }} <input data-action="player-block" data-id="{{ id }}" data-url="{{ path('game_player_card_toggle_block') }}" name="blockTrade" id="blockTrade" type="checkbox" value="1" {% if blockTrade == 1 %}checked="checked" {% endif %}></label>
			<label class="control-group" for="blockDm">{{ LNG.blockDm }} <input data-action="player-block" data-id="{{ id }}" data-url="{{ path('game_player_card_toggle_block') }}" name="blockDm" id="blockDm" type="checkbox" value="1" {% if blockDm == 1 %}checked="checked" {% endif %}></label>
		</div>
		<p class="hint">{{ LNG.pl_block_hint }}</p>
	</div>
</section>
{% endif %}

<section class="panel">
	{{ ui.panel_head(LNG.Achievements) }}
	<div class="panel__body ach-icons">
		{% for achievement in achievements %}
			<img class="achievement-icon" src="{{ theme_asset('achievements/' ~ achievement.image ~ '.svg') }}" data-action="dialog-ach" data-id="{{ achievement.id }}" title="{{ LNG.Achievement_names[achievement.id] }}" alt="{{ achievement.name }}">
			{% include 'game/shared.achievementInfo.html.twig' with {id: achievement.id, image: theme_asset('achievements/' ~ achievement.image ~ '.svg')} only %}
		{% endfor %}
	</div>
</section>
{% endblock %}
