{% extends layout_template %}
{% import '_macros/ui.html.twig' as ui %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(al_write_request, 'users') }}{% endblock %}
{% block content %}
<form class="panel" action="{{ path('game_alliance_apply_send', {id: allyid}) }}" method="post">
<table class="form-table">
	<tr>
		<td><label for="message">{{ LNG.al_message }}</label></td>
		<td><textarea name="text" rows="20" id="message">{{ applytext }}</textarea></td>
	</tr>
	<tr>
		<td colspan="2" class="form-actions"><input type="submit" value="{{ LNG.al_applyform_send }}"></td>
	</tr>
</table>
</form>
{% endblock %}
