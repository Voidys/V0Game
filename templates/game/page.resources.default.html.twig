{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_resources }}{{ parent() }}{% endblock %}
{% macro tip(id, ext) %}<a href='#' data-action="dialog-info" data-id="{{ id }}" class='tooltip'
	data-tooltip-content="{{ include('game/tooltip.element.html.twig', {id: id})|e('html_attr') }}">{{ LNG.tech[id] }}</a>{% endmacro %}
{% macro val(v) %}<span class="{% if v > 0 %}colorPositive prod-pos{% elseif v < 0 %}colorNegative prod-neg{% else %}white prod-zero{% endif %}">{{ pretty_number(v) }}</span>{% endmacro %}
{% import '_macros/ui.html.twig' as ui %}
{% block pagehead %}{{ ui.page_head(LNG.lm_resources, 'database') }}{% endblock %}
{% block content %}
	{% if catchUpLine %}<p class="hint">{{ icon('rocket') }} {{ catchUpLine }}</p>{% endif %}
	<form action="{{ path('game_resources_send') }}" method="post" class="prod-form">
		<section class="panel panel--flush">
		<header class="panel__head">
			<h2>{{ header }}</h2>
			<span class="prod-actions toolbar">
				<button type="button" class="btn-sm" data-prod-all="10" data-confirm="{{ LNG.rs_ramp_up_confirm|e('html_attr') }}">{{ LNG.rs_ramp_up }}</button>
				<button type="button" class="btn-sm" data-prod-all="0" data-confirm="{{ LNG.rs_shut_down_confirm|e('html_attr') }}" data-confirm-danger>{{ LNG.rs_shut_down }}</button>
				<input value="{{ LNG.rs_calculate }}" type="submit" id="prod-save" class="btn--primary btn-sm">
			</span>
		</header>
		<div class="table-scroll">
		<table class="prod-table data">
			<thead>
				<tr>
					<th></th>
					<th class="num res-metal">{{ _self.tip(901, 'gif') }}</th>
					<th class="num res-crystal">{{ _self.tip(902, 'gif') }}</th>
					<th class="num res-deuterium">{{ _self.tip(903, 'gif') }}</th>
					<th class="num res-energy">{{ _self.tip(911, 'gif') }}</th>
					<th class="act"></th>
				</tr>
			</thead>
			<tbody>
				<tr class="prod-basic">
					<td>{{ LNG.rs_basic_income }}</td>
					<td class="num res-metal">{{ pretty_number(basicProduction[901]) }}</td>
					<td class="num res-crystal">{{ pretty_number(basicProduction[902]) }}</td>
					<td class="num res-deuterium">{{ pretty_number(basicProduction[903]) }}</td>
					<td class="num res-energy">{{ pretty_number(basicProduction[911]) }}</td>
					<td class="act"></td>
				</tr>
				{% for productionID, productionRow in productionList %}
					<tr class="prod-row">
						<td>{{ _self.tip(productionID, (productionID >=600 and productionID <= 699) ? 'jpg' : 'gif') }}
							<span class="lvl" title="{% if productionID > 200 %}{{ LNG.rs_amount }}{% else %}{{ LNG.rs_lvl }}{% endif %}">{{ productionRow.elementLevel }}</span>
						</td>
						<td class="num res-metal">{{ _self.val(productionRow.production[901]) }}</td>
						<td class="num res-crystal">{{ _self.val(productionRow.production[902]) }}</td>
						<td class="num res-deuterium">{{ _self.val(productionRow.production[903]) }}</td>
						<td class="num res-energy">{{ _self.val(productionRow.production[911]) }}</td>
						<td class="act">
							{{ forms.html_options({'name': "prod[#{productionID}]", 'options': prodSelector[productionID], 'selected': productionRow.prodLevel}) }}
						</td>
					</tr>
				{% endfor %}
				<tr class="prod-bonus">
					<td>{{ LNG.rs_ress_bonus }}</td>
					<td class="num res-metal">{{ _self.val(bonusProduction[901]) }}<br><span class="prod-pct">({{ metalProcTech * 2 }}%)</span></td>
					<td class="num res-crystal">{{ _self.val(bonusProduction[902]) }}<br><span class="prod-pct">({{ crystalProcTech * 2 }}%)</span></td>
					<td class="num res-deuterium">{{ _self.val(bonusProduction[903]) }}<br><span class="prod-pct">({{ deuteriumProcTech *2 }}%)</span></td>
					<td class="num res-energy">{{ _self.val(bonusProduction[911]) }}</td>
					<td class="act"></td>
				</tr>
				{% if positionBasedRessourceBonus %}
					<tr class="prod-bonus">
						<td>{{ LNG.rs_ress_bonus_position }}</td>
						<td class="num res-metal">{{ _self.val(bonusProductionPositionBased[901]) }}<br><span class="prod-pct">({{ metalBonusPercent }}%)</span></td>
						<td class="num res-crystal">{{ _self.val(bonusProductionPositionBased[902]) }}<br><span class="prod-pct">({{ crystalBonusPercent }}%)</span></td>
						<td class="num res-deuterium">{{ _self.val(bonusProductionPositionBased[903]) }}<br><span class="prod-pct">({{ deuteriumBonusPercent }}%)</span></td>
						<td class="num res-energy">{{ _self.val(bonusProductionPositionBased[911]) }}</td>
						<td class="act"></td>
					</tr>
				{% endif %}
				{% if relicProduction %}
					<tr class="prod-bonus prod-relics">
						<td>{{ LNG.rl_prod_row }}</td>
						<td class="num res-metal">{{ _self.val(relicProduction.rows[901]) }}<br><span class="prod-pct">({{ relicProduction.pct[901]|number_format(2) }}%)</span></td>
						<td class="num res-crystal">{{ _self.val(relicProduction.rows[902]) }}<br><span class="prod-pct">({{ relicProduction.pct[902]|number_format(2) }}%)</span></td>
						<td class="num res-deuterium">{{ _self.val(relicProduction.rows[903]) }}<br><span class="prod-pct">({{ relicProduction.pct[903]|number_format(2) }}%)</span></td>
						<td class="num res-energy">{{ _self.val(relicProduction.rows[911]) }}<br><span class="prod-pct">({{ relicProduction.pct[911]|number_format(2) }}%)</span></td>
						<td class="act"></td>
					</tr>
				{% endif %}
				<tr class="prod-storage prod-sep">
					<td>{{ LNG.rs_storage_capacity }}</td>
					<td class="num res-metal"><span class="colorPositive">{{ storage[901] }}</span></td>
					<td class="num res-crystal"><span class="colorPositive">{{ storage[902] }}</span></td>
					<td class="num res-deuterium"><span class="colorPositive">{{ storage[903] }}</span></td>
					<td class="num res-energy">-</td>
					<td class="act"></td>
				</tr>
				<tr class="prod-storage">
					<td>{{ LNG.rs_full_in }}</td>
					{% for resId, cls in {901: 'res-metal', 902: 'res-crystal', 903: 'res-deuterium'} %}
						<td class="num {{ cls }}">{% if fullIn[resId] is same as(0) %}<span class="colorNegative">{{ LNG.rs_full_now }}</span>{% elseif fullIn[resId] is null %}-{% else %}{{ getRestTimeFormat(fullIn[resId], true) }}{% endif %}</td>
					{% endfor %}
					<td class="num res-energy">-</td>
					<td class="act"></td>
				</tr>
			</tbody>
			<tfoot>
				<tr class="prod-total prod-sep">
					<td>{{ LNG.rs_sum }}:</td>
					<td class="num res-metal">{{ _self.val(totalProduction[901]) }}</td>
					<td class="num res-crystal">{{ _self.val(totalProduction[902]) }}</td>
					<td class="num res-deuterium">{{ _self.val(totalProduction[903]) }}</td>
					<td class="num res-energy {% if totalProduction[911] < 0 %}prod-deficit{% endif %}">{{ _self.val(totalProduction[911]) }}</td>
					<td class="act"></td>
				</tr>
				<tr class="prod-total">
					<td>{{ LNG.rs_daily }}</td>
					<td class="num res-metal">{{ _self.val(dailyProduction[901]) }}</td>
					<td class="num res-crystal">{{ _self.val(dailyProduction[902]) }}</td>
					<td class="num res-deuterium">{{ _self.val(dailyProduction[903]) }}</td>
					<td class="num res-energy">{{ _self.val(dailyProduction[911]) }}</td>
					<td class="act"></td>
				</tr>
				<tr class="prod-total">
					<td>{{ LNG.rs_weekly }}</td>
					<td class="num res-metal">{{ _self.val(weeklyProduction[901]) }}</td>
					<td class="num res-crystal">{{ _self.val(weeklyProduction[902]) }}</td>
					<td class="num res-deuterium">{{ _self.val(weeklyProduction[903]) }}</td>
					<td class="num res-energy">{{ _self.val(weeklyProduction[911]) }}</td>
					<td class="act"></td>
				</tr>
			</tfoot>
		</table>
		</div>
		{% if totalProduction[911] < 0 %}<p class="panel__foot reason reason--bad colorNegative">{{ icon('triangle-alert') }} {{ LNG.rs_energy_deficit }}</p>{% endif %}
		</section>
	</form>
	{% include 'game/engagement/_relics.html.twig' %}
	<script type="module" src="./scripts/game/resources.js?v={{ asset_version }}"></script>
{% endblock %}