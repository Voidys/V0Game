{% import '_macros/ui.html.twig' as ui %}
{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block pagehead %}
{% set actions %}<a class="btn" href="{{ path('game_alliance_admin') }}">{{ icon('arrow-left') }} {{ LNG.al_back }}</a> <button type="button" class="btn btn--primary" id="create_new_alliance_rank" data-action="dialog-show" data-target="new_alliance_rank" data-width="760" title="{{ LNG.al_create_new_rank|e('html_attr') }}">{{ icon('plus') }} {{ LNG.al_create_new_rank }}</button>{% endset %}
{{ ui.page_head(LNG.al_configura_ranks, 'shield-check', LNG.al_manage_alliance, actions) }}
{% endblock %}
{% block content %}
{% set countRank = availableRanks|length %}
<form class="stack" action="{{ path('game_alliance_admin_permissions_send') }}" method="post">
	<section class="panel panel--flush">
	<table class="data rank-table">
	<thead><tr>
		<th class="ctr">{{ LNG.al_dlte }}</th>
		<th>{{ LNG.al_rank_name }}</th>
		{% for rankName in availableRanks %}
		<th class="ctr"><img class="inline" src="styles/resource/images/alliance/{{ rankName }}.png" alt="{{ LNG.al_rank_desc[rankName]|e('html_attr') }}" title="{{ LNG.al_rank_desc[rankName]|e('html_attr') }}" width="16" height="16"></th>
		{% endfor %}
	</tr></thead>
	<tbody>
	{% for rowId, rankRow in rankList %}
	<tr>
		<td class="ctr">{% if changeableRanks[rowId] and rowId != ownRankId %}<a data-method="post" href="{{ path('game_alliance_admin_permissions_send', {deleteRank: rowId}) }}"><img class="inline" src="styles/resource/images/alliance/CLOSE.webp" alt="{{ LNG.al_dlte|e('html_attr') }}" title="{{ LNG.al_dlte|e('html_attr') }}" width="16" height="16"></a>{% endif %}</td>
		<td><input type="text" class="control-wide" aria-label="{{ LNG.al_rank_name|e('html_attr') }}" name="rank[{{ rowId }}][rankName]" value="{{ rankRow.rankName }}"{% if not changeableRanks[rowId] or rowId == ownRankId %} disabled{% endif %}></td>
		{% for rankId, rankName in availableRanks %}
		<td class="ctr"><input type="checkbox" aria-label="{{ LNG.al_rank_desc[rankName]|e('html_attr') }}" name="rank[{{ rowId }}][{{ rankId }}]" value="1"{% if rankRow[rankName] %} checked{% endif %}{% if not ownRights[rankName] or not changeableRanks[rowId] or rowId == ownRankId %} disabled{% endif %}></td>
		{% endfor %}
	</tr>
	{% else %}
	<tr>
		<td colspan="{{ countRank + 2 }}" class="empty">{{ LNG.al_no_ranks_defined }}</td>
	</tr>
	{% endfor %}
	</tbody>
	</table>
	<footer class="panel__foot"><input type="submit" value="{{ LNG.al_save }}"></footer>
	</section>
	<section class="panel panel--flush">
	{{ ui.panel_head(LNG.gl_legend) }}
	<table class="data">
		<tbody>
		{% for rankName in availableRanks %}
		<tr>
			<td class="ctr"><img class="inline" src="styles/resource/images/alliance/{{ rankName }}.png" alt="" width="16" height="16"></td>
			<td>{{ LNG.al_rank_desc[rankName] }}</td>
		</tr>
		{% endfor %}
		</tbody>
	</table>
	</section>
</form>

<div id="new_alliance_rank" title="{{ LNG.al_create_new_rank }}" style="display:none;">
	<form action="{{ path('game_alliance_admin_permissions_send') }}" method="post">
		<table class="form-table">
	<tr>
				<td><label for="rankName">{{ LNG.al_rank_name }}</label></td>
				<td><input type="text" name="newrank[rankName]" maxlength="32" id="rankName" required></td>
	</tr>
			<tr>
				<th colspan="2">&nbsp;</th>
			</tr>
	{% for rankId, rankName in availableRanks %}
	<tr>
		<td><img src="styles/resource/images/alliance/{{ rankName }}.png" alt="{{ rankName }}" width="16" height="16">&nbsp;<label for="rank_{{ rankId }}">{{ LNG.al_rank_desc[rankName] }}</label></td>
		<td><input type="checkbox" name="newrank[{{ rankId }}]" value="1" id="rank_{{ rankId }}" title="{{ LNG.al_rank_desc[rankName] }}"></td>
	</tr>
	{% endfor %}
	<tr>
		<td colspan="2" class="form-actions"><input type="submit" value="{{ LNG.al_create }}"></td>
	</tr>
	</table>
</form>
</div>
{% endblock %}
{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/alliance.js?v={{ asset_version }}"></script>
{% endblock %}
