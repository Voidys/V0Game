{% extends layout_template %}
{% import 'game/macros.buildcard.html.twig' as b %}
{% block title %}{{ LNG.lm_research }}{{ parent() }}{% endblock %}
{% block pagehead %}
  {% set meta = isCatchUp ? catchUp ~ ' %' : null %}
  {{ b.pagehead(LNG.lm_research, 'flask-conical', meta) }}
{% endblock %}
{% block content %}
	{% if not hasLab %}<div class="infobox">{{ icon('flask-conical') }}<span>{{ LNG.bd_no_lab }}</span></div>{% endif %}
	{% include 'game/shared.buildqueue.html.twig' with {queuePage: 'research', queueTitle: LNG.lm_research} %}

	{% if IsLabinBuild %}<div class="infobox">{{ icon('triangle-alert') }}<span>{{ LNG.bd_building_lab }}</span></div>{% endif %}
	<div class="toolbar">
		<span class="segmented" role="group"><button id="lab1" data-action="filter-rows" data-filter-group="lab" data-hide=".infos" data-show="#t108, #t113, #t114, #t123, #t124">{{ LNG.fm_imperial }}</button><button id="lab2" data-action="filter-rows" data-filter-group="lab" data-hide=".infos" data-show="#t109, #t106, #t110, #t111, #t120, #t121, #t122, #t199">{{ LNG.fm_military }}</button><button id="lab3" data-action="filter-rows" data-filter-group="lab" data-hide=".infos" data-show="#t114, #t115, #t117, #t118">{{ LNG.fm_engines }}</button><button id="lab4" data-action="filter-rows" data-filter-group="lab" data-hide=".infos" data-show="#t131, #t132, #t133">{{ LNG.fm_mining }}</button><button id="lab5" class="selected" data-action="filter-rows" data-filter-group="lab" data-hide=".infos">{{ LNG.fm_all }}</button></span>
	</div>

	{% set baseEnd = (umode == 0 and Queue) ? (Queue|last).endtime : ('now'|date('U')) %}
	<div class="build-grid">
		{% for ID, Element in ResearchList %}
			{% if hide_useless == 0 or Element['max_useful_level'] == 0 or Element['level'] < Element['max_useful_level'] %}
				{% set blocked = not hasLab or Element.blockedHere %}
				{% set atMax = Element.maxLevel == Element.levelToBuild %}
				{% set queued = Element.levelToBuild > Element.level %}
				{% set label = (Element.level == 0 and Element.levelToBuild == 0) ? LNG.bd_tech : LNG.bd_tech_next_level ~ (Element.levelToBuild + 1) %}

				{% set watch_toggle %}
					{% if ID == watch %}
						<a class="card__watch is-on" href="{{ path('game_research_show', {watch: 0}) }}" aria-label="{{ LNG.ui_unwatch }}" data-tip="{{ LNG.ui_unwatch }}">{{ icon('star') }}</a>
					{% else %}
						<a class="card__watch" href="{{ path('game_research_show', {watch: ID}) }}" aria-label="{{ LNG.ui_watch }}" data-tip="{{ LNG.ui_watch }}">{{ icon('star') }}</a>
					{% endif %}
				{% endset %}

				{% set extra %}
					{% if Element.factor != null and not Element.requirements and Element.buyable %}
						<span class="tag tag--info tooltip" data-tooltip-content="{{ LNG.sys_catchup_tooltip }}">{{ LNG.format('sys_catchup_short', Element.factor) }} %</span>
					{% endif %}
				{% endset %}

				{% set canBuild = false %}
				{% set note %}
					{% if vacation %}
						<span class="reason">{{ LNG.op_options_vacation_activated }}</span>
					{% elseif Element.requirements and not Element.blockedHere %}
						{# the requirement tags above say what is missing #}
					{% elseif atMax %}
						<span class="reason">{{ LNG.bd_maxlevel }}</span>
					{% elseif blocked %}{# no lab here, or only this planet's buildings are missing #}
						{# researchable elsewhere in the account, not from this planet (no lab, or the lab level is too low) #}
						<span class="reason reason--blocked">{{ icon('lock') }}{% if hasLab %}{{ LNG.bd_needs }} ({{ LNG.bd_on_this_planet }}): {{ Element.requirements|filter(r => r.own < r.count)|map((r, id) => LNG.tech[id] ~ ' ' ~ r.count)|join(', ') }}{% else %}{{ LNG.bd_no_lab_here }}{% endif %}</span>
					{% elseif IsLabinBuild %}
						<span class="reason">{{ LNG.sys_buildlist_fail }}</span>
					{% elseif IsFullQueue %}
						<span class="reason">{{ LNG.bd_researclist_full }}</span>
					{% elseif not Element.buyable %}
						{{ b.missing(Element) }}
					{% else %}
						{% set canBuild = true %}
					{% endif %}
				{% endset %}

				{% set action %}
					{% if canBuild %}
						<form action="{{ path('game_research_command') }}" method="post" class="build_form">
							<input type="hidden" name="cmd" value="insert">
							<input type="hidden" name="tech" value="{{ ID }}">
							<button type="submit" class="colorPositive build_submit">{{ label }}</button>
						</form>
					{% elseif not atMax %}
						{{ b.locked(label) }}
					{% endif %}
				{% endset %}

				{{ b.card(ID, Element, {
					domId: 't' ~ ID,
					index: loop.index0,
					locked: Element.fade,
					queued: queued,
					level: Element.level,
					levelTo: Element.levelToBuild,
					maxLevel: Element.maxLevel,
					watch: watch_toggle,
					extra: extra,
					costs: not atMax,
					note: note,
					time: not atMax,
					done: (not atMax and umode == 0) ? baseEnd + Element.elementTime : null,
					action: action,
					cls: blocked ? 'is-blocked' : null,
				}) }}
			{% endif %}
		{% endfor %}
	</div>
  {{ tooltip_templates() }}
{% endblock %}
{% block script %}{{ parent() }}
	{% if Queue %}
		<script type="module" src="./scripts/game/research.js"></script>
	{% endif %}
{% endblock %}
