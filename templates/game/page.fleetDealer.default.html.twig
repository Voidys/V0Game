{% import '_macros/ui.html.twig' as ui -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_fleettrader }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.lm_fleettrader, 'arrow-left-right') }}{% endblock %}
{% block content %}
<form action="{{ path('game_fleet_dealer_send') }}" method="post">
	<input type="hidden" name="mode" value="send">
	<section class="panel">
		{{ ui.panel_head(LNG.ft_head) }}
		<div class="panel__body">
				<p class="hint">{{ LNG.format('ft_rate_info', Charge) }}</p>
				<div class="fleet-dealer-grid">
					<div class="transparent text-left"><img id="img" alt=""></div>
					<div class="fleet-dealer-body">
						<p class="fleet-dealer-pick">
							<select name="shipID" id="shipID" data-on-change="trader-update" aria-label="{{ LNG.ft_head }}">
								{% for shipID in shipIDs %}
								<option value="{{ shipID }}">{{ LNG.tech[shipID] }}</option>
								{% endfor %}
							</select>
						</p>
						<p>
							{{ LNG.ft_per_ship }}:
							{{ LNG.tech[901] }}: <span id="metal" class="bold"></span> &bull;
							{{ LNG.tech[902] }}: <span id="crystal" class="bold"></span> &bull;
							{{ LNG.tech[903] }}: <span id="deuterium" class="bold"></span>
						</p>
						<p>
							{{ LNG.ft_count }}:
							<span class="control-group">
								<input type="text" id="count" name="count" data-on-keyup="trader-total" class="num" inputmode="numeric" autocomplete="off">
								<button data-action="trader-max">{{ LNG.ft_max }}</button>
							</span>
						</p>
						<p class="fleet-dealer-total">
							{{ LNG.ft_receive }}:
							{{ LNG.tech[901] }}: <span id="total_metal" class="bold colorPositive"></span> &bull;
							{{ LNG.tech[902] }}: <span id="total_crystal" class="bold colorPositive"></span> &bull;
							{{ LNG.tech[903] }}: <span id="total_deuterium" class="bold colorPositive"></span>
						</p>
						<p><input type="submit" id="trader-submit" value="{{ LNG.ft_absenden }}" disabled></p>
					</div>
				</div>
		</div>
	</section>
</form>
{% endblock %}
{% block script %}{{ parent() }}
{{ data_island('fleet-dealer-data', {costInfo: CostInfos, charge: Charge, shipImg: shipImg}) }}
<script type="module" src="./scripts/game/fleettrader.js?v={{ asset_version }}"></script>
{% endblock %}
