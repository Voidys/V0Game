{% import '_macros/ui.html.twig' as ui %}
{% extends layout_template %}
{% block title %}{{ LNG.lm_galaxy }}{{ parent() }}{% endblock %}
{% block pagehead %}
  {% set meta %}{{ LNG.ov_server_time }}: <span class="servertime">{{ servertime }}</span>{% endset %}
  {{ ui.page_head(LNG.lm_galaxy, 'galaxy', meta) }}
{% endblock %}
{% block content %}
  <form action="{{ path('game_galaxy_show') }}" method="get" id="galaxy_form" class="toolbar galaxy-toolbar">
    <input type="hidden" id="auto" value="dr">
    <div class="galaxy-toolbar__group">
      <span class="galaxy-nav__label">{{ LNG.gl_galaxy }}</span>
      <button type="button" name="galaxyLeft" class="galaxy-step" aria-label="{{ LNG.gl_galaxy }} -1" data-tip="{{ LNG.gl_galaxy }} -1" data-action="galaxy-submit" data-direction="galaxyLeft">{{ icon('chevron-left') }}</button>
      <input type="number" name="galaxy" value="{{ galaxy }}" maxlength="3" tabindex="1" class="coord" aria-label="{{ LNG.gl_galaxy }}">
      <button type="button" name="galaxyRight" class="galaxy-step" aria-label="{{ LNG.gl_galaxy }} +1" data-tip="{{ LNG.gl_galaxy }} +1" data-action="galaxy-submit" data-direction="galaxyRight">{{ icon('chevron-right') }}</button>
    </div>
    <div class="galaxy-toolbar__group">
      <span class="galaxy-nav__label">{{ LNG.gl_solar_system }}</span>
      <button type="button" name="systemLeft" class="galaxy-step" aria-label="{{ LNG.gl_solar_system }} -1" data-tip="{{ LNG.gl_solar_system }} -1" data-action="galaxy-submit" data-direction="systemLeft">{{ icon('chevron-left') }}</button>
      <input type="number" name="system" value="{{ system }}" maxlength="3" tabindex="2" class="coord" aria-label="{{ LNG.gl_solar_system }}">
      <button type="button" name="systemRight" class="galaxy-step" aria-label="{{ LNG.gl_solar_system }} +1" data-tip="{{ LNG.gl_solar_system }} +1" data-action="galaxy-submit" data-direction="systemRight">{{ icon('chevron-right') }}</button>
    </div>
    <input type="submit" value="{{ LNG.gl_show }}">
    <input type="button" value="{{ LNG.gl_sync }}" id="gala_sync">
    <span class="toolbar__spacer"></span>
    <span class="galaxy-toolbar__keys">{{ LNG.gl_keys_hint }}</span>
  </form>
  <div id="galaxy-filters" class="toolbar galaxy-filters" role="group" aria-label="{{ LNG.gl_flt_title }}">
    <span class="galaxy-nav__label">{{ icon('filter') }} {{ LNG.gl_flt_title }}</span>
    <label class="galaxy-check"><input type="checkbox" data-filter="inactive"> {{ LNG.gl_flt_inactive }}</label>
    <label class="galaxy-check"><input type="checkbox" data-filter="range"> {{ LNG.gl_flt_range }}</label>
    <label class="galaxy-check"><input type="checkbox" data-filter="moon"> {{ LNG.gl_flt_moon }}</label>
    <label class="galaxy-check"><input type="checkbox" data-filter="hideVacation"> {{ LNG.gl_flt_hide_vacation }}</label>
    <label class="galaxy-check">{{ LNG.gl_flt_debris }} <input type="number" min="0" step="1000" class="galaxy-debris-min" data-filter="debris" aria-label="{{ LNG.gl_flt_debris }}"></label>
    <button type="button" data-action="galaxy-filter-reset">{{ LNG.gl_flt_reset }}</button>
    <span class="galaxy-filters__sep"></span>
    <label class="galaxy-check"><input type="checkbox" data-filter="hlMine"> {{ LNG.gl_hl_mine }}</label>
    <label class="galaxy-check"><input type="checkbox" data-filter="hlBuddies"> {{ LNG.gl_hl_buddies }}</label>
    <button type="button" data-action="galaxy-marks-clear">{{ LNG.gl_hl_clear }}</button>
  </div>
  <div id="galaxy-status" class="textForBlind" role="status" aria-live="polite"></div>
  {% include 'game/galaxy.system.html.twig' %}

  <div class="panel galaxy-status" hidden id="fleetstatusrow">
  </div>

  {{ data_island('galaxy-data', {
    maxFleetSetting: settings_fleetactions,
    planetLng: LNG['bonus']['Planets'],
    moonShortLng: LNG['type_planet_short_3'],
    confirmLng: LNG['delete_confirm_gala'],
    urls: {
      fleetAjax: path('game_fleet_ajax_show'),
      galaxy: path('game_galaxy_show'),
      rows: path('game_galaxy_rows')
    }
  }) }}
{% endblock %}
