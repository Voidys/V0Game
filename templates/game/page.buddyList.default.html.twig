{% extends layout_template %}
{% import '_macros/ui.html.twig' as ui %}
{% macro person(row) %}
	<td><a href="#" data-action="dialog-pm" data-id="{{ row.id }}">{{ row.username }}</a></td>
	<td>{% if row.ally_name %}<a href="{{ path('game_alliance_info', {id: row.ally_id}) }}">{{ row.ally_name }}</a>{% else %}-{% endif %}</td>
	<td class="ctr"><a class="mono" href="{{ path('game_galaxy_show', {galaxy: row.galaxy, system: row.system}) }}">[{{ row.galaxy }}:{{ row.system }}:{{ row.planet }}]</a></td>
{% endmacro %}
{% block title %}{{ LNG.lm_buddylist }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.bu_buddy_list, 'heart', myBuddyList|length ~ ' ' ~ LNG.bu_partners) }}{% endblock %}
{% block content %}
{% if otherRequestList %}
<section class="panel panel--flush">
	{{ ui.panel_head(LNG.bu_requests, otherRequestList|length) }}
	<table class="data">
		<thead><tr>
			<th>{{ LNG.bu_player }}</th>
			<th>{{ LNG.bu_alliance }}</th>
			<th class="ctr">{{ LNG.bu_coords }}</th>
			<th>{{ LNG.bu_text }}</th>
			<th class="ctr">{{ LNG.bu_action }}</th>
		</tr></thead>
		<tbody>
		{% for otherRequestID, otherRequestRow in otherRequestList %}
		<tr>
			{{ _self.person(otherRequestRow) }}
			<td>{{ otherRequestRow.text }}</td>
			<td class="act"><a class="btn btn-sm" data-method="post" href="{{ path('game_buddy_list_accept', {id: otherRequestID}) }}" title="{{ LNG.bu_accept }}">{{ icon('check', LNG.bu_accept) }}</a> <a class="btn btn-sm" data-method="post" href="{{ path('game_buddy_list_delete', {id: otherRequestID}) }}" title="{{ LNG.bu_decline }}">{{ icon('x', LNG.bu_decline) }}</a></td>
		</tr>
		{% endfor %}
		</tbody>
	</table>
</section>
{% endif %}
{% if myRequestList %}
<section class="panel panel--flush">
	{{ ui.panel_head(LNG.bu_my_requests, myRequestList|length) }}
	<table class="data">
		<thead><tr>
			<th>{{ LNG.bu_player }}</th>
			<th>{{ LNG.bu_alliance }}</th>
			<th class="ctr">{{ LNG.bu_coords }}</th>
			<th>{{ LNG.bu_text }}</th>
			<th class="ctr">{{ LNG.bu_action }}</th>
		</tr></thead>
		<tbody>
		{% for myRequestID, myRequestRow in myRequestList %}
		<tr>
			{{ _self.person(myRequestRow) }}
			<td>{{ myRequestRow.text }}</td>
			<td class="act"><a class="btn btn-sm" data-method="post" href="{{ path('game_buddy_list_delete', {id: myRequestID}) }}" title="{{ LNG.bu_cancel_request }}">{{ icon('x', LNG.bu_cancel_request) }}</a></td>
		</tr>
		{% endfor %}
		</tbody>
	</table>
</section>
{% endif %}
<section class="panel panel--flush">
	{{ ui.panel_head(LNG.bu_partners, myBuddyList|length) }}
	{% if myBuddyList %}
	<table class="data">
		<thead><tr>
			<th>{{ LNG.bu_player }}</th>
			<th>{{ LNG.bu_alliance }}</th>
			<th class="ctr">{{ LNG.bu_coords }}</th>
			<th class="ctr">{{ LNG.bu_online }}</th>
			<th class="ctr">{{ LNG.bu_action }}</th>
		</tr></thead>
		<tbody>
		{% for myBuddyID, myBuddyRow in myBuddyList %}
		<tr>
			{{ _self.person(myBuddyRow) }}
			<td class="ctr">
			{% if myBuddyRow.onlinetime < 4 %}
			<span class="tag tag--pos">{{ LNG.bu_connected }}</span>
			{% elseif myBuddyRow.onlinetime >= 4 and myBuddyRow.onlinetime <= 15 %}
			<span class="tag tag--warn">{{ myBuddyRow.onlinetime }} {{ LNG.bu_minutes }}</span>
			{% else %}
			<span class="tag tag--neg">{{ LNG.bu_disconnected }}</span>
			{% endif %}
			</td>
			<td class="act"><a class="btn btn-sm" data-method="post" href="{{ path('game_buddy_list_delete', {id: myBuddyID}) }}" title="{{ LNG.bu_delete }}">{{ icon('trash-2', LNG.bu_delete) }}</a></td>
		</tr>
		{% endfor %}
		</tbody>
	</table>
	{% else %}
	<p class="empty">{{ LNG.bu_no_buddys }}</p>
	{% endif %}
</section>
{% endblock %}
