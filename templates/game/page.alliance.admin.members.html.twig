{% import '_macros/forms.html.twig' as forms -%}
{% import '_macros/ui.html.twig' as ui %}
{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block pagehead %}
{% set actions %}<a class="btn" href="{{ path('game_alliance_admin') }}">{{ icon('arrow-left') }} {{ LNG.al_back }}</a>{% endset %}
{{ ui.page_head(LNG.al_manage_members, 'users', al_users_list, actions) }}
{% endblock %}
{% block content %}
<form class="panel panel--flush" action="{{ path('game_alliance_admin_rank') }}" method="post">
	<table class="data" id="memberList" data-sortable>
		<thead>
		<tr>
			<th class="no-sort ctr">{{ LNG.al_num }}</th>
			<th>{{ LNG.al_member }}</th>
			<th class="ctr">{{ LNG.al_message }}</th>
			<th class="no-sort">{{ LNG.al_position }}</th>
			<th class="num">{{ LNG.al_points }}</th>
			<th class="ctr">{{ LNG.al_coords }}</th>
			<th>{{ LNG.al_member_since }}</th>
			<th class="ctr">{{ LNG.al_estate }}</th>
			<th class="no-sort ctr">{{ LNG.al_actions }}</th>
		</tr>
		</thead>
		<tbody>
		{% for userID, memberListRow in memberList %}
			<tr>
				<td class="ctr">{{ loop.index }}</td>
				<td><a href="#" data-action="dialog-playercard" data-id="{{ userID }}">{{ memberListRow.username }}</a> {% if memberListRow.class %}{% for class in memberListRow.class %}{% if not loop.first %}&nbsp;{% endif %}<span class="galaxy-short-{{ class }} galaxy-short">{{ ShortStatus[class] }}</span>{% endfor %}{% endif %}</td>
				<td class="ctr"><a href="#" data-action="dialog-pm" data-id="{{ userID }}" title="{{ LNG.write_message|e('html_attr') }}">{{ icon('mail', LNG.write_message) }}</a></td>
				<td>{% if memberListRow.rankID == -1 %}{{ founder }}{% elseif rankSelectList %}{{ forms.html_options({'class': "rankSelect", 'name': "rank[#{userID}]", 'options': rankSelectList, 'selected': memberListRow.rankID}) }}{% else %}{{ rankList[memberListRow.rankID] }}{% endif %}</td>
				<td class="num" data-sort="{{ memberListRow.points }}"><span title="{{ pretty_number(memberListRow.points) }}">{{ shortly_number(memberListRow.points) }}</span></td>
				<td class="ctr mono" data-sort="{{ memberListRow.galaxy * 1000000 + memberListRow.system * 1000 + memberListRow.planet }}"><a href="{{ path('game_galaxy_show', {galaxy: memberListRow.galaxy, system: memberListRow.system}) }}">[{{ memberListRow.galaxy }}:{{ memberListRow.system }}:{{ memberListRow.planet }}]</a></td>
				<td class="registerTime mono" data-with-time data-sort="{{ memberListRow.register_time }}" data-time="{{ memberListRow.register_time }}">{{ memberListRow.register_time }}</td>
				<td class="ctr">{% if rights.ONLINESTATE %}{% if memberListRow.onlinetime < 4 %}<span class="tag tag--pos">{{ LNG.al_memberlist_on }}</span>{% elseif memberListRow.onlinetime >= 4 and memberListRow.onlinetime <= 60 %}<span class="tag tag--warn">{{ memberListRow.onlinetime }} {{ LNG.al_memberlist_min }}</span>{% else %}<span class="tag tag--neg">{{ LNG.al_memberlist_off }}</span>{% endif %}{% else %}-{% endif %}</td>
				<td class="act">{% if memberListRow.rankID != -1 %}
						{% if canKick %}<a class="btn btn-sm member-kick" data-method="post" href="{{ path('game_alliance_admin_kick', {id: userID}) }}" data-confirm-danger data-confirm="{{ memberListRow.kickQuestion }}" title="{{ LNG.al_kick|e('html_attr') }}">{{ icon('trash-2', LNG.al_kick) }}</a>{% endif %}{% else %}-{% endif %}
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
</form>
{% endblock %}
