{# Shell helpers shared by the top bar and the Empire rail. #}
{% macro planet_src(image, style) -%}
  {%- if style == 1 -%}{{ theme_asset('planeten/varianten/v1_magic/' ~ image ~ '_v1_magic.webp') }}
  {%- elseif style == 2 -%}{{ theme_asset('planeten/varianten/v2_storm/' ~ image ~ '_v2_storm.webp') }}
  {%- elseif style == 3 -%}{{ theme_asset('planeten/varianten/v3_voronoi/' ~ image ~ '_v3_voronoi.webp') }}
  {%- else -%}{{ theme_asset('planeten/' ~ image ~ '.jpg') }}
  {%- endif -%}
{%- endmacro %}
{# planet/moon picture at `size` px: width variants (64w/128w) in srcset, the original as fallback #}
{% macro planet_img(image, style, size) -%}
  {%- set src = _self.planet_src(image, style)|trim -%}
  {%- set variants = theme_srcset(src) -%}
  <img src="{{ src }}"{% if variants %} srcset="{{ variants }}" sizes="{{ size }}px"{% endif %} width="{{ size }}" height="{{ size }}" alt="">
{%- endmacro %}
