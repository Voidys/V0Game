{% extends layout_template %}
{% import 'game/macros.buildcard.html.twig' as b %}
{% import '_macros/ui.html.twig' as ui %}
{% block title %}{% if mode == "defense" %}{{ LNG.lm_defenses }}{% else %}{{ LNG.lm_shipshard }}{% endif %}{{ parent() }}{% endblock %}
{% block pagehead %}
	{% set pname = b.planetname(planetList|default([]))|trim %}
	{{ b.pagehead(mode == 'defense' ? LNG.lm_defenses : LNG.lm_shipshard, mode == 'defense' ? 'shield' : 'rocket', pname ?: null) }}
{% endblock %}
{% block content %}
	{% if not hasShipyard %}<div class="infobox">{{ icon('rocket') }}<span>{{ LNG.bd_shipyard_required }}</span></div>{% endif %}

	{% if not NotBuilding %}
		<div class="infobox">{{ icon('triangle-alert') }}<span>{{ LNG.bd_building_shipyard }}</span></div>
	{% endif %}

	{% if BuildList %}
		<section class="panel">
			{{ ui.panel_head(LNG.ui_queue) }}
			{% if umode == 0 %}
				<div class="panel__body stack stack--tight ship-queue">
					<div id="bx" class="z ship-queue__now"></div>
					<form action="{{ path('game_shipyard_order', {kind: mode == 'defense' ? 'defense' : 'shipyard'}) }}" method="post" data-keep-scroll class="ship ship-queue__form">
						<input type="hidden" name="action" value="delete">
						<select name="auftr[]" id="auftr" multiple class="shipl"><option>&nbsp;</option></select>
						<p class="hint">{{ LNG.bd_cancel_warning }}</p>
						<div class="form-actions"><input class="z" type="submit" value="{{ LNG.bd_cancel_send }}"></div>
					</form>
					<span id="timeleft" data-umode="{{ umode }}"></span>
					<span id="queue-done" class="build-queue__total" data-template="{{ LNG.ui_queue_done }}"></span>
				</div>
			{% else %}
				<div class="panel__body stack stack--tight ship-queue">
					<div id="bxumode" class="zumode ship-queue__now"></div>
					<form action="{{ path('game_shipyard_order', {kind: mode == 'defense' ? 'defense' : 'shipyard'}) }}" method="post" class="shipumode ship-queue__form">
						<input type="hidden" name="action" value="delete">
						<select name="auftrumode[]" id="auftrumode" multiple class="shipl"><option>&nbsp;</option></select>
						<div class="form-actions"><input class="z" value="{{ LNG['bd_paused'] }}" readonly></div>
					</form>
					<span id="timeleft" data-umode="{{ umode }}"></span>
				</div>
			{% endif %}
		</section>
	{% endif %}

	{% if mode == "fleet" %}
		{% if hangarFiltersEnabled %}
		<div class="toolbar" id="hangar-filters" data-save-url="{{ path('game_shipyard_save_filters', {ajax: 1}) }}">
			{% set hangarHasButton = false %}
			{% if hangarGroupCivil %}{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}<button type="button" class="hangar-group-filter" id="ship1" data-filter-selector="{{ civil }}">{{ LNG.fm_civil }}</button>{% set hangarHasButton = true %}{% endif %}
			{% if hangarGroupMilitary %}{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}<button type="button" class="hangar-group-filter" id="ship2" data-filter-selector="{{ military }}">{{ LNG.fm_military }}</button>{% set hangarHasButton = true %}{% endif %}
			{% if hangarGroupRecycler %}{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}<button type="button" class="hangar-group-filter" id="ship4" data-filter-selector="{{ recycler }}">{{ LNG.fm_recycler }}</button>{% set hangarHasButton = true %}{% endif %}
			{% if hangarGroupAll %}{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}<button type="button" class="hangar-group-filter selected" id="ship3">{{ LNG.fm_all }}</button>{% set hangarHasButton = true %}{% endif %}
			{% for shipId in hangarShipIds %}
				{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}
				<button type="button" class="hangar-ship-filter" id="ship-{{ shipId }}" data-ship-id="{{ shipId }}">{{ LNG.shortNames[shipId] }} <span class="hangar-filter-remove" data-ship-id="{{ shipId }}">×</span></button>
				{% set hangarHasButton = true %}
			{% endfor %}
			{% if hangarHasButton %}<span class="hangar-filter-sep"> | </span>{% endif %}
			<span class="hangar-filter-add-wrap">
				<button type="button" id="hangar-filter-add" title="{{ LNG.fm_add_filter }}">+</button>
				<div id="hangar-filter-menu" class="hangar-filter-menu" hidden data-ship-order="{{ hangarShipOrder|json_encode }}">
					{% for shipId, shipName in hangarShipOptions %}
						<button type="button" class="hangar-filter-option" data-ship-id="{{ shipId }}">{{ shipName }}</button>
					{% endfor %}
				</div>
			</span>
		</div>
		{% else %}
		<div class="toolbar">
			<span class="segmented" role="group"><button id="ship1" data-action="filter-rows" data-filter-group="ship" data-hide=".infos" data-show="{{ civil }}">{{ LNG.fm_civil }}</button><button id="ship2" data-action="filter-rows" data-filter-group="ship" data-hide=".infos" data-show="{{ military }}">{{ LNG.fm_military }}</button><button id="ship3" class="selected" data-action="filter-rows" data-filter-group="ship" data-hide=".infos">{{ LNG.fm_all }}</button></span>
		</div>
		{% endif %}
	{% endif %}

	{% set kindUrl = path('game_shipyard_order', {kind: mode == 'defense' ? 'defense' : 'shipyard'}) %}
	<div class="build-grid" data-locked-label="{{ LNG.bd_locked_group }}">
	{% for ID, Element in elementList %}
		{% set sub %}<span id="val_{{ ID }}" class="card__owned">{% if Element.available != 0 %} ({{ LNG.bd_available }} {{ pretty_number(Element.available) }}){% endif %}</span>{% endset %}

		{% set extra %}
			{% if not Element.requirements %}<p class="hint">{{ LNG.bd_max_ships_long }}: <b>{{ pretty_number(Element.maxBuildable) }}</b></p>{% endif %}
			{% if ID==212 %}<span class="hint">+{{ SolarEnergy }} {{ LNG.tech[911] }}</span>{% endif %}
			<div class="card__time">{{ b.time(Element.elementTime) }}</div>
		{% endset %}

		{% set canBuild = false %}
		{% set note %}
			{% if vacation %}
				<span class="reason">{{ LNG.op_options_vacation_activated }}</span>
			{% elseif Element.requirements %}
				{# the requirement tags above say what is missing #}
			{% elseif Element.AlreadyBuild %}
				<span class="reason reason--bad">{{ LNG.bd_protection_shield_only_one }}</span>
			{% elseif not NotBuilding %}
				<span class="reason">{{ LNG.sys_buildlist_fail }}</span>
			{% elseif not Element.buyable %}
				{{ b.missing(Element) }}
			{% else %}
				{% set canBuild = true %}
			{% endif %}
		{% endset %}

		{% set action %}
			{% if canBuild %}
				<form action="{{ kindUrl }}" method="post" data-keep-scroll class="card__order" data-hangar-order data-owned="{{ Element.available }}" data-queued="{{ Element.queued }}" data-max="{{ Element.maxBuildable }}" data-unit-time="{{ Element.elementTime }}" data-cost="{{ Element.costResources|json_encode }}">
					<span class="control-group">
						<input type="number" name="fmenge[{{ ID }}]" id="input_{{ ID }}" maxlength="{{ maxlength }}" value="0" min="0" tabindex="{{ null }}" aria-label="{{ LNG.tech[ID] }}">
						<input type="button" value="{{ LNG.bd_max_ships }}" data-hangar-max title="{{ LNG.bd_max_ships_long }}: {{ pretty_number(Element.maxBuildable) }}">
					</span>
					<input class="b colorPositive" type="submit" value="{{ LNG.bd_build_ships }}">
					<label class="hint hangar-upto"><input type="checkbox" name="orderMode" value="upto" data-hangar-upto> {{ LNG.hq_upto }}</label>
					<p class="hint hangar-preview" data-hangar-preview hidden></p>
				</form>
			{% else %}
				{{ b.locked(LNG.bd_build_ships) }}
			{% endif %}
		{% endset %}

		{{ b.card(ID, Element, {
			domId: 's' ~ ID,
			index: loop.index0,
			cls: Element.requirements ? 'is-reqlocked' : '',
			locked: Element.fade,
			chip: '',
			sub: sub,
			extra: extra,
			note: note,
			time: false,
			action: action,
		}) }}
	{% endfor %}
	</div>
  {{ tooltip_templates() }}
{% endblock %}
{% block script %}{{ parent() }}
	{{ data_island('hangar-order-data', {
		queueTime: queueTimeLeft,
		umode: umode,
		names: {901: LNG.tech[901], 902: LNG.tech[902], 903: LNG.tech[903]},
		preview: LNG.hq_preview,
		current: LNG.hq_current
	}) }}
	<script type="module" src="./scripts/game/hangarOrder.js?v={{ asset_version }}"></script>
	{% if BuildList %}
	{{ data_island('shipyard-data', {data: BuildList, bdOperating: LNG.bd_operating, bdAvailable: LNG.bd_available}) }}
	<script type="module" src="./scripts/game/shipyard.js?v={{ asset_version }}"></script>
	{% endif %}
	<script type="module" src="./scripts/game/lockedFold.js?v={{ asset_version }}"></script>
	{% if mode == "fleet" and hangarFiltersEnabled %}
	<script type="module" src="./scripts/game/hangarFilter.js?v={{ asset_version }}"></script>
	{% endif %}
{% endblock %}
