	<section class="panel panel--flush tabs__panel" role="tabpanel" id="settings-panel-notify" aria-labelledby="settings-tab-notify" data-tab="notify" tabindex="0" hidden>
	{{ ui.panel_head(LNG.notif_section) }}
	<table class="form-table">
		<tbody>
				<tr>
					<th colspan="2">{{ LNG.notif_channels }}</th>
				</tr>
				<tr>
					<td>{{ LNG.notif_push_label }}</td>
					<td>
						<span class="control-group" data-push-box data-sw-url="{{ basepath }}sw.js" data-key-url="{{ path('game_push_key') }}" data-subscribe-url="{{ path('game_push_subscribe') }}" data-unsubscribe-url="{{ path('game_push_unsubscribe') }}"
							data-on="{{ LNG.notif_push_on|e('html_attr') }}" data-off="{{ LNG.notif_push_off|e('html_attr') }}" data-unsupported="{{ LNG.notif_push_unsupported|e('html_attr') }}" data-denied="{{ LNG.notif_push_denied|e('html_attr') }}" data-failed="{{ LNG.notif_push_failed|e('html_attr') }}">
							<button type="button" data-push-toggle data-enable="{{ LNG.notif_push_enable|e('html_attr') }}" data-disable="{{ LNG.notif_push_disable|e('html_attr') }}">{{ LNG.notif_push_enable }}</button>
							<span class="hint" data-push-status role="status"></span>
						</span>
					</td>
				</tr>
				<tr>
					<td><label for="set_notifyDiscordWebhook">{{ LNG.notif_discord_webhook }}</label></td>
					<td><input id="set_notifyDiscordWebhook" name="notifyDiscordWebhook" value="{{ notifyDiscordWebhook }}" type="url" maxlength="255" placeholder="https://discord.com/api/webhooks/..." autocomplete="off"></td>
				</tr>
				<tr>
					<td>{{ LNG.notif_test_label }}</td>
					<td>
						<span class="control-group" data-push-test-box data-url="{{ path('game_push_test') }}" data-sent="{{ LNG.notif_test_sent|e('html_attr') }}" data-none="{{ LNG.notif_test_none|e('html_attr') }}">
							<button type="button" data-push-test>{{ LNG.notif_test_button }}</button>
							<span class="hint" data-push-test-status role="status"></span>
						</span>
						<p class="hint">{{ LNG.notif_test_hint }}</p>
					</td>
				</tr>
				<tr>
					<th colspan="2">{{ LNG.notif_events }}</th>
				</tr>
{% for field, label in {notifyAttack: 'notif_pref_attack', notifySpy: 'notif_pref_spy', notifyFleetReturn: 'notif_pref_fleet_return', notifyQueueBuild: 'notif_pref_queue_build', notifyQueueResearch: 'notif_pref_queue_research', notifyQueueShipyard: 'notif_pref_queue_shipyard', notifyFarmAwake: 'notif_pref_farm_awake'} %}
				<tr>
					<td><label for="set_{{ field }}">{{ LNG[label] }}</label></td>
					<td><input id="set_{{ field }}" name="{{ field }}" type="checkbox" value="1" {% if notify[field] == 1 %}checked="checked" {% endif %}></td>
				</tr>
{% endfor %}
		</tbody>
	</table>
	</section>
	<div class="panel panel__foot settings-bar">
		<span class="hint">{{ LNG.op_save_hint }}</span>
		<strong class="settings-dirty" data-dirty-bar data-one="{{ LNG.op_unsaved_one|e('html_attr') }}" data-many="{{ LNG.op_unsaved_many|e('html_attr') }}" role="status" hidden><span data-dirty-count></span></strong>
		<input value="{{ LNG.op_save_changes }}" type="submit" class="btn--primary">
	</div>
	</form>
	<section class="panel tabs__panel" role="tabpanel" id="settings-panel-danger" aria-labelledby="settings-tab-danger" data-tab="danger" tabindex="0" hidden>
	{{ ui.panel_head(LNG.op_vacation_delete_mode) }}
	<div class="panel__body toolbar danger-zone" id="danger">
		<p class="hint">{{ LNG.notif_vac_min|format(vacationMinTime)|raw }} {{ LNG.notif_vac_earliest|format(vacationEarliestEnd)|raw }}</p>
		<form action="{{ path('game_settings_toggle_vacation') }}" method="post" class="control-group">
			<input name="vacation" type="submit" class="btn--danger" value="{{ LNG.op_activate_vacation_mode }}" data-confirm="{{ LNG.op_activate_vacation_mode_confirm|e('html_attr') }}"> <img src="./styles/resource/images/admin/i.webp" width="16" height="16" alt="" class="inline tooltip" data-tooltip-content="{{ LNG.op_activate_vacation_mode_descrip }}">
		</form>
		<form action="{{ path('game_settings_toggle_delete') }}" method="post" class="control-group">
			<input name="delete" type="submit" class="btn--danger" value="{% if delete %}{{ LNG.op_stop_dlte_account }}{% else %}{{ LNG.op_dlte_account }}{% endif %}"{% if not delete %} data-confirm-danger data-confirm="{{ LNG.op_dlte_account_confirm|e('html_attr') }}"{% endif %} > <img src="./styles/resource/images/admin/i.webp" width="16" height="16" alt="" class="inline tooltip" data-tooltip-content="{{ LNG.op_dlte_account_descrip }}">
		</form>
	</div>
</section>
	</div>
{% endblock %}
