<script type="module" src="./scripts/app/tabs.js?v={{ asset_version }}"></script>
<script type="module" src="./scripts/game/settings.js?v={{ asset_version }}"></script>
<script type="module" src="./scripts/app/push.js?v={{ asset_version }}"></script>
{% endblock %}
