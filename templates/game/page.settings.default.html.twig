{% import '_macros/forms.html.twig' as forms -%}
{% import '_macros/community.html.twig' as c -%}
{% import '_macros/ui.html.twig' as ui -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_options }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.lm_options, 'settings') }}{% endblock %}
{% block content %}
	<div class="tabs settings-tabs stack" data-tabs="settings">
	<div class="tabs__list segmented" role="tablist" aria-label="{{ LNG.lm_options|e('html_attr') }}">
		<button type="button" class="tabs__tab" role="tab" id="settings-tab-account" data-tab="account" aria-controls="settings-panel-account" aria-selected="true" tabindex="0">{{ LNG.op_user_data }}</button>
		<button type="button" class="tabs__tab" role="tab" id="settings-tab-general" data-tab="general" aria-controls="settings-panel-general" aria-selected="false" tabindex="-1">{{ LNG.op_general_settings }}</button>
		<button type="button" class="tabs__tab" role="tab" id="settings-tab-build" data-tab="build" aria-controls="settings-panel-build" aria-selected="false" tabindex="-1">{{ LNG.op_build_pages }}</button>
		<button type="button" class="tabs__tab" role="tab" id="settings-tab-galaxy" data-tab="galaxy" aria-controls="settings-panel-galaxy" aria-selected="false" tabindex="-1">{{ LNG.op_galaxy_settings }}</button>
		<button type="button" class="tabs__tab" role="tab" id="settings-tab-colors" data-tab="colors" aria-controls="settings-panel-colors" aria-selected="false" tabindex="-1">{{ LNG.own_colors }}</button>
		<button type="button" class="tabs__tab" role="tab" id="settings-tab-fleet" data-tab="fleet" aria-controls="settings-panel-fleet" aria-selected="false" tabindex="-1">{{ LNG.fleetPrio }}</button>
		<button type="button" class="tabs__tab" role="tab" id="settings-tab-notify" data-tab="notify" aria-controls="settings-panel-notify" aria-selected="false" tabindex="-1">{{ LNG.notif_section }}</button>
		<button type="button" class="tabs__tab tabs__tab--danger" role="tab" id="settings-tab-danger" data-tab="danger" aria-controls="settings-panel-danger" aria-selected="false" tabindex="-1">{{ LNG.op_vacation_delete_mode }}</button>
	</div>
	<form id="settings-form" class="stack" action="{{ path('game_settings_send') }}" method="post">
	<section class="panel panel--flush tabs__panel" role="tabpanel" id="settings-panel-account" aria-labelledby="settings-tab-account" data-tab="account" tabindex="0">
	{{ ui.panel_head(LNG.op_user_data) }}
	<table class="form-table">
		<tbody>
				{% if userAuthlevel > 0 %}
					<tr>
						<th colspan="2">{{ LNG.op_admin_title_options }}</th>
					</tr>
					<tr>
						<td><label for="set_adminprotection">{{ LNG.op_admin_planets_protection }}</label></td>
						<td><input id="set_adminprotection" name="adminprotection" type="checkbox" value="1" {% if adminProtection > 0 %}checked="checked" {% endif %}></td>
					</tr>
				{% endif %}
				<tr>
					<td><label for="set_username">{{ LNG.op_username }}</label></td>
					<td>{% if changeNickTime < 0 %}<input id="set_username" name="username" value="{{ username }}" type="text" maxlength="32">{% else %}{{ username }}{% endif %}</td>
				</tr>
				<tr>
					<td colspan="2"><a href="{{ path('game_api_show') }}">{{ icon('key-round') }} {{ LNG.api_title }}</a></td>
				</tr>
				{% if userAuthlevel > 0 %}
					<tr>
						<th colspan="2" id="sec-notify">{{ LNG.op_notifications }}</th>
					</tr>
					<tr>
						<td><label for="set_discord_id">{{ LNG.op_admin_discord_id }}</label></td>
						<td><input id="set_discord_id" name="discord_id" value="{{ discord_id }}" type="text" maxlength="25"></td>
					</tr>
					<tr>
						<td><label for="set_discord_hook">{{ LNG.op_admin_discord_hook }}</label></td>
						<td><input id="set_discord_hook" name="discord_hook" value="{{ discord_hook }}" type="text" maxlength="150"></td>
					</tr>
				{% endif %}
		</tbody>
	</table>
	</section>
	<section class="panel panel--flush tabs__panel" role="tabpanel" id="settings-panel-general" aria-labelledby="settings-tab-general" data-tab="general" tabindex="0" hidden>
	{{ ui.panel_head(LNG.op_general_settings) }}
	<table class="form-table">
		<tbody>
				<tr>
					<td><label for="set_timezone">{{ LNG.op_timezone }}</label></td>
					<td>{{ forms.html_options({'id': 'set_timezone', 'name': 'timezone', 'options': Selectors.timezones, 'selected': timezone}) }}</td>
				</tr>
				{% if Selectors.lang|length > 1 %}
					<tr>
						<td><label for="set_language">{{ LNG.op_lang }}</label></td>
						<td>{{ forms.html_options({'id': 'set_language', 'name': 'language', 'options': Selectors.lang, 'selected': userLang}) }}</td>
					</tr>
				{% endif %}
				<tr>
					<td><label for="set_decimalSeparator">{{ LNG.op_decimal_separator }}</label></td>
					<td>{{ forms.html_options({'id': 'set_decimalSeparator', 'name': 'decimalSeparator', 'options': Selectors.decimalSeparators, 'selected': decimalSeparator}) }}</td>
				</tr>
				<tr>
					<td><label for="set_numberFormat">{{ LNG.notif_numfmt_label }}</label></td>
					<td>{{ forms.html_options({'id': 'set_numberFormat', 'name': 'numberFormat', 'options': Selectors.numberFormats, 'selected': numberFormat}) }}</td>
				</tr>
				<tr>
					<td><label for="set_planetSort">{{ LNG.op_sort_planets_by }}</label></td>
					<td>{{ forms.html_options({'id': 'set_planetSort', 'name': 'planetSort', 'options': Selectors.Sort, 'selected': planetSort}) }}</td>
				</tr>
				<tr>
					<td><label for="set_planetOrder">{{ LNG.op_sort_kind }}</label></td>
					<td>
						{{ forms.html_options({'id': 'set_planetOrder', 'name': 'planetOrder', 'options': Selectors.SortUpDown, 'selected': planetOrder}) }}
					</td>
				</tr>
				{% if (Selectors.ImageSkins|default([]))|length > 1 %}
					<tr>
						<td>{{ LNG.op_skin_example }} (IMG)</td>
						<td>{{ forms.html_options({'options': Selectors.ImageSkins, 'selected': imageTheme, 'name': "imageTheme", 'id': "imageTheme"}) }}</td>
					</tr>
				{% endif %}
				{% if (Selectors.CssSkins|default([]))|length > 1 %}
					<tr>
						<td>{{ LNG.op_skin_example }} (CSS)</td>
						<td>{{ forms.html_options({'options': Selectors.CssSkins, 'selected': cssTheme, 'name': "cssTheme", 'id': "cssTheme"}) }} <img class="theme-preview" id="theme-preview" src="./styles/theme/{{ cssTheme|e('url') }}/preview.png" data-base="./styles/theme/" alt="" width="200" height="125" loading="lazy" hidden></td>
					</tr>
				{% endif %}
				<tr>
					<td><label for="set_noob_interface">{{ LNG.op_noob_interface }}</label></td>
					<td><input id="set_noob_interface" name="noob_interface" type="checkbox" value="1" {% if noobInterface == 1 %}checked="checked"{% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_enablePlanetStyles">{{ LNG.op_enable_planet_styles }}</label></td>
					<td><input id="set_enablePlanetStyles" name="enablePlanetStyles" type="checkbox" value="1" {% if enablePlanetStyles == 1 %}checked="checked"{% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_showMessageCategory">{{ LNG.op_show_message_category }}</label></td>
					<td><input id="set_showMessageCategory" name="showMessageCategory" type="checkbox" value="1" {% if showMessageCategory == 1 %}checked="checked"{% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_queueMessages">{{ LNG.op_active_build_messages }}</label></td>
					<td><input id="set_queueMessages" name="queueMessages" type="checkbox" value="1" {% if queueMessages == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_spyMessagesMode">{{ LNG.op_active_spy_messages_mode }}</label></td>
					<td><input id="set_spyMessagesMode" name="spyMessagesMode" type="checkbox" value="1" {% if spyMessagesMode == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_spyReportsCollapsed">{{ LNG.op_collapse_spy_reports }}</label></td>
					<td><input id="set_spyReportsCollapsed" name="spyReportsCollapsed" type="checkbox" value="1" {% if spyReportsCollapsed == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_blockPM">{{ LNG.op_block_pm }}</label></td>
					<td><input id="set_blockPM" name="blockPM" type="checkbox" value="1" {% if blockPM == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_recordsOptIn">{{ LNG.recordsOptIn }}</label></td>
					<td><input id="set_recordsOptIn" name="recordsOptIn" type="checkbox" value="1" {% if recordsOptIn == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_colonyWarn">{{ LNG.colonyWarn }}</label></td>
					<td><input id="set_colonyWarn" name="colonyWarn" type="checkbox" value="1" {% if colonyWarn == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_messagesPerPage">{{ LNG.messagesPerPage }}</label></td>
					<td><input id="set_messagesPerPage" name="messagesPerPage" value="{{ messagesPerPage }}" type="number" min="3" max="50"></td>
				</tr>

		</tbody>
	</table>
	</section>
	<section class="panel panel--flush tabs__panel" role="tabpanel" id="settings-panel-build" aria-labelledby="settings-tab-build" data-tab="build" tabindex="0" hidden>
	{{ ui.panel_head(LNG.op_build_pages) }}
	<table class="form-table">
		<tbody>
				<tr>
					<td><label for="set_missing_requirements_opacity">{{ LNG.op_missing_requirements_opacity }}</label></td>
					<td><input id="set_missing_requirements_opacity" name="missing_requirements_opacity" type="checkbox" value="1" {% if missing_requirements_opacity == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_missing_resources_opacity">{{ LNG.op_missing_resources_opacity }}</label></td>
					<td><input id="set_missing_resources_opacity" name="missing_resources_opacity" type="checkbox" value="1" {% if missing_resources_opacity == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_hide_useless">{{ LNG.op_hide_useless }}</label></td>
					<td><input id="set_hide_useless" name="hide_useless" type="checkbox" value="1" {% if hide_useless == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_hangarFiltersEnabled">{{ LNG.op_hangar_filters }}</label></td>
					<td><input id="set_hangarFiltersEnabled" name="hangarFiltersEnabled" type="checkbox" value="1" {% if hangarFiltersEnabled == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td>{{ LNG.op_hangar_group_filters }}</td>
					<td>
						<label><input name="hangarFilterCivil" type="checkbox" value="1" {% if hangarGroupCivil %}checked="checked" {% endif %}> {{ LNG.fm_civil }}</label>
						<label><input name="hangarFilterMilitary" type="checkbox" value="1" {% if hangarGroupMilitary %}checked="checked" {% endif %}> {{ LNG.fm_military }}</label>
						<label><input name="hangarFilterRecycler" type="checkbox" value="1" {% if hangarGroupRecycler %}checked="checked" {% endif %}> {{ LNG.fm_recycler }}</label>
						<label><input name="hangarFilterAll" type="checkbox" value="1" {% if hangarGroupAll %}checked="checked" {% endif %}> {{ LNG.fm_all }}</label>
					</td>
				</tr>
				
		</tbody>
	</table>
	</section>
	<section class="panel panel--flush tabs__panel" role="tabpanel" id="settings-panel-galaxy" aria-labelledby="settings-tab-galaxy" data-tab="galaxy" tabindex="0" hidden>
	{{ ui.panel_head(LNG.op_galaxy_settings) }}
	<table class="form-table">
		<tbody>
				<tr>
					<td><label for="set_spycount"><a title="{{ LNG.op_spy_probes_number_descrip }}">{{ LNG.op_spy_probes_number }}</a></label></td>
					<td><input id="set_spycount" name="spycount" value="{{ spycount }}" type="number"></td>
				</tr>
				<tr>
					<td><label for="set_fleetactions">{{ LNG.op_max_fleets_messages }}</label></td>
					<td><input id="set_fleetactions" name="fleetactions" maxlength="2" value="{{ fleetActions }}" type="number"></td>
				</tr>

				<tr>
					<th>{{ LNG.op_shortcut }}</th>
					<th>{{ LNG.op_show }}</th>
				</tr>
				<tr>
					<td><label for="set_galaxySpy">{{ icon('scan-eye') }} {{ LNG.op_spy }}</label></td>
					<td><input id="set_galaxySpy" name="galaxySpy" type="checkbox" value="1" {% if galaxySpy == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_galaxySpyReport"><img class="inline" src="{{ theme_asset('img/spy_report.png') }}" alt="">{{ LNG.op_spy_report }}</label></td>
					<td><input id="set_galaxySpyReport" name="galaxySpyReport" type="checkbox" value="1" {% if galaxySpyReport == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_spyReportFreshHours"><a title="{{ LNG.op_spy_report_fresh_time_tooltip }}">{{ LNG.op_spy_report_fresh_time }}</a></label></td>
					<td><input id="set_spyReportFreshHours" name="spyReportFreshHours" value="{{ spyReportFreshHours }}" type="number"> {{ LNG.fl_hours }}</td>
				</tr>
				<tr>
					<td><label for="set_spyReportRecentHours"><a title="{{ LNG.op_spy_report_recent_time_tooltip }}">{{ LNG.op_spy_report_recent_time }}</a></label></td>
					<td><input id="set_spyReportRecentHours" name="spyReportRecentHours" value="{{ spyReportRecentHours }}" type="number"> {{ LNG.fl_hours }}</td>
				</tr>
				<tr>
					<td><label for="set_galaxyMessage">{{ icon('mail') }} {{ LNG.op_write_message }}</label></td>
					<td><input id="set_galaxyMessage" name="galaxyMessage" type="checkbox" value="1" {% if galaxyMessage == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_galaxyBuddyList">{{ icon('user-plus') }} {{ LNG.op_add_to_buddy_list }}</label></td>
					<td><input id="set_galaxyBuddyList" name="galaxyBuddyList" type="checkbox" value="1" {% if galaxyBuddyList == 1 %}checked="checked" {% endif %}></td>
				</tr>
				<tr>
					<td><label for="set_galaxyMissle">{{ icon('crosshair') }} {{ LNG.op_missile_attack }}</label></td>
					<td><input id="set_galaxyMissle" name="galaxyMissle" type="checkbox" value="1" {% if galaxyMissle == 1 %}checked="checked" {% endif %}></td>
				</tr>

		</tbody>
	</table>
	</section>
