{# Document shell of the game area: head (styles, globals, modules) and the body block the layouts fill. #}
<!DOCTYPE html>
<html lang="{{ html_lang(lang) }}" data-dialog-ok="{{ LNG.dialog_ok }}" data-dialog-cancel="{{ LNG.dialog_cancel }}">
<head>
  <meta charset="utf-8">
  {# pages live at /game/<page>: relative URLs (assets, ./, game/...) keep resolving against the universe directory #}
  <base href="{{ basepath }}{{ app.request.attributes.get('uni') }}">
  {{ csrf_meta() }}
  <title>{% block title %} - {{ uni_name }} - {{ game_name }}{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {# versions all ES modules by mtime (imported modules carry no ?v=): App\\Twig\\GameExtension::importMap #}
  {{ import_map() }}
  {# the static import tree of the entry modules, fetched in parallel instead of one import level per round trip #}
  {% set preloadEntries = ['app/main.js'] %}
  {% if chatEnabled|default(false) %}{% set preloadEntries = preloadEntries|merge(['game/chat.js']) %}{% endif %}
  {% for scriptname in scripts %}{% if not (scriptname starts with '../') %}{% set preloadEntries = preloadEntries|merge(['game/' ~ scriptname]) %}{% endif %}{% endfor %}
  {{ module_preload(preloadEntries) }}
  <meta name="theme-color" content="#0a0d11">
  {% if goto %}
    <meta http-equiv="refresh" content="{{ gotoinsec }};URL={{ goto }}">
  {% endif %}
  {% include 'shared/icons.html.twig' with {p: './'} only %}
  {# the wordmark font is used by every page (top bar): fetch it with the CSS instead of after the first layout #}
  <link rel="preload" href="./styles/resource/fonts/michroma/michroma-eu.woff2" as="font" type="font/woff2" crossorigin>

  {# cascade layers (declared in base.css): reset, base, contract, theme, legacy.content, components, pages,
     theme-extras, utilities; game.css (shell) stays unlayered. A theme only sets --theme-* tokens. #}
  <link rel="stylesheet" href="./styles/resource/css/app/base.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/theme-contract.css?v={{ asset_version }}">
  <link rel="stylesheet" href="{{ themeCssPath }}?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/rte.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/content.css?v={{ asset_version }}">
  {# strict layout ruleset, then tables/forms and app components (all layer "components") #}
  <link rel="stylesheet" href="./styles/resource/css/app/ui.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/tables-forms.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/components.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/community.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/relics.css?v={{ asset_version }}">
  <link rel="stylesheet" href="./styles/resource/css/app/overlays.css?v={{ asset_version }}">
  {# page groups (layer "pages"), one file per group of pages #}
  {% for pageCss in ['overview', 'build', 'galaxy-fleet', 'messages-alliance', 'misc'] %}
  <link rel="stylesheet" href="./styles/resource/css/app/pages/{{ pageCss }}.css?v={{ asset_version }}">
  {% endfor %}
  <link rel="stylesheet" href="./styles/resource/css/app/game.css?v={{ asset_version }}">
  {% if chatEnabled|default(false) %}<link rel="stylesheet" href="./styles/resource/css/app/chat.css?v={{ asset_version }}">{% endif %}
  {# the player's signal colours win over theme and base styles. A colour still at its factory default is not
     emitted as a custom property: the theme may set --signal-* itself (fallbacks = the factory values) #}
  {% set sigPos = signalColors.colorPositive|default('') %}
  {% set sigNeg = signalColors.colorNegative|default('') %}
  {% set sigNeu = signalColors.colorNeutral|default('') %}
  <style>
    {% if sigPos and sigPos|lower != '#00ff00' or sigNeg and sigNeg|lower != '#ff0000' or sigNeu and sigNeu|lower != '#ffd600' %}:root {
      {% if sigPos and sigPos|lower != '#00ff00' %}--signal-positive: {{ sigPos }};{% endif %}
      {% if sigNeg and sigNeg|lower != '#ff0000' %}--signal-negative: {{ sigNeg }};{% endif %}
      {% if sigNeu and sigNeu|lower != '#ffd600' %}--signal-neutral: {{ sigNeu }};{% endif %}
    }{% endif %}
    .colorPositive { color: var(--signal-positive-local, var(--signal-positive, var(--theme-pos))); }
    .colorNegative { color: var(--signal-negative-local, var(--signal-negative, var(--theme-neg))) !important; }
    .colorNeutral { color: var(--signal-neutral-local, var(--signal-neutral, var(--theme-warn))); }
  </style>

  {# server clock, language strings and flags for scripts/app/env.js (JSON, not executed: no inline script) #}
  {{ data_island('game-env', {
    offset: Offset|default(0),
    date: date,
    dateMs: dateMs|default(0),
    ready: LNG.ready,
    skin: dpath,
    lang: lang,
    headInfo: LNG.fcm_info,
    auth: authlevel|default(0),
    days: LNG.week_day|default([]),
    months: LNG.months|default([]),
    timezone: TIMEZONESTRING,
    serverTimezone: game_config('timezone'),
    tdformat: LNG.js_tdformat,
    urls: {
      information: path('game_information_show', {id: 0}),
      planetActions: path('game_overview_actions'),
    },
    isPlayerCardActive: isPlayerCardActive,
    decimalSeparator: decimalSeparator,
    numberSuffixes: numberSuffixes,
    viewShortlyNumber: shortlyNumber,
    vacation: vmode,
    debug: debug == 1,
    ui: {
      palette_placeholder: LNG.ui_palette_placeholder,
      palette_empty: LNG.ui_palette_empty,
      palette_pages: LNG.ui_palette_pages,
      palette_planets: LNG.ui_palette_planets,
      palette_go: LNG.ui_palette_go,
      palette_galaxy: LNG.ui_palette_galaxy,
      shortcuts_title: LNG.ui_shortcuts_title,
      shortcuts_palette: LNG.ui_shortcuts_palette,
      shortcuts_go_overview: LNG.ui_shortcuts_go_overview,
      shortcuts_go_empire: LNG.ui_shortcuts_go_empire,
      shortcuts_go_buildings: LNG.ui_shortcuts_go_buildings,
      shortcuts_go_research: LNG.ui_shortcuts_go_research,
      shortcuts_go_shipyard: LNG.ui_shortcuts_go_shipyard,
      shortcuts_go_galaxy: LNG.ui_shortcuts_go_galaxy,
      shortcuts_go_fleet: LNG.ui_shortcuts_go_fleet,
      shortcuts_go_messages: LNG.ui_shortcuts_go_messages,
      shortcuts_planets: LNG.ui_shortcuts_planets,
      shortcuts_help: LNG.ui_shortcuts_help
    }
  }) }}

  {# URLs the shared scripts (app/dialog.js, app/ui.js) open or post to: routes rendered here instead of built in JS #}
  {{ data_island('game-routes', {
    messageWrite: path('game_messages_write'),
    messageForward: path('game_messages_forward'),
    playerCard: path('game_player_card_show'),
    buddyRequest: path('game_buddy_list_request'),
    clientReport: path('game_report_show')
  }) }}

  <script type="module" src="./scripts/app/main.js?v={{ asset_version }}"></script>
  {% if chatEnabled|default(false) %}<script type="module" src="./scripts/game/chat.js?v={{ asset_version }}"></script>{% endif %}
  {# page scripts are ES modules; vendor libraries (../base/...) stay classic, deferred keeps the order #}
  {% for scriptname in scripts %}
    {% if scriptname starts with '../' %}
      <script defer src="./scripts/game/{{ scriptname }}?v={{ asset_version }}"></script>
    {% else %}
      <script type="module" src="./scripts/game/{{ scriptname }}?v={{ asset_version }}"></script>
    {% endif %}
  {% endfor %}

  {% block script %}{% endblock %}
</head>

<body id="{{ app.request.attributes.get('_page')|default(app.request.query.get('page'))|default('overview') }}" class="{% block bodyclass %}{% endblock %}">
{% block body %}{% endblock %}
</body>
</html>
