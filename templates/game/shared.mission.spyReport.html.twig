<div class="spyRaport">
	<div class="spyRaportHead" coords="{{ targetPlanet.galaxy }}:{{ targetPlanet.system }}:{{ targetPlanet.planet }}">
		<a href="game/galaxy/{{ targetPlanet.galaxy }}/{{ targetPlanet.system }}">{{ title }}</a>
	</div>
{% if tools %}
	{% set mission = targetPlanet.planet_type < 4 ? 1 : 20 %}
	{% set targetQuery = 'galaxy=' ~ targetPlanet.galaxy ~ '&planet=' ~ targetPlanet.planet ~ '&planettype=' ~ targetPlanet.planet_type %}
	<div class="spyRaportContainer spyTools">
		<div class="spyRaportContainerHead">{{ LNG.spy_tools_head }}</div>
		<div class="spyRaportContainerRow clearfix">
			<div class="spyRaportContainerCell">{{ LNG.spy_tools_loot }}</div>
			<div class="spyRaportContainerCell" title="{{ LNG.tech[901] }} {{ pretty_number(tools.loot.metal) }} / {{ LNG.tech[902] }} {{ pretty_number(tools.loot.crystal) }} / {{ LNG.tech[903] }} {{ pretty_number(tools.loot.deuterium) }}">{{ pretty_number(tools.lootTotal) }}</div>
			<div class="spyRaportContainerCell">{{ LNG.spy_tools_cargos }}</div>
			<div class="spyRaportContainerCell">{{ pretty_number(tools.small) }} {{ LNG.spy_small_transporter }}<br>{{ pretty_number(tools.large) }} {{ LNG.spy_large_transporter }}</div>
		</div>
		<div class="spyRaportContainerRow clearfix">
			<div class="spyRaportContainerCell">{{ LNG.spy_tools_fuel }}</div>
			<div class="spyRaportContainerCell">{{ pretty_number(tools.fuel) }}</div>
			<div class="spyRaportContainerCell">{{ LNG.spy_tools_net }}</div>
			<div class="spyRaportContainerCell {{ tools.net >= 0 ? 'colorPositive' : 'colorNegative' }}">{{ pretty_number(tools.net) }}</div>
		</div>
		<div class="spyRaportContainerRow clearfix">
			<div class="spyRaportContainerCell">{{ LNG.spy_tools_defense_value }}</div>
			<div class="spyRaportContainerCell">{{ pretty_number(tools.fleetValue + tools.defenseValue) }}</div>
			<div class="spyRaportContainerCell">{{ LNG.spy_tools_age }}</div>
			<div class="spyRaportContainerCell">{% if tools.age >= 86400 %}{{ tools.age // 86400 }}d {% endif %}{{ (tools.age % 86400) // 3600 }}h {{ (tools.age % 3600) // 60 }}m</div>
		</div>
		<div class="spyRaportContainerRow clearfix">
			<div class="spyRaportContainerCell spy-cell-half">
				<a class="button" href="{{ path('game_fleet_step1_show') }}?{{ targetQuery }}&amp;system={{ targetPlanet.system }}&amp;target_mission={{ mission }}&amp;ships=203:{{ tools.large }}">{{ icon('crosshair') }} {{ LNG.spy_tools_attack }}</a>
			</div>
			<div class="spyRaportContainerCell spy-cell-half">
				<a class="button" href="{{ path('game_fleet_step1_show') }}?{{ targetQuery }}&amp;system={{ targetPlanet.system }}&amp;target_mission={{ targetPlanet.planet_type < 4 ? 6 : 21 }}&amp;ships=210:{{ tools.spyShips }}">{{ LNG.spy_tools_respy }}</a>
			</div>
		</div>
		<div>{{ LNG.spy_tools_note }}</div>
	</div>
{% endif %}
    {% if stbEnabled %}
		<div class="spyRaportContainer" name="scavengeruwu">
			<div class="spyRaportContainerHead">
				{{ LNG.spy_summary }}
			</div>
			<div class="spyRaportContainerRow clearfix">
				<div class="spyRaportContainerCell 35">
					{{ LNG.spy_total_resources }}
				</div>
				<div class="spyRaportContainerCell 15" name="totalRes"></div>
				<div class="spyRaportContainerCell {{ dangerClass }}">
					{{ LNG.spy_hazard_potential }}
				</div>
				<div class="spyRaportContainerCell {{ dangerClass }}" name="dangerValue">
          			{{ pretty_number(danger) }}
				</div>
			</div>
			<div class="spyRaportContainerRow clearfix">
				<div class="spyRaportContainerCell">
					{{ LNG.spy_potential_resources }}
				</div>
				<div class="spyRaportContainerCell" name="resToRaid"></div>
				<div class="spyRaportContainerCell">
					{{ LNG.spy_potential_recycling }}
				</div>
				<div class="spyRaportContainerCell" name="resToRec"></div>
			</div>
			<div class="spyRaportContainerRow clearfix">
				<div class="spyRaportContainerCell" >
					{{ LNG.spy_necessary_transporters }}
				</div>
				<div class="spyRaportContainerCell" >
					{{ pretty_number(smallCargoNeeded) }} {{ LNG.spy_small_transporter }}  <br>
          			{{ pretty_number(largeCargoNeeded) }} {{ LNG.spy_large_transporter }}
				</div>
				<div class="spyRaportContainerCell" >
					{{ LNG.spy_necessary_recycler }}
				</div>
				<div class="spyRaportContainerCell" name="recNeeded"></div>
			</div>
			<div class="spyRaportContainerRow clearfix">
				<div class="spyRaportContainerCell" classadd="marketClass" >
					{{ LNG.spy_market_value }}
				</div>
				<div class="spyRaportContainerCell" name="marketValue" classadd="marketClass"></div>
				<div class="spyRaportContainerCell {{ energyClass }}" >
					{{ LNG.spy_energy }}
				</div>
				<div class="spyRaportContainerCell {{ energyClass }}" name="energyValue">
					{{ pretty_number(energy) }}
				</div>
			</div>
			<div class="spyRaportContainerRow clearfix">
				<div class="spyRaportContainerCell" classadd="timePerResClass">
					{{ LNG.spy_best_resources_per_second }}
				</div>
				<div class="spyRaportContainerCell" name="resPerSec" classadd="timePerResClass"></div>
				<div class="spyRaportContainerCell" >
					{{ LNG.spy_best_planet }}
				</div>
				<div class="spyRaportContainerCell" name="bestPlanet"></div>
			</div>
			<div class="spyRaportContainerRow clearfix">
				<div class="spyRaportContainerCell spy-cell-half {{ dangerClass }}">
					<a href="game/fleet?galaxy={{ targetPlanet.galaxy }}&amp;system={{ targetPlanet.system }}&amp;planet={{ targetPlanet.planet }}&amp;planettype={{ targetPlanet.planet_type }}&amp;target_mission=1&#35;ship_input[202]={{ smallCargoNeeded }}" target="_blank">
						<button type="button">
              				⚔️ {{ pretty_number(smallCargoNeeded) }} {{ LNG.spy_small_transporter }} ⚔️
						</button>
					</a>
				</div>
				<div class="spyRaportContainerCell spy-cell-half {{ dangerClass }}">
					<a href="game/fleet?galaxy={{ targetPlanet.galaxy }}&amp;system={{ targetPlanet.system }}&amp;planet={{ targetPlanet.planet }}&amp;planettype={{ targetPlanet.planet_type }}&amp;target_mission=1&#35;ship_input[203]={{ largeCargoNeeded }}" target="_blank">
						<button type="button">
              				⚔️ {{ pretty_number(largeCargoNeeded) }} {{ LNG.spy_large_transporter }} ⚔️
						</button>
					</a>
				</div>
			</div>
		</div>
	{% endif %}
	{% for Class, elementIDs in spyData %}
		<div class="spyRaportContainer">
    		<div class="spyRaportContainerHead spyRaportContainerHeadClass{{ Class }}">{{ LNG.tech[Class] }}</div>
			{% for elementID, amount in elementIDs %}
				{% if (loop.index % 2) == 1 %}
					<div class="spyRaportContainerRow clearfix">
				{% endif %}
				<div class="spyRaportContainerCell">
					<div class="lg:hidden">{{ LNG.tech[elementID] }}</div>
					<a href='#' data-action="dialog-info" data-id="{{ elementID }}" class='tooltip max-lg:hidden' data-tooltip-content="{{ include('game/tooltip.element.html.twig', {id: elementID})|e('html_attr') }}">{{ LNG.tech[elementID] }}</a>
				</div>
				<div class="spyRaportContainerCell" data-info="{{ Class }}_{{ elementID }}">
					{{ pretty_number(amount) }}{% if repair_order[elementID] is defined and repair_order[elementID] is not null %} <span class="colorPositive">(+ {{ repair_order[elementID] }})</span>{% endif %}
				</div>
				{% if (loop.index % 2) == 0 or loop.last %}</div>{% endif %}
			{% endfor %}
			{% if repair_order and Class == 200 %}
				<div><span class="colorPositive">(+ X)</span> {{ LNG.sys_mess_spy_repair_order }}</div>
			{% endif %}
  			<br>
		</div>
	{% endfor %}
	<div class="spyRaportFooter">
		<span class="spy-footer-note">{% if totalShipDefCount > 0 and targetChance >= spyChance %}<span class="colorNegative">{{ LNG.sys_mess_spy_destroyed }}</span>{% else %}{{ LNG.format('sys_mess_spy_lostproba', targetChance) }}{% endif %}</span>
		<span class="spy-footer-actions">
			<a class="button" href="game/fleet?galaxy={{ targetPlanet.galaxy }}&amp;system={{ targetPlanet.system }}&amp;planet={{ targetPlanet.planet }}&amp;planettype={{ targetPlanet.planet_type }}&amp;target_mission={{ targetPlanet.planet_type < 4 ? 1 : 20 }}">{% if targetPlanet.planet_type < 4 %}{{ LNG.type_mission_1 }}{% else %}{{ LNG.type_mission_20 }}{% endif %}</a>
			{% if isBattleSim %}<a class="button" target="_blank" href="game/simulator?{% for Class, elementIDs in spyData %}{% for elementID, amount in elementIDs %}im[{{ elementID }}]={{ amount|intval }}&amp;{% endfor %}{% endfor %}">{{ LNG.fl_simulate }}</a>{% endif %}
		</span>
	</div>
</div>
