{% macro sub(key) %}{% if key starts with 'expo_found' %}found{% elseif key starts with 'expo_lost' %}lost{% elseif key starts with 'expo_first' or key starts with 'first_' %}first{% else %}count{% endif %}{% endmacro %}
{% import '_macros/ui.html.twig' as ui -%}
{% extends layout_template %}
{% block title %}{{ LNG.advancedStats }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.advancedStats, 'activity', LNG.as_intro) }}{% endblock %}
{% block content %}
{% set groups = [
  {key: 'expo', label: LNG.expedition, rows: expo},
  {key: 'build', label: LNG.build, rows: build},
  {key: 'lost', label: LNG.lost, rows: lost},
  {key: 'destroyed', label: LNG.destroyed, rows: destroyed},
  {key: 'repaired', label: LNG.repaired, rows: repaired},
  {key: 'first', label: LNG.first, rows: first},
  {key: 'other', label: LNG.other, rows: rest},
] %}
<div class="tabs advanced-stats stack" data-tabs="advanced-stats">
  <div class="toolbar">
  <div class="tabs__list segmented" role="tablist" aria-label="{{ LNG.advancedStats }}">
    {% for group in groups %}
      <button type="button" class="tabs__tab" role="tab" id="as-tab-{{ group.key }}" data-tab="{{ group.key }}" aria-controls="as-panel-{{ group.key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? '0' : '-1' }}">{{ group.label }}</button>
    {% endfor %}
  </div>
  <span class="toolbar__spacer"></span>
  <label class="control-group"><input type="checkbox" id="as-show-empty"> {{ LNG.as_show_empty }}</label>
  </div>
  {% for group in groups %}
    <section class="panel panel--flush tabs__panel" role="tabpanel" id="as-panel-{{ group.key }}" aria-labelledby="as-tab-{{ group.key }}" data-tab="{{ group.key }}" tabindex="0"{% if not loop.first %} hidden{% endif %}>
      <table class="data advanced-stats__table">
        <tbody>
          {% set rowKeys = group.rows|keys %}
          {% for elementID, elementRow in group.rows %}
            {% if group.key == 'expo' %}{% set subNow = _self.sub(elementID)|trim %}{% if loop.first or subNow != _self.sub(rowKeys[loop.index0 - 1])|trim %}<tr class="sub-head"><th colspan="2">{{ attribute(LNG, 'as_sub_' ~ subNow) }}</th></tr>{% endif %}{% endif %}
            <tr id="{{ elementID }}"{% if (elementRow.value|striptags|trim) in ['', '-', '0'] %} class="is-empty"{% endif %}>
              <td>{{ elementRow.text }}</td>
              <td class="num">{{ elementRow.value }}</td>
            </tr>
          {% else %}
            <tr><td colspan="2" class="ctr">-</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  {% endfor %}
</div>
<script type="module" src="./scripts/app/tabs.js?v={{ asset_version }}"></script>
{% endblock %}
