{% import '_macros/forms.html.twig' as forms -%}
{% import '_macros/ui.html.twig' as ui -%}
{% macro players(list, fallback, cls) %}{% if list %}<span class="{{ cls }}">{% for p in list %}{% if not loop.first %} &amp; {% endif %}<a href="#" data-action="dialog-playercard" data-id="{{ p.id }}">{{ p.name }}</a>{% endfor %}</span>{% else %}<span class="{{ cls }}">{{ fallback }}</span>{% endif %}{% endmacro %}
{% extends layout_template %}
{% block title %}{{ LNG.lm_topkb }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.tkb_top, 'trophy', LNG.tkb_gratz) }}{% endblock %}
{% block content %}
<form class="toolbar" name="stats" id="stats" method="get" action="{{ path('game_battle_hall_show') }}">
	<span class="control-group"><label for="memorial">{{ LNG.tkb_memorial }}</label><select name="memorial" id="memorial" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.memorial, 'selected': memorial}) }}</select></span>
	<span class="control-group"><label for="timeframe">{{ LNG.tkb_timeframe }}</label><select name="timeframe" id="timeframe" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.timeframe, 'selected': timeframe}) }}</select></span>
	<span class="control-group"><label for="diplomacy">{{ LNG.tkb_diplomacy }}</label><select name="diplomacy" id="diplomacy" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.diplomacy, 'selected': diplomacy}) }}</select></span>
	<span class="control-group"><label for="galaxy">{{ LNG.tkb_galaxy }}</label><select name="galaxy" id="galaxy" data-on-change="submit-form">{{ forms.html_options({'options': Selectors.galaxy, 'selected': galaxy}) }}</select></span>
	<noscript><button type="submit">{{ icon('filter') }}OK</button></noscript>
</form>
<section class="panel panel--flush">
	{% if TopKBList %}
	<table class="data">
		<thead>
			<tr>
				<th class="num">{{ LNG.tkb_platz }}</th>
				<th>{{ LNG.tkb_owners }}</th>
				<th>{{ LNG.tkb_datum }}</th>
				<th class="num">{{ LNG.tkb_units }}</th>
			</tr>
		</thead>
		<tbody>
			{% for row in TopKBList %}
				{% set attackerClass = row.result == 'a' ? 'colorPositive' : (row.result == 'r' ? 'colorNegative' : '') %}
				{% set defenderClass = row.result == 'a' ? 'colorNegative' : (row.result == 'r' ? 'colorPositive' : '') %}
				<tr>
					<td class="num">{% if loop.index <= 3 %}<span class="badge{% if loop.index == 1 %} badge--accent{% endif %}">{{ loop.index }}</span>{% else %}{{ loop.index }}{% endif %}</td>
					<td>
						<span class="battle-link">
							{{ _self.players(row.attackers, row.attacker, attackerClass) }}
							<a href="{{ path('game_raport_show', {raport: row.rid}) }}" target="_blank" rel="noopener" aria-label="{{ LNG.tkb_datum }}">{{ icon('swords', null, 'battle-link__vs') }}</a>
							{{ _self.players(row.defenders, row.defender, defenderClass) }}
						</span>
					</td>
					<td>{{ row.date }}</td>
					<td class="num">{{ pretty_number(row.units) }}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	<div class="panel__foot stats-legend">
		<span class="tag tag--pos">{{ LNG.tkb_gewinner|striptags|trim('-') }}</span>
		<span class="tag tag--neg">{{ LNG.tkb_verlierer|striptags|trim('-') }}</span>
		<span class="tag tag--muted">{{ LNG.tkb_unentschieden|striptags|trim('-') }}</span>
	</div>
	{% else %}
	<p class="empty">-</p>
	{% endif %}
</section>
{% endblock %}
