{% extends layout_template %}
{% import 'game/macros.buildcard.html.twig' as b %}
{% block title %}{{ LNG.lm_buildings }}{{ parent() }}{% endblock %}
{% block pagehead %}
  {% set pname = b.planetname(planetList|default([]))|trim %}
  {% set meta = (pname ? pname ~ ' · ' : '') ~ planet_field_current ~ ' / ' ~ planet_field_max ~ ' ' ~ LNG.ov_fields ~ (isCatchUp ? ' · ' ~ catchUp ~ ' %' : '') %}
  {{ b.pagehead(LNG.lm_buildings, 'building-2', meta) }}
{% endblock %}
{% block content %}
  {% include 'game/shared.buildqueue.html.twig' with {queuePage: 'buildings'} %}

  <div class="toolbar">
    <span class="segmented" role="group"><button id="btn1" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".prod">{{ LNG.fm_mining }}</button><button id="btn2" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".storage">{{ LNG.fm_storage }}</button><button id="btn3" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other" data-show=".other">{{ LNG.fm_other }}</button><button id="btn4" class="selected" data-action="filter-rows" data-filter-group="build" data-hide=".prod, .storage, .other">{{ LNG.fm_all }}</button></span>
  </div>

  {% set baseEnd = (umode == 0 and Queue) ? (Queue|last).endtime : ('now'|date('U')) %}
  <div class="build-grid">
    {% for ID, Element in BuildInfoList %}
      {% set atMax = Element.maxLevel == Element.levelToBuild %}
      {% set queued = Element.levelToBuild > Element.level %}
      {% set label = (Element.level == 0 and Element.levelToBuild == 0) ? LNG.bd_build : LNG.bd_build_next_level ~ (Element.levelToBuild + 1) %}

      {% set watch_toggle %}
        {% if ID == watch %}
          <a class="card__watch is-on" href="{{ path('game_buildings_show', {watch: 0}) }}" aria-label="{{ LNG.ui_unwatch }}" data-tip="{{ LNG.ui_unwatch }}">{{ icon('star') }}</a>
        {% else %}
          <a class="card__watch" href="{{ path('game_buildings_show', {watch: ID}) }}" aria-label="{{ LNG.ui_watch }}" data-tip="{{ LNG.ui_watch }}">{{ icon('star') }}</a>
        {% endif %}
      {% endset %}

      {% set extra %}
        {% if Element.infoEnergy and not Element.requirements %}
          <p class="hint">{{ LNG.bd_next_level }} {{ LNG.format(Element.infoEnergy.consumes ? 'bd_need_engine' : 'bd_more_engine', Element.infoEnergy.amount, LNG.tech[911]) }}</p>
        {% endif %}
        {% if Element.factor != null and not Element.requirements and Element.buyable %}
          <span class="tag tag--info tooltip" data-tooltip-content="{{ LNG.sys_catchup_tooltip }}">{{ LNG.format('sys_catchup_short', Element.factor) }} %</span>
        {% endif %}
      {% endset %}

      {% set canBuild = false %}
      {% set note %}
        {% if vacation %}
          <span class="reason">{{ LNG.op_options_vacation_activated }}</span>
        {% elseif Element.requirements %}
          {# the requirement tags above say what is missing #}
        {% elseif atMax %}
          <span class="reason">{{ LNG.bd_maxlevel }}</span>
        {% elseif not CanBuildElement %}
          <span class="reason">{{ LNG.bd_buildlist_full }}</span>
        {% elseif not RoomIsOk %}
          <span class="reason">{{ LNG.bd_no_more_fields }}</span>
        {% elseif not Element.buyable %}
          {{ b.missing(Element) }}
        {% elseif (isBusy.research and (ID == 6 or ID == 31)) or (isBusy.shipyard and (ID == 15 or ID == 21)) or (isBusy.repairdock and (ID == 35)) %}
          <span class="reason">{{ LNG.bd_working }}</span>
        {% else %}
          {% set canBuild = true %}
        {% endif %}
      {% endset %}

      {% set action %}
        {% if canBuild %}
          <form action="{{ path('game_buildings_command') }}" method="post" class="build_form">
            <input type="hidden" name="cmd" value="insert">
            <input type="hidden" name="building" value="{{ ID }}">
            <button type="submit" class="colorPositive build_submit">{{ label }}</button>
          </form>
        {% elseif not atMax %}
          {{ b.locked(label) }}
        {% endif %}
      {% endset %}

      {% set tools %}
        {% if Element.level > 0 %}
          {% if ID == 43 %}<a href="#" data-action="dialog-info" data-id="{{ ID }}">{{ LNG.bd_jump_gate_action }}</a>{% endif %}
          {% if ID == 34 %}<a href="{{ path('game_alliance_depot_show') }}">{{ LNG.bd_depot_action }}</a>{% endif %}
          {% if Element.destroyable %}{% set tt_destroy %}
          {# Start Destruction Popup #}
          <table class='tt-destroy'>
            <tr>
              <th colspan='2'>{{ LNG.bd_price_for_destroy }} {{ LNG.tech[ID] }} {{ Element.levelToDestroy }}</th>
            </tr>
            {% for ResType, ResCount in Element.destroyResources %}
            <tr>
              <td>{{ LNG.tech[ResType] }}</td>
              <td><span class='{% if not Element.destroyOverflow[ResType] %}colorPositive{% else %}colorNeutral{% endif %}'>{{ pretty_number(ResCount) }}</span></td>
            </tr>
            {% endfor %}
            <tr>
              <td>{{ LNG.bd_destroy_time }}</td>
              <td><span class='statictime' timestamp='{{ Element.destroyTime }}'></span></td>
            </tr>
            <tr>
              <td colspan='2'>
                <form action='{{ path('game_buildings_command') }}' method='post' class='build_form'>
                  <input type='hidden' name='cmd' value='destroy'>
                  <input type='hidden' name='building' value='{{ ID }}'>
                  <button type='submit' class='build_submit onlist'>{{ LNG.bd_dismantle }}</button>
                </form>
              </td>
            </tr>
          </table>
          {% endset %}<a class="tooltip_sticky build-meta__destroy" data-tooltip-forms {{ tooltip(tt_destroy) }}>{{ LNG.bd_dismantle }}</a>{% endif %}
        {% endif %}
      {% endset %}

      {{ b.card(ID, Element, {
        cls: Element.filterClass,
        index: loop.index0,
        locked: Element.fade,
        queued: queued,
        level: Element.level,
        levelTo: Element.levelToBuild,
        maxLevel: Element.maxLevel,
        watch: watch_toggle,
        extra: extra,
        costs: not atMax,
        note: note,
        tools: tools,
        time: not atMax,
        done: (not atMax and umode == 0) ? baseEnd + Element.elementTime : null,
        tz: TIMEZONESTRING,
        action: action,
      }) }}
    {% endfor %}
  </div>
  {{ tooltip_templates() }}
{% endblock %}
