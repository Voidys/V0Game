{% extends layout_template %}
{% import '_macros/ui.html.twig' as ui %}
{% block title %}{{ LNG.depot_title }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.depot_title, 'handshake') }}{% endblock %}
{% block content %}
  <section class="panel">
    <div class="panel__body stack">
      <p>{{ LNG.format('depot_intro', depotLevel, maxStay) }}</p>
      <div class="stats">
        <div class="stat"><span class="stat__label">{{ LNG.depot_deuterium_stock }}</span><span class="stat__value">{{ pretty_number(deuterium) }}</span></div>
      </div>
    </div>
  </section>
  <section class="panel panel--flush">
    {{ ui.panel_head(LNG.depot_title, fleets|length) }}
    {% if fleets is empty %}
      <p class="empty">{{ icon('handshake') }} {{ LNG.depot_empty }}</p>
    {% else %}
      <table class="data depot-table">
        <thead>
          <tr>
            <th>{{ LNG.depot_col_owner }}</th>
            <th>{{ LNG.depot_col_ships }}</th>
            <th>{{ LNG.depot_col_stay_end }}</th>
            <th class="num">{{ LNG.depot_col_hourly }}</th>
            <th>{{ LNG.depot_col_supply }}</th>
          </tr>
        </thead>
        <tbody>
          {% for fleet in fleets %}
            <tr>
              <td class="top">{{ fleet.username }}</td>
              <td class="top">
                {% for ship in fleet.ships %}
                  <a href="#" data-action="dialog-info" data-id="{{ ship.id }}">{{ LNG.tech[ship.id] }}</a>: <span class="mono">{{ pretty_number(ship.count) }}</span>{% if not loop.last %}<br>{% endif %}
                {% endfor %}
              </td>
              <td class="top">{{ fleet.stayEnd }}</td>
              <td class="num top">{{ pretty_number(fleet.hourlyCost) }}</td>
              <td class="top">
                {% if fleet.maxHours < 1 %}
                  <span class="tag tag--muted">{{ LNG.depot_full }}</span>
                {% else %}
                  <form action="{{ path('game_alliance_depot_supply') }}" method="post" class="depot-form" data-hourly="{{ fleet.hourlyCost }}">
                    <input type="hidden" name="fleet" value="{{ fleet.id }}">
                    <select name="hours" data-depot-hours>
                      {% for hour in 1..fleet.maxHours %}
                        <option value="{{ hour }}">{{ LNG.format('depot_hours', hour) }}</option>
                      {% endfor %}
                    </select>
                    <span class="depot-cost">{{ LNG.depot_cost }}: <span class="num" data-depot-cost>{{ pretty_number(fleet.hourlyCost) }}</span> {{ LNG.tech[903] }}</span>
                    <button type="submit" class="colorPositive btn-sm">{{ LNG.depot_supply }}</button>
                  </form>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </section>
{% endblock %}
