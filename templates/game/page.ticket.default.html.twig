{% import '_macros/community.html.twig' as c -%}
{% import '_macros/ui.html.twig' as ui %}
{% extends layout_template %}
{% block title %}{{ LNG.lm_support }}{{ parent() }}{% endblock %}
{% block pagehead %}
{% set actions %}<a class="btn btn--primary" href="{{ path('game_ticket_create') }}">{{ icon('plus') }} {{ LNG.ti_new }}</a>{% endset %}
{{ ui.page_head(LNG.lm_support, 'life-buoy', null, actions) }}
{% endblock %}
{% block content %}
<section class="panel panel--flush">
	{% if ticketList is not empty %}
	<table class="data">
		<thead><tr>
			<th class="num">{{ LNG.ti_id }}</th>
			<th>{{ LNG.ti_subject }}</th>
			<th class="num">{{ LNG.ti_answers }}</th>
			<th>{{ LNG.ti_date }}</th>
			<th class="ctr">{{ LNG.ti_status }}</th>
		</tr></thead>
		<tbody>
		{% for TicketID, TicketInfo in ticketList %}
		<tr>
			<td class="num"><a href="{{ path('game_ticket_view', {id: TicketID}) }}">#{{ TicketID }}</a></td>
			<td><a href="{{ path('game_ticket_view', {id: TicketID}) }}">{{ TicketInfo.subject }}</a></td>
			<td class="num">{{ TicketInfo.answer - 1 }}</td>
			<td class="mono">{{ TicketInfo.time }}</td>
			<td class="ctr">{% if TicketInfo.status == 0 %}<span class="tag tag--pos">{{ LNG.ti_status_open }}</span>{% elseif TicketInfo.status == 1 %}<span class="tag tag--warn">{{ LNG.ti_status_answer }}</span>{% else %}<span class="tag tag--neg">{{ LNG.ti_status_closed }}</span>{% endif %}</td>
		</tr>
		{% endfor %}
		</tbody>
	</table>
	{% else %}
	{% set faqLink %}<a href="{{ path('game_questions_show') }}">{{ LNG.lm_faq }}</a>{% endset %}
	<div class="empty">{{ icon('life-buoy') }}<p>{{ LNG.format('ti_none', faqLink) }}</p></div>
	{% endif %}
</section>
{% endblock %}
