{% extends layout_template %}
{% block title %}{{ pageTitle }}{{ parent() }}{% endblock %}
{% block content %}
{% import 'game/shared.mission.raport.macros.html.twig' as cr %}
{% set reduced = Info is defined and Info is not null %}
{% set lastRound = Raport.rounds|length - 1 %}

{# parties of the hero #}
{% set heroAttackers = [] %}
{% set heroDefenders = [] %}
{% if reduced %}
	{% set heroAttackers = [{name: Info[0]}] %}
	{% set heroDefenders = [{name: Info[1]}] %}
{% else %}
	{% for Player in Raport.rounds[0].attacker %}
		{% set PlayerInfo = Raport.players[Player.userID] %}
		{% set heroAttackers = heroAttackers|merge([{id: Player.userID, name: PlayerInfo.name, coords: '[' ~ PlayerInfo.koords[0] ~ ':' ~ PlayerInfo.koords[1] ~ ':' ~ PlayerInfo.koords[2] ~ ']' ~ (PlayerInfo.koords[3] is defined and PlayerInfo.koords[3] is not null ? ' (' ~ LNG["type_planet_short_#{PlayerInfo.koords[3]}"] ~ ')' : '')}]) %}
	{% endfor %}
	{% for Player in Raport.rounds[0].defender %}
		{% set PlayerInfo = Raport.players[Player.userID] %}
		{% set heroDefenders = heroDefenders|merge([{id: Player.userID, name: PlayerInfo.name, coords: '[' ~ PlayerInfo.koords[0] ~ ':' ~ PlayerInfo.koords[1] ~ ':' ~ PlayerInfo.koords[2] ~ ']' ~ (PlayerInfo.koords[3] is defined and PlayerInfo.koords[3] is not null ? ' (' ~ LNG["type_planet_short_#{PlayerInfo.koords[3]}"] ~ ')' : '')}]) %}
	{% endfor %}
{% endif %}

{# defence rebuild rows: repaired units against the defences that were destroyed in total (start minus end of the planet fleet) #}
{% set repairRows = [] %}
{% if Raport.repaired %}
	{% set lastDefender = Raport.rounds[0].defender|length - 1 %}
	{% for ShipID, ShipData in Raport.repaired %}
		{% set destroyed = (Raport.rounds[0].defender[lastDefender].ships[ShipID][0] ?? 0) - (Raport.rounds[lastRound].defender[lastDefender].ships[ShipID][0] ?? 0) %}
		{% set repairRows = repairRows|merge([{id: ShipID, units: ShipData.units, destroyed: destroyed, percent: ShipData.percent, left: destroyed - ShipData.units}]) %}
	{% endfor %}
{% endif %}

{% include 'game/shared.mission.raport.head.html.twig' %}
	{% include 'game/shared.mission.raport.extras.html.twig' %}

	<section class="cr-rounds" aria-labelledby="cr-rounds-title">
		<h2 class="cr-h" id="cr-rounds-title">{{ icon('activity') }}{{ LNG.cr_rounds }} <span class="cr-unit">{{ lastRound }}</span></h2>
		{% for Round, RoundInfo in Raport.rounds %}
		{% if not (reduced and Round > 0 and not loop.last) %}
		{% set sums = {attacker: 0, defender: 0} %}
		{% for side in ['attacker', 'defender'] %}
			{% set sum = 0 %}
			{% for Player in RoundInfo[side] %}{% for ShipData in Player.ships %}{% set sum = sum + ShipData[0] %}{% endfor %}{% endfor %}
			{% set sums = sums|merge({(side): sum}) %}
		{% endfor %}
		<details class="cr-round"{% if loop.first or loop.last %} open{% endif %}>
			<summary>{{ cr.round_title(Round == 0 ? LNG.cr_start : LNG.sys_attack_round ~ ' ' ~ Round, sums.attacker, sums.defender) }}</summary>
			<div class="cr-round__body">
				{% for side in ['attacker', 'defender'] %}
				<div class="cr-side cr-side--{{ side }}">
					{% for PlayerNr, Player in RoundInfo[side] %}
					{% set PlayerInfo = Raport.players[Player.userID] %}
					{% set startShips = Raport.rounds[0][side][PlayerNr].ships %}
					{% set alive = 0 %}
					{% for ShipData in Player.ships %}{% set alive = alive + ShipData[0] %}{% endfor %}
					<section class="cr-fleet">
						{{ cr.fleet_head(side, PlayerInfo.name, '[' ~ PlayerInfo.koords[0] ~ ':' ~ PlayerInfo.koords[1] ~ ':' ~ PlayerInfo.koords[2] ~ ']' ~ (PlayerInfo.koords[3] is defined and PlayerInfo.koords[3] is not null ? ' (' ~ LNG["type_planet_short_#{PlayerInfo.koords[3]}"] ~ ')' : ''), PlayerInfo.tech, reduced, Round > 0 and alive == 0, reduced ? 0 : Player.userID) }}
						<div class="cr-scroll">
							<table class="cr-table cr-ships">
								<thead>
									<tr>
										<th scope="col">{{ LNG.sys_ship_type }}</th>
										<th scope="col" class="num">{{ LNG.sys_ship_count }}</th>
										{% if Round > 0 %}<th scope="col" class="num">{{ LNG.cr_lost_total }}</th>{% endif %}
										{% if not reduced %}
										<th scope="col" class="num">{{ LNG.sys_ship_weapon }}</th>
										<th scope="col" class="num">{{ LNG.sys_ship_shield }}</th>
										<th scope="col" class="num">{{ LNG.sys_ship_armour }}</th>
										{% endif %}
									</tr>
								</thead>
								<tbody>
									{% for ShipID, StartData in startShips %}
									{% set ShipData = Player.ships[ShipID] ?? null %}
									{% set now = ShipData[0] ?? 0 %}
									{% set lost = StartData[0] - now %}
									<tr{% if Round > 0 and now == 0 %} class="is-gone"{% endif %}>
										<th scope="row">{{ LNG.shortNames[ShipID] }}</th>
										<td class="num"><span class="cr-count">{{ pretty_number(now) }}</span>{% if Round > 0 %}{{ cr.keep_bar(now, StartData[0]) }}{% endif %}</td>
										{% if Round > 0 %}<td class="num">{% if lost > 0 %}<span class="cr-loss">&minus;{{ pretty_number(lost) }}</span>{% else %}<span class="cr-none">0</span>{% endif %}</td>{% endif %}
										{% if not reduced %}
										<td class="num">{{ pretty_number(ShipData[1] ?? 0) }}</td>
										<td class="num">{{ pretty_number(ShipData[2] ?? 0) }}</td>
										<td class="num">{{ pretty_number(ShipData[3] ?? 0) }}</td>
										{% endif %}
									</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</section>
					{% endfor %}
				</div>
				{% endfor %}
			</div>
		</details>
		{% if not loop.last %}
		<div class="cr-exchange">
			<p class="cr-exchange__att">{{ icon('crosshair') }}<span>{{ LNG.fleet_attack_1 }} <strong>{{ pretty_number(RoundInfo.info[0]) }}</strong> {{ LNG.fleet_attack_2 }} <strong>{{ pretty_number(RoundInfo.info[3]) }}</strong> {{ LNG.damage }}</span></p>
			<p class="cr-exchange__def">{{ icon('shield') }}<span>{{ LNG.fleet_defs_1 }} <strong>{{ pretty_number(RoundInfo.info[2]) }}</strong> {{ LNG.fleet_defs_2 }} <strong>{{ pretty_number(RoundInfo.info[1]) }}</strong> {{ LNG.damage }}</span></p>
		</div>
		{% endif %}
		{% endif %}
		{% endfor %}
	</section>
</article>
{% endblock %}

{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/raportshare.js?v={{ asset_version }}"></script>
{% endblock %}
