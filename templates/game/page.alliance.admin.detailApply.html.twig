{% extends layout_template %}
{% import '_macros/ui.html.twig' as ui %}
{# lock marker for stats the applicant's espionage level hides #}
{% macro lock(text) %}<span title="{{ text|e('html_attr') }}">{{ icon('lock') }}</span> {% endmacro %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.format('al_request_from', name), 'user-plus', apply_time) }}{% endblock %}
{% block content %}
{% set pointRows = [
	[LNG.pl_builds, showBuild, LNG.spytech_playercard.level2, build_points, build_percent, build_rank],
	[LNG.pl_tech, showTech, LNG.spytech_playercard.level4, tech_points, tech_percent, tech_rank],
	[LNG.pl_fleet, showFleet, LNG.spytech_playercard.level6, fleet_points, fleet_percent, fleet_rank],
	[LNG.pl_def, showDef, LNG.spytech_playercard.level6, defs_points, defs_percent, defs_rank],
] %}
{% set lockText = LNG.spytech_playercard.level6 %}
{% set fightRows = [
	[LNG.pl_fightwon, wons, siegprozent ~ '%'],
	[LNG.pl_fightdraw, draws, drawsprozent ~ '%'],
	[LNG.pl_fightlose, loos, loosprozent ~ '%'],
	[LNG.pl_totalfight, totalfights, '100%'],
] %}
{% set destroyRows = [
	[playerdestory, [[LNG.pl_unitsshot, desunits], [LNG.pl_unitslose, lostunits], [LNG.pl_dermetal, kbmetal], [LNG.pl_dercrystal, kbcrystal]]],
	[realdestory, [[LNG.pl_unitsshot, realdesunits], [LNG.pl_unitslose, reallostunits], [LNG.pl_dermetal, realmetal], [LNG.pl_dercrystal, realcrystal]]],
] %}
<div class="grid-2">
	<div class="stack">
		<section class="panel panel--flush">
			{{ ui.panel_head(LNG.pl_points) }}
			<table class="data">
				<thead><tr>
					<th>&nbsp;</th>
					<th class="num">{{ LNG.pl_points }}</th>
					<th class="num">%</th>
					<th class="num">{{ LNG.pl_range }}</th>
				</tr></thead>
				<tbody>
				{% for row in pointRows %}
				<tr>
					<td>{% if not row[1] %}{{ _self.lock(row[2]) }}{% endif %}{{ row[0] }}</td>
					{% if row[1] %}
					<td class="num">{{ row[3] }}</td>
					<td class="num">{{ row[4] }}%</td>
					<td class="num">{{ row[5] }}</td>
					{% else %}
					<td class="num">-</td>
					<td colspan="2"></td>
					{% endif %}
				</tr>
				{% endfor %}
				<tr>
					<td><b>{{ LNG.pl_total }}</b></td>
					<td class="num">{{ total_points }}</td>
					<td class="num">100%</td>
					<td class="num">{{ total_rank }}</td>
				</tr>
				</tbody>
			</table>
		</section>
		<section class="panel panel--flush">
			{{ ui.panel_head(LNG.pl_fightstats) }}
			<table class="data">
				<thead><tr>
					<th>&nbsp;</th>
					<th class="num">{{ LNG.pl_fights }}</th>
					<th class="num">{{ LNG.pl_fprocent }}</th>
				</tr></thead>
				<tbody>
				{% for row in fightRows %}
				<tr>
					<td>{% if not showBattle %}{{ _self.lock(lockText) }}{% endif %}{{ row[0] }}</td>
					<td class="num">{% if showBattle %}{{ row[1] }}{% else %}-{% endif %}</td>
					<td class="num">{% if showBattle %}{{ row[2] }}{% endif %}</td>
				</tr>
				{% endfor %}
				{% for group in destroyRows %}
				<tr><th colspan="3">{{ group[0] }}:</th></tr>
				{% for row in group[1] %}
				<tr>
					<td>{% if not showBattle %}{{ _self.lock(lockText) }}{% endif %}{{ row[0] }}</td>
					<td class="num">{% if showBattle %}{{ row[1] }}{% else %}-{% endif %}</td>
					<td></td>
				</tr>
				{% endfor %}
				{% endfor %}
				</tbody>
			</table>
		</section>
	</div>
	<div class="stack">
		<section class="panel">
			{{ ui.panel_head(LNG.pl_name) }}
			<div class="panel__body">
				<dl class="kv">
					<dt>{{ LNG.pl_name }}</dt><dd>{{ name }}</dd>
					<dt>{{ LNG.pl_homeplanet }}</dt><dd>{{ homeplanet }} <a class="mono" href="{{ path('game_galaxy_show', {galaxy: galaxy, system: system}) }}">[{{ galaxy }}:{{ system }}:{{ planet }}]</a></dd>
					<dt>{{ LNG.al_request_register_time }}</dt><dd>{{ register_time }}</dd>
					<dt>{{ LNG.al_request_last_onlinetime }}</dt><dd>{{ onlinetime }}</dd>
				</dl>
			</div>
		</section>
		{% if applyDetail.text is not empty %}
		<section class="panel">
			{{ ui.panel_head(LNG.al_message) }}
			<div class="panel__body">{{ applyDetail.text }}</div>
		</section>
		{% endif %}
	</div>
</div>
<form class="panel" action="{{ path('game_alliance_admin_answer_apply', {id: applyDetail.applyID}) }}" method="post">
	{{ ui.panel_head(LNG.al_reply_to_request) }}
	<table class="form-table">
		<tr>
			<td colspan="2"><textarea name="text" rows="10" class="tinymce" id="message" aria-label="{{ LNG.al_reply_to_request|e('html_attr') }}"></textarea></td>
		</tr>
		<tr>
			<td colspan="2" class="form-actions"><input hidden name="answer"> <button value="yes" type="submit" class="btn--primary" data-action="set-field" data-field="answer">{{ LNG.al_acept_request }}</button> <button value="no" type="submit" class="btn--danger" data-action="set-field" data-field="answer">{{ LNG.al_decline_request }}</button></td>
		</tr>
	</table>
</form>
<script type="module" src="./scripts/game/alliance.js?v={{ asset_version }}"></script>
{% endblock %}
