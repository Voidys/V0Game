{% set count = productionTable.usedResource %}

<section class="panel panel--flush">
<div class="table-scroll">
<table class="data">
	<tbody>
				<tr>
					<th class="act">{{ LNG.in_level }}</th>
				{% if count > 1 %}
					{% for resourceID in productionTable.usedResource %}
					<th colspan="2" class="num">{{ LNG.tech[resourceID] }}</th>
					{% endfor %}
				</tr>
				<tr>
					<th>&nbsp;</th>
				{% endif %}
					{% for resourceID in productionTable.usedResource %}
					<th class="num">{{ LNG.in_storage }}</th>
					<th class="num">{{ LNG.in_difference }}</th>
					{% endfor %}
				</tr>
				{% for elementLevel, productionData in productionTable.storage %}
				<tr{% if CurrentLevel == elementLevel %} class="is-current"{% endif %}>
					<td class="act"><span class="mono">{{ elementLevel }}</span></td>
					{% for resourceID, storage in productionData %}
					{% set storageDiff = storage - (productionTable.storage[CurrentLevel][resourceID] ?? 0) %}
					<td class="num"><span class="{% if storage > 0 %}colorPositive{% elseif storage < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(storage) }}</span></td>
					<td class="num"><span class="{% if storageDiff > 0 %}colorPositive{% elseif storageDiff < 0 %}colorNegative{% else %}white{% endif %}">{{ pretty_number(storageDiff) }}</span></td>
					{% endfor %}
				</tr>
				{% endfor %}
	</tbody>
</table>
</div>
</section>