{% extends 'game/layout.base.html.twig' %}

{% block bodyclass %}layout layout--full{% endblock %}

{% block body %}
<a class="skip-link" href="#content">{{ LNG.ui_skip_to_content|default('Skip to content') }}</a>

<header class="topbar">
  {% include 'game/main.topnav.html.twig' %}
</header>

{% if hasAdminAccess or (noobInterface and tutorial) or hasRebuildProtection or uni_status == 1 or uni_status == 2 or delete or vacation %}
<div class="notices">
  {% if hasAdminAccess %}
    <div class="globalWarning">
      {{ icon('shield-alert') }}
      <span>{{ LNG.admin_access_1 }} <a id="drop-admin" href="#">{{ LNG.admin_access_link }}</a>{{ LNG.admin_access_2 }}</span>
    </div>
  {% endif %}
  {% if noobInterface and tutorial %}
    <div class="globalWarning globalWarning--info">
      {{ icon('info') }}
      <span>{{ LNG.noob_interface }}</span>
    </div>
  {% endif %}
  {% if hasRebuildProtection %}
    <div class="globalWarning">
      {{ icon('shield') }}
      <span>{{ LNG.rebuild_proteciton_mode }} <a id="drop-rebuild-protection" href="#" data-url="{{ path('game_rebuild_protection_ajax_show') }}">{{ LNG.rebuild_proteciton_link }}</a>
        <span class="countdown" data-time="{{ rebuildProtectionUntil }}"></span></span>
    </div>
  {% endif %}
  {% if uni_status == 1 or uni_status == 2 %}
    <div class="infobox">{{ icon('triangle-alert') }}<span>{{ LNG.ov_closed }}</span></div>
  {% elseif delete %}
    <div class="infobox">{{ icon('triangle-alert') }}<span>{{ delete }}</span></div>
  {% elseif vacation %}
    <div class="infobox infobox--info">{{ icon('moon') }}<span>{{ vacation }}</span></div>
  {% endif %}
</div>
{% endif %}

<div class="shell">
  <nav class="sidenav" id="sidebar" aria-label="{{ LNG.ui_menu|default('Menu') }}">
    {% include 'game/main.navigation.html.twig' %}
  </nav>

  <main class="content" id="content" tabindex="-1">
    {% if hostileAlert %}
      <details class="alert" open role="alert">
        <summary class="icon-btn alert__close" aria-label="{{ LNG.shell_attack_hide }}" data-tip="{{ LNG.shell_attack_hide }}">{{ icon('x') }}</summary>
        <div class="alert__body">
          {{ icon('triangle-alert') }}
          <p><strong>{{ LNG.shell_attack_title }} {{ hostileAlert.name }}</strong> <span class="mono">[{{ hostileAlert.galaxy }}:{{ hostileAlert.system }}:{{ hostileAlert.planet }}]</span> · {{ LNG.shell_attack_arrives }} <span class="countdown mono" data-time="{{ hostileAlert.remaining }}"></span></p>
          <div class="alert__actions">
            <a class="alert__btn alert__btn--solid" href="{{ path('game_fleet_table_show') }}">{{ icon('send') }}{{ LNG.shell_attack_fleet }}</a>
            <a class="alert__btn" href="{{ path('game_overview_show') }}">{{ LNG.shell_attack_details }}</a>
          </div>
        </div>
      </details>
    {% endif %}
    {% include 'game/main.sectiontabs.html.twig' %}
    {% block pagehead %}{% endblock %}
    {% block content %}{% endblock %}
  </main>

  <aside class="rail" aria-label="{{ LNG.ui_nav_empire|default('Empire') }}">
    {% include 'game/main.rail.html.twig' %}
  </aside>

  {# inside the shell grid: the side menu column runs the full height, so it stays put on short pages too #}
  <footer class="footer">
    {% include 'game/main.footer.html.twig' %}
  </footer>
</div>
<div class="sidebar-backdrop" aria-hidden="true"></div>
{% include 'game/main.tabbar.html.twig' %}
{% if chatEnabled %}{% include 'game/chat.widget.html.twig' %}{% endif %}
{# after the chat widget: the button's position follows .chat-fab / the open panel through sibling selectors (no body:has()) #}
<button type="button" class="scroll-top" data-scroll-top aria-label="{{ LNG.ui_scroll_top }}" title="{{ LNG.ui_scroll_top }}" hidden>
  {{ icon('chevron-up') }}
</button>

{% if loginNotice %}
  {# once per login (AbstractGameController::newMessagesNotice); the top bar badge keeps the count afterwards #}
  <div class="login-notice" role="status" data-login-notice>
    {{ icon('mail') }}
    <a class="login-notice__link" href="{{ loginNotice.url }}">{{ loginNotice.text }}</a>
    <button type="button" class="login-notice__close" data-login-notice-close aria-label="{{ LNG.ui_close }}">{{ icon('x') }}</button>
  </div>
{% endif %}

{% include 'shared/cookie_notice.html.twig' %}
{% endblock %}
