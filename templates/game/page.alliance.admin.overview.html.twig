{% import '_macros/forms.html.twig' as forms -%}
{% import '_macros/ui.html.twig' as ui %}
{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block pagehead %}
{% set actions %}<a class="btn" href="{{ path('game_alliance_show') }}">{{ icon('arrow-left') }} {{ LNG.al_back }}</a>{% endset %}
{{ ui.page_head(LNG.al_manage_alliance, 'settings', '[' ~ ally_tag ~ '] ' ~ ally_name, actions) }}
{% endblock %}
{% block content %}
{% if rights.RANKS or rights.MANAGEUSERS or rights.DIPLOMATIC %}
<section class="panel">
	{{ ui.panel_head(LNG.al_manage_alliance) }}
	<div class="panel__body">
		<div class="toolbar">
			{% if rights.RANKS %}<a class="btn" href="{{ path('game_alliance_admin_permissions') }}">{{ icon('shield-check') }} {{ LNG.al_manage_ranks }}</a>{% endif %}
			{% if rights.MANAGEUSERS %}<a class="btn" href="{{ path('game_alliance_admin_members') }}">{{ icon('users') }} {{ LNG.al_manage_members }}</a>{% endif %}
			{% if rights.DIPLOMATIC %}<a class="btn" href="{{ path('game_alliance_admin_diplomacy') }}">{{ icon('handshake') }} {{ LNG.al_manage_diplo }}</a>{% endif %}
		</div>
	</div>
</section>
{% endif %}
{% if rights.ADMIN %}
<form class="stack" action="{{ path('game_alliance_admin_send') }}" method="post">
<input type="hidden" name="textMode" value="{{ textMode }}">
<section class="panel">
	{{ ui.panel_head(LNG.al_texts) }}
	<div class="panel__body">
		<nav class="segmented" aria-label="{{ LNG.al_texts|e('html_attr') }}">
			<a href="{{ path('game_alliance_admin', {textMode: 'external'}) }}"{% if textMode == 'external' %} class="is-active" aria-current="page"{% endif %}>{{ LNG.al_outside_text }}</a>
			<a href="{{ path('game_alliance_admin', {textMode: 'internal'}) }}"{% if textMode == 'internal' %} class="is-active" aria-current="page"{% endif %}>{{ LNG.al_inside_text }}</a>
			<a href="{{ path('game_alliance_admin', {textMode: 'apply'}) }}"{% if textMode == 'apply' %} class="is-active" aria-current="page"{% endif %}>{{ LNG.al_request_text }}</a>
		</nav>
		<textarea name="text" id="text" aria-label="{{ LNG.al_texts }}" rows="15" {% if textMode == 'apply' %}maxlength="1000"{% endif %}>{{ text }}</textarea>
	</div>
	<footer class="panel__foot">
		<input type="reset" value="{{ LNG.al_circular_reset }}">
		<input type="submit" value="{{ LNG.al_save }}">
	</footer>
</section>
<p class="hint form-note">{{ LNG.al_save_all_hint }}</p>
<section class="panel">
{{ ui.panel_head(LNG.al_manage_options) }}
<table class="form-table">
	<tr>
		<td><label for="f_ally_tag">{{ LNG.al_tag }}</label></td>
		<td><input type="text" id="f_ally_tag" name="ally_tag" value="{{ ally_tag }}" maxlength="8" required></td>
	</tr>
	<tr>
		<td><label for="f_ally_name">{{ LNG.al_name }}</label></td>
		<td><input type="text" id="f_ally_name" name="ally_name" value="{{ ally_name }}" maxlength="30" required></td>
	</tr>
	<tr>
		<td><label for="f_owner_range">{{ LNG.al_manage_founder_rank }}</label></td>
		<td><input type="text" id="f_owner_range" name="owner_range" value="{{ ally_owner_range }}" maxlength="32"></td>
	</tr>
	<tr>
		<td><label for="f_web">{{ LNG.al_web_site }}</label></td>
		<td><input type="text" class="control-wide" id="f_web" name="web" value="{{ ally_web }}" maxlength="255"></td>
	</tr>
	<tr>
		<td><label for="f_image">{{ LNG.al_manage_image }}</label></td>
		<td><input type="text" class="control-wide" id="f_image" name="image" value="{{ ally_image }}" maxlength="255"></td>
	</tr>
	<tr>
		<td><label for="f_stats">{{ LNG.al_view_stats }}</label></td>
		<td>{{ forms.html_options({'id': 'f_stats', 'name': 'stats', 'options': YesNoSelector, 'selected': ally_stats_data}) }}</td>
	</tr>
	<tr>
		<td><label for="f_diplo">{{ LNG.al_view_diplo }}</label></td>
		<td>{{ forms.html_options({'id': 'f_diplo', 'name': 'diplo', 'options': YesNoSelector, 'selected': ally_diplo_data}) }}</td>
	</tr>
	<tr>
		<td><label for="f_request_notallow">{{ LNG.al_manage_requests }}</label></td>
		<td>{{ forms.html_options({'id': 'f_request_notallow', 'name': 'request_notallow', 'options': RequestSelector, 'selected': ally_request_notallow}) }}</td>
	</tr>
	<tr>
		<td><label for="f_ally_max_members">{{ LNG.al_set_max_members }}</label></td>
		<td>{{ ally_members }} / <input type="number" min="1" id="f_ally_max_members" name="ally_max_members" value="{{ ally_max_members }}"></td>
	</tr>
	<tr>
		<td><label for="f_request_min_points">{{ LNG.al_manage_request_min_points }}</label></td>
		<td><input type="number" min="0" id="f_request_min_points" name="request_min_points" value="{{ ally_request_min_points }}"></td>
	</tr>
	{% if isLeader and chatEnabled %}
	<tr>
		<td><label for="f_chat_slowmode">{{ LNG.al_chat_slowmode }}</label></td>
		<td>{{ forms.html_options({'id': 'f_chat_slowmode', 'name': 'chat_slowmode', 'options': chatSlowmodes, 'selected': ally_chat_slowmode}) }}<p class="hint">{{ LNG.al_chat_slowmode_info }}</p></td>
	</tr>
	{% endif %}
	<tr>
		<td colspan="2" class="form-actions">
			<input type="reset" value="{{ LNG.al_circular_reset }}">
			<input type="submit" value="{{ LNG.al_save }}">
		</td>
	</tr>
</table>
</section>
</form>
{% endif %}
{% if AllianceOwner %}
<section class="panel danger-zone">
	{{ ui.panel_head(LNG.al_disolve_alliance) }}
	<div class="panel__body">
		<p class="hint">{{ LNG.al_dissolve_hint }}</p>
		<form action="{{ path('game_alliance_admin_close') }}" method="post"><button type="submit" class="btn--danger" data-confirm-danger data-confirm="{{ (ally_name ~ ': ' ~ LNG.al_close_ally)|e('html_attr') }}">{{ icon('triangle-alert') }}{{ LNG.al_dissolve_btn }}</button></form>
	</div>
	{{ ui.panel_head(LNG.al_transfer_alliance) }}
	<div class="panel__body">
		<p class="hint">{{ LNG.al_transfer_hint }}</p>
		<form action="{{ path('game_alliance_admin_transfer') }}" method="get"><button type="submit" class="btn--danger">{{ LNG.al_transfer_btn }}</button></form>
	</div>
</section>
{% endif %}
{% endblock %}
