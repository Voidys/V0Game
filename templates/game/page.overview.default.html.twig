{% extends layout_template %}
{% block title %}{{ LNG.lm_overview }}{{ parent() }}{% endblock %}
{% block script %}{{ parent() }}
    <script type="module" src="scripts/game/overview.js"></script>

{% endblock %}
{% import '_macros/ui.html.twig' as ui %}
{% macro art(image, style, enabled) -%}
{%- if not enabled or style == 0 -%}{{ theme_asset('planeten/' ~ image ~ '.jpg') }}
{%- elseif style == 1 -%}{{ theme_asset('planeten/varianten/v1_magic/' ~ image ~ '_v1_magic.webp') }}
{%- elseif style == 2 -%}{{ theme_asset('planeten/varianten/v2_storm/' ~ image ~ '_v2_storm.webp') }}
{%- else -%}{{ theme_asset('planeten/varianten/v3_voronoi/' ~ image ~ '_v3_voronoi.webp') }}
{%- endif -%}
{% endmacro %}
{% block pagehead %}
{% set headActions %}
<a class="btn" href="#" data-dialog="{{ path('game_overview_actions') }}" data-dialog-width="400" title="{{ LNG.ov_planetmenu }}">{{ icon('pencil') }}<span>{{ LNG.ov_planet_rename }}</span></a>
{% endset %}
{{ ui.page_head(planetname, 'layout-dashboard', '[' ~ galaxy ~ ':' ~ system ~ ':' ~ planet ~ '] · ' ~ LNG["type_planet_#{planet_type}"] ~ ' · ' ~ username, headActions) }}
{% endblock %}
{% block content %}
    {# event colours: a colour still at its factory default is left to the theme (--colorMission*, fallback = the default),
       a colour the player changed is emitted as a custom property and wins in every theme #}
    {% set factoryColors = {'colorMission2friend': '#ff00ff', 'colorMission1Own': '#66cc33', 'colorMission2Own': '#339966', 'colorMission3Own': '#5bf1c2', 'colorMission4Own': '#cf79de', 'colorMission5Own': '#80a0c0', 'colorMission6Own': '#ffcc66', 'colorMission7Own': '#c1c1c1', 'colorMission7OwnReturn': '#cf79de', 'colorMission8Own': '#ceff68', 'colorMission9Own': '#ffff99', 'colorMission10Own': '#ffcc66', 'colorMission15Own': '#5bf1c2', 'colorMission16Own': '#5bf1c2', 'colorMission17Own': '#5bf1c2', 'colorMissionReturnOwn': '#6e8eea', 'colorMission1Foreign': '#ff0000', 'colorMission2Foreign': '#aa0000', 'colorMission3Foreign': '#00ff00', 'colorMission4Foreign': '#ad57bc', 'colorMission5Foreign': '#3399cc', 'colorMission6Foreign': '#ff6600', 'colorMission7Foreign': '#00ff00', 'colorMission8Foreign': '#acdd46', 'colorMission9Foreign': '#dddd77', 'colorMission10Foreign': '#ff6600', 'colorMission15Foreign': '#39d0a0', 'colorMission16Foreign': '#39d0a0', 'colorMission17Foreign': '#39d0a0', 'colorMissionReturnForeign': '#6e8eea', 'colorStaticTimer': '#ffff00'} %}
    <style>
        {% set customColors %}{% for key, factory in factoryColors %}{% if colors[key]|default(factory)|lower != factory %}--{{ key }}: {{ colors[key] }};{% endif %}{% endfor %}{% endset %}
        {% if customColors|trim %}:root { {{ customColors }} }{% endif %}
        {% for key, factory in factoryColors %}
        .{{ key == 'colorStaticTimer' ? 'statictimer' : key }} { color: var(--{{ key }}, {{ colors[key]|default(factory) }}); }
        {% endfor %}
    </style>
    {% set hostileCount = 0 %}
    {% set nextRest = null %}
    {% for fleet in fleets %}
        {% if fleet.hostile %}{% set hostileCount = hostileCount + 1 %}{% endif %}
        {% if nextRest is null or fleet.resttime < nextRest %}{% set nextRest = fleet.resttime %}{% endif %}
    {% endfor %}
    {% set fieldFill = planet_field_max > 0 ? min(planet_field_current / planet_field_max, 1) : 0 %}

    <section class="panel hero" data-coords="{{ galaxy }}:{{ system }}:{{ planet }}">
        <div class="hero-orbit">
            {% if Moon %}<span class="orbit-ring" aria-hidden="true"></span>{% endif %}
            <img class="hero-art" src="{{ _self.art(planetimage, planet_style, enablePlanetStyles != 0) }}" width="200" height="200" alt="{{ planetname }}">
            {% if Moon %}
                <a class="orbit-moon" href="{{ path('game_overview_show', {cp: Moon.id, re: 0}) }}" title="{{ Moon.name }} ({% if Moon.planet_type == 3 %}{{ LNG.ov_moon }}{% else %}{{ LNG.ov_planet }}{% endif %})">
                    <img src="{{ _self.art(Moon.image, Moon.planet_style, enablePlanetStyles != 0) }}" width="100" height="100" alt="{{ Moon.name }} {% if Moon.planet_type == 3 %}({{ LNG.fcm_moon }}){% else %}({{ LNG.fcm_planet }}){% endif %}">
                    <span class="orbit-label">{{ Moon.name }}</span>
                </a>
            {% endif %}
        </div>
        <div class="hero-body">
            <dl class="stats">
                <div class="stat"><dt class="stat__label">{{ LNG.ov_diameter }}</dt><dd class="stat__value">{{ planet_diameter }} {{ LNG.ov_distance_unit }}</dd></div>
                <div class="stat"><dt class="stat__label">{{ LNG.ov_temperature }}</dt><dd class="stat__value"><a class="tooltip_sticky" data-tooltip-content="{{ LNG.ov_aprox }} {{ planet_temp_min }}{{ LNG.ov_temp_unit }} {{ LNG.ov_to }} {{ planet_temp_max }}{{ LNG.ov_temp_unit }}">{{ planet_temp_max }}{{ LNG.ov_temp_unit }}</a></dd></div>
                <div class="stat"><dt class="stat__label">{{ LNG.ov_fields }}</dt><dd class="stat__value"><a title="{{ LNG.ov_developed_fields }}">{{ planet_field_current }}</a> / <a title="{{ LNG.ov_max_developed_fields }}">{{ planet_field_max }}</a></dd></div>
                <div class="stat"><dt class="stat__label">{{ LNG.ov_position }}</dt><dd class="stat__value"><a href="{{ path('game_galaxy_show', {galaxy: galaxy, system: system}) }}">[{{ galaxy }}:{{ system }}:{{ planet }}]</a></dd></div>
                <div class="stat stat--wide"><dt class="stat__label">{{ LNG.ov_points }}</dt><dd class="stat__value stat__value--text">{% if rankInfo %}{{ LNG.format('ov_userrank_info', rankInfo.points, LNG.ov_place, rankInfo.rank, rankInfo.rank, LNG.ov_of, rankInfo.usersCount) }}{% else %}-{% endif %}</dd></div>
            </dl>
            <div class="meter{% if planet_field_current > planet_field_max %} meter--danger{% elseif fieldFill > 0.9 %} meter--warn{% endif %}" style="--fill: {{ fieldFill|number_format(3, '.', '') }}" title="{{ planet_field_current }} / {{ planet_field_max }} {{ LNG.ov_fields }}"></div>
        </div>
    </section>

    {% if recentNews %}
    {# community news of the last three days (OverviewController::recentNews), above the tutorial #}
    <section class="panel overview-news" aria-labelledby="overview-news-title">
        <header class="panel__head">
            <h2 id="overview-news-title">{{ LNG.ov_news }}</h2>
            <a href="{{ path('login_news_show') }}" target="_blank" rel="noopener">{{ LNG.ov_news_all }}</a>
        </header>
        <ul class="news-list">
            {% for item in recentNews %}
                <li class="news-item{% if item.pinned %} is-pinned{% endif %}">
                    <time class="news-item__date mono">{{ item.date }}</time>
                    <a class="news-item__title" href="{{ path('login_news_article', {id: item.id}) }}" target="_blank" rel="noopener">{% if item.pinned %}{{ icon('star') }}{% endif %}{{ item.title }}</a>
                    {% if item.summary %}<p class="news-item__summary">{{ item.summary }}</p>{% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    <div class="tutorial-box">
        {% include 'game/shared.tutorial.html.twig' %}
    </div>

    <div class="grid-3 overview-activity">
        <section class="panel overview-events{% if hostileCount %} is-hostile{% endif %}" id="events-accordion">
            <header class="panel__head">
                <h2>{% if hostileCount %}{{ icon('triangle-alert') }} {% endif %}{{ LNG.ov_events }}</h2>
                <span>{% if fleets %}{{ fleets|length }} &middot; <span class="fleets" data-fleet-time="{{ nextRest }}">{{ getRestTimeFormat(nextRest) }}</span>{% else %}0{% endif %}{% if hostileCount %} &middot; <span class="tag tag--neg">{{ LNG.ov_event_hostile }} {{ hostileCount }}</span>{% endif %}</span>
            </header>
            <ul class="event-list" id="hidden-div2">
                {% for index, fleet in fleets %}
                    <li{% if fleet.hostile %} class="event-list__hostile"{% endif %}>
                        <span class="event-list__icon" aria-hidden="true">{{ icon(fleet.hostile ? 'triangle-alert' : 'rocket') }}</span>
                        <span class="event-list__text">
                            {% if fleet.hostile %}<span class="tag tag--neg">{{ LNG.ov_event_hostile }}</span> {% endif %}<span id="fleettext_{{ index }}">{{ fleet.text }}</span>
                        </span>
                        <span class="event-list__time">
                            <span id="fleettime_{{ index }}" class="fleets" data-fleet-end-time="{{ fleet.returntime }}" data-fleet-time="{{ fleet.resttime }}">{{ getRestTimeFormat(fleet.resttime) }}</span>
                            <span data-time="{{ fleet.returntime }}" class="statictimer"></span>
                        </span>
                    </li>
                {% else %}
                    <li class="empty">{{ LNG.ov_no_fleets }}</li>
                {% endfor %}
            </ul>
        </section>

        <section class="panel">
            {{ ui.panel_head(LNG.ov_queues) }}
            <dl class="kv overview-queue panel__body">
                <dt><a href="{{ path('game_buildings_show') }}">{{ LNG.lm_buildings }}</a></dt>
                <dd>{% if buildInfo.buildings %}{{ LNG.tech[buildInfo.buildings['id']] }}{% if buildInfo.buildings['mode'] == 'destroy' %} {{ LNG.bd_dismantle }}{% endif %}<span class="lvl">{{ buildInfo.buildings['level'] }}</span><br><span class="timer mono" data-umode="{{ umode }}" data-time="{{ buildInfo.buildings['timeleft'] }}">{{ buildInfo.buildings['starttime'] }}</span>{% else %}<span class="muted">{{ LNG.ov_free }}</span>{% endif %}</dd>
                <dt><a href="{{ path('game_research_show') }}">{{ LNG.lm_research }}</a></dt>
                <dd>{% if buildInfo.tech %}{{ LNG.tech[buildInfo.tech['id']] }}<span class="lvl">{{ buildInfo.tech['level'] }}</span><br><span class="timer mono" data-umode="{{ umode }}" data-time="{{ buildInfo.tech['timeleft'] }}">{{ buildInfo.tech['starttime'] }}</span>{% else %}<span class="muted">{{ LNG.ov_free }}</span>{% endif %}</dd>
                <dt><a href="{{ path('game_shipyard_show', {kind: 'shipyard'}) }}">{{ LNG.lm_shipshard }}</a></dt>
                <dd>{% if buildInfo.fleet %}{{ LNG.tech[buildInfo.fleet['id']] }}<span class="lvl">{{ buildInfo.fleet['level'] }}</span><br><span class="timer mono" data-umode="{{ umode }}" data-time="{{ buildInfo.fleet['timeleft'] }}">{{ buildInfo.fleet['starttime'] }}</span>{% else %}<span class="muted">{{ LNG.ov_free }}</span>{% endif %}</dd>
                {% if isModuleAvailable(constant('MODULE_REPAIR_DOCK')) %}
                    <dt><a href="{{ path('game_repairdock_show') }}">{{ LNG.lm_repairdock }}</a></dt>
                    <dd>{% if buildInfo.repair %}<span id="repairtext"{% if buildInfo.repair.repairing %} data-alttext="{{ buildInfo.repair['deploy_text'] }}"{% endif %}>{% if buildInfo.repair.repairing %}{{ buildInfo.repair['text'] }}{% else %}{{ buildInfo.repair['deploy_text'] }}{% endif %}</span><br><span class="timerrepair mono" data-umode="{{ umode }}" data-time="{{ buildInfo.repair['timeleft'] }}" data-repairing="{{ buildInfo.repair['repairing'] }}">{{ buildInfo.repair['starttime'] }}</span>{% else %}<span class="muted">{{ LNG.ov_free }}</span>{% endif %}</dd>
                {% endif %}
            </dl>
        </section>

        <section class="panel overview-info">
            {{ ui.panel_head(LNG.lm_info) }}
            <div class="panel__body">
                <dl class="kv">
                    <dt>{{ LNG.ov_server_time }}</dt>
                    <dd class="mono"><span class="servertime">{{ servertime }}</span></dd>
                    {% if outlawTime %}
                        <dt class="colorNegative">{{ LNG.ov_outlaw }}</dt>
                        <dd class="colorNegative">{{ outlawTime }}</dd>
                    {% endif %}
                    {% if isCatchUp %}
                        <dt>%</dt>
                        <dd>{{ catchUp }} %</dd>
                    {% endif %}
                    <dt>{{ LNG.ov_admins_online|trim|trim(':')|trim }}</dt>
                    <dd>{% for ID, Name in AdminsOnline %}<a class="colorPositive" href="#" data-action="dialog-pm" data-id="{{ ID }}">{{ Name }}</a> &bull; {% endfor %}<a class="colorPositive" href="{{ path('game_ticket_show') }}">{{ LNG.ov_ticketbot }}</a></dd>
                </dl>
                <p>{{ LNG.ov_rulesnotify }}&nbsp;<a href="{{ path('login_rules') }}" data-dialog data-dialog-width="820" class="rules-link">[{{ LNG.ov_rules }}]</a></p>
            </div>
        </section>
    </div>

    {% if AllPlanets or Moon %}
        <section class="panel overview-planets">
            {{ ui.panel_head(LNG.ov_planets) }}
            <div class="panel__body grid-auto">
                {% set moonListed = false %}{% for PlanetRow in AllPlanets %}{% if Moon and PlanetRow.id == Moon.id %}{% set moonListed = true %}{% endif %}{% endfor %}
                {% if Moon and not moonListed %}
                    <div class="overview-planet">
                        <a href="{{ path('game_overview_show', {cp: Moon.id, re: 0}) }}" title="{{ Moon.name }}"><img class="planet-thumb" src="{{ _self.art(Moon.image, Moon.planet_style, enablePlanetStyles != 0) }}" width="48" height="48" alt="{{ Moon.name }}"></a>
                        <div>
                            <strong>{{ Moon.name }}</strong> <span class="muted">({% if Moon.planet_type == 3 %}{{ LNG.ov_moon }}{% else %}{{ LNG.ov_planet }}{% endif %})</span><br>
                            {% if Moon.build %}{{ LNG.tech[Moon.build['id']] }}<span class="lvl">{{ Moon.build['level'] }}</span> <span class="timershort mono" data-umode="{{ umode }}" data-time="{{ Moon.build['timeleft'] }}">{{ Moon.build['starttime'] }}</span>{% else %}<span class="muted">{{ LNG.ov_free }}</span>{% endif %}
                        </div>
                    </div>
                {% endif %}
                {% for PlanetRow in AllPlanets %}
                    <div class="overview-planet">
                        <a href="{{ path('game_overview_show', {cp: PlanetRow.id}) }}" title="{{ PlanetRow.name }}"><img class="planet-thumb" src="{{ _self.art(PlanetRow.image, PlanetRow.planet_style, enablePlanetStyles != 0) }}" width="48" height="48" alt="{{ PlanetRow.name }}"></a>
                        <div>
                            <strong>{{ PlanetRow.name }}</strong> <span class="mono muted">[{{ PlanetRow.galaxy }}:{{ PlanetRow.system }}:{{ PlanetRow.planet }}]</span><br>
                            {% if PlanetRow.build %}{{ LNG.tech[PlanetRow.build['id']] }}{% if PlanetRow.build['mode'] == 'destroy' %} {{ LNG.bd_dismantle }}{% endif %}<span class="lvl">{{ PlanetRow.build['level'] }}</span> <span class="timershort mono" data-umode="{{ umode }}" data-time="{{ PlanetRow.build['timeleft'] }}">{{ PlanetRow.build['starttime'] }}</span>{% else %}<span class="muted">{{ LNG.ov_free }}</span>{% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
