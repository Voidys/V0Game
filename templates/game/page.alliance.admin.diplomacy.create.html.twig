{% import '_macros/forms.html.twig' as forms -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_alliance }}{{ parent() }}{% endblock %}
{% block content %}
<form name="message" id="message">
	<table class="form-table">
	<tr>
		<th colspan="2">{{ LNG.al_diplo_create }}</th>
	</tr>
	<tr>
		<td><label for="d_ally_id">{{ LNG.al_diplo_ally }}</label></td>
		<td>{{ forms.html_options({'id': "d_ally_id", 'name': "ally_id", 'values': IdList, 'output': AllyList}) }}</td>
	</tr>
	<tr>
		<td><label for="d_level">{{ LNG.al_diplo_level_des }}</label></td>
		{% if diploMode == constant('App\\Game\\Enum\\DiploType::Peace').value %}
			<td>{{ forms.html_options({'id': "d_level", 'name': "level", 'values': range(7, 7), 'output': diploLevel, 'selected': diploMode}) }}</td>
		{% else %}
			<td>{{ forms.html_options({'id': "d_level", 'name': "level", 'values': range(1, 6), 'output': diploLevel, 'selected': diploMode}) }}</td>
		{% endif %}
	</tr>
	{% if diploMode != constant('App\\Game\\Enum\\DiploType::Peace').value %}
	<tr>
		<td><label for="d_expires">{{ LNG.alt_diplo_expires }}</label></td>
		<td>
			<select id="d_expires" name="expires">
				<option value="0">{{ LNG.alt_diplo_expires_never }}</option>
				{% for days in [7, 14, 30, 60, 90, 180] %}<option value="{{ days }}">{{ days }} {{ LNG.alt_days }}</option>{% endfor %}
			</select>
		</td>
	</tr>
	{% endif %}
	<tr>
		<td><label for="d_text">{{ LNG.al_diplo_text }}</label><br>(<span id="cntChars">0</span> / 5000 {{ LNG.al_characters }})</td>
		<td>
			<textarea name="text" id="d_text" rows="10" data-on-keyup="char-count" data-target="cntChars" maxlength="5000"></textarea>
		</td>
	</tr>
	<tr>
		<th class="form-actions" colspan="2">
		<input type="reset" value="{{ LNG.al_circular_reset }}">
		<input type="button" data-action="alliance-message-send" data-url="{{ path('game_alliance_admin_diplomacy_create_send', {ajax: 1}) }}" data-after="reload" data-empty="{{ LNG.mg_empty_text|e('html_attr') }}" value="{{ LNG.al_circular_send_submit }}">
		</th>
	</tr>
	</table>
</form>
{% endblock %}
{% block script %}{{ parent() }}
<script type="module" src="./scripts/game/alliance.js?v={{ asset_version }}"></script>
{% endblock %}
