{% import '_macros/ui.html.twig' as ui -%}
{% extends layout_template %}
{% block title %}{{ LNG.lm_farms }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.lm_farms, 'crosshair', LNG.farm_intro) }}{% endblock %}
{% block content %}
<form class="toolbar" action="{{ path('game_farms_show') }}" method="get">
	<input type="hidden" name="sort" value="{{ sort }}">
	<input type="hidden" name="dir" value="{{ dir }}">
	<label><input type="checkbox" name="inactive" value="1"{{ filter.inactive ? ' checked' : '' }}> {{ LNG.farm_only_inactive }}</label>
	<label>{{ LNG.farm_max_defense }} <input type="number" name="max_defense" min="0" step="1000" value="{{ filter.max_defense }}"></label>
	<label>{{ LNG.farm_max_age }} <input type="number" name="max_age" min="0" step="1" value="{{ filter.max_age }}"></label>
	<input type="submit" class="btn--primary" value="{{ LNG.farm_filter }}">
</form>
<section class="panel panel--flush">
	{% if rows %}
	{% set columns = {coords: LNG.farm_col_coords, player: LNG.farm_col_player, state: LNG.farm_col_state, age: LNG.farm_col_age, loot: LNG.farm_col_loot, defense: LNG.farm_col_defense, fleet: LNG.farm_col_fleet, cargos: LNG.farm_col_cargos, distance: LNG.fl_distance} %}
	<table class="data">
		<thead>
			<tr>
				{% for key, label in columns %}
				<th{% if key in ['loot', 'defense', 'fleet', 'cargos', 'distance', 'age'] %} class="num"{% endif %}{% if sort == key %} aria-sort="{{ dir == 'asc' ? 'ascending' : 'descending' }}"{% endif %}>
					<a href="{{ path('game_farms_show', {sort: key, dir: (sort == key and dir == 'desc') ? 'asc' : 'desc', inactive: filter.inactive ? 1 : null, max_defense: filter.max_defense ?: null, max_age: filter.max_age ?: null}) }}">{{ label }}{% if sort == key %} {{ dir == 'asc' ? '&#9650;'|raw : '&#9660;'|raw }}{% endif %}</a>
				</th>
				{% endfor %}
				<th class="act"></th>
			</tr>
		</thead>
		<tbody>
		{% for row in rows %}
			{% set target = row.target %}
			{% set mission = target.planet_type < 4 ? 1 : 20 %}
			{% set coordsQuery = {galaxy: target.galaxy, system: target.system, planet: target.planet, planettype: target.planet_type} %}
			<tr>
				<td><a href="{{ path('game_galaxy_show', {galaxy: target.galaxy, system: target.system}) }}">[{{ target.galaxy }}:{{ target.system }}:{{ target.planet }}]</a>{% if target.planet_type == 3 %} ({{ LNG.fcm_moon }}){% endif %}</td>
				<td>{{ row.player }}{% if row.woke %} <span class="tag tag--neg" title="{{ LNG.farm_woke_title }}">{{ LNG.farm_woke }}</span>{% endif %}</td>
				<td>{% if row.state == 'i' %}<span class="tag tag--muted" title="{{ LNG.gl_inactive_seven }}">{{ LNG.gl_short_inactive }}</span>{% elseif row.state == 'I' %}<span class="tag tag--muted" title="{{ LNG.gl_inactive_twentyeight }}">{{ LNG.gl_short_long_inactive }}</span>{% endif %}</td>
				<td class="num">{% if row.age >= 86400 %}{{ row.age // 86400 }}d {% endif %}{{ (row.age % 86400) // 3600 }}h {{ (row.age % 3600) // 60 }}m</td>
				<td class="num" title="{{ LNG.tech[901] }} {{ pretty_number(row.loot.metal) }} / {{ LNG.tech[902] }} {{ pretty_number(row.loot.crystal) }} / {{ LNG.tech[903] }} {{ pretty_number(row.loot.deuterium) }}">{{ pretty_number(row.lootTotal) }}</td>
				<td class="num">{{ pretty_number(row.defenseValue) }}</td>
				<td class="num">{{ pretty_number(row.fleetValue) }}</td>
				<td class="num" title="{{ pretty_number(row.small) }} {{ LNG.spy_small_transporter }}">{{ pretty_number(row.large) }}</td>
				<td class="num">{{ pretty_number(row.distance) }}</td>
				<td class="act">
					<a class="button" href="{{ path('game_fleet_step1_show') }}?galaxy={{ target.galaxy }}&amp;system={{ target.system }}&amp;planet={{ target.planet }}&amp;planettype={{ target.planet_type }}&amp;target_mission={{ mission }}&amp;ships=203:{{ row.large }}">{{ icon('crosshair') }} {{ LNG.spy_tools_attack }}</a>
					<a class="button" href="#" data-action="popup" data-url="{{ path('game_spy_report_popup_show', coordsQuery) }}" data-width="900">{{ icon('file-search') }} {{ LNG.farm_open_report }}</a>
					<a class="button" href="{{ path('game_fleet_step1_show') }}?galaxy={{ target.galaxy }}&amp;system={{ target.system }}&amp;planet={{ target.planet }}&amp;planettype={{ target.planet_type }}&amp;target_mission={{ target.planet_type < 4 ? 6 : 21 }}&amp;ships=210:{{ row.spyShips }}">{{ LNG.spy_tools_respy }}</a>
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
	<p class="hint panel__body">{{ LNG.spy_tools_note }}</p>
	{% else %}
	<p class="empty">{{ LNG.farm_none }}</p>
	{% endif %}
</section>
{% endblock %}
