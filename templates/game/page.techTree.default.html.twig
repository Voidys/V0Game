{% extends layout_template %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}
{{ LNG.lm_technology }}{{ parent() }}{% endblock %}
{% block pagehead %}{{ ui.page_head(LNG.lm_technology, 'network') }}{% endblock %}

{% block content %}
<section class="tt panel" id="tt-root">
  <div class="tt-tabs" role="tablist" aria-label="{{ LNG.tt_graph }}">
    {% for tab in TechTree.tabs %}
    <button type="button" class="tt-tab" role="tab" id="tt-tab-{{ tab.group }}" data-group="{{ tab.group }}" aria-controls="tt-panel-{{ tab.group }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? '0' : '-1' }}">{{ Headlines[tab.group] }}</button>
    {% endfor %}
  </div>
  {% for tab in TechTree.tabs %}
  <section class="tt-panel" role="tabpanel" id="tt-panel-{{ tab.group }}" aria-labelledby="tt-tab-{{ tab.group }}" data-group="{{ tab.group }}"{% if not loop.first %} hidden{% endif %}>
    <div class="tt-scroll">
      <div class="tt-canvas">
        {% for row in tab.rows %}
        <div class="tt-row">
          {% for id in row %}
          {% set node = TechTree.nodes[id] %}
          <div class="tt-cell tt-{{ node.status }}{% if node.group != tab.group %} tt-ghost{% endif %}" data-id="{{ id }}">
            <div class="tt-node" role="button" tabindex="0" data-id="{{ id }}" aria-pressed="false" aria-label="{{ node.name }}" title="{{ node.name }}{% if node.group != tab.group %} ({{ LNG.tt_foreign }}: {{ Headlines[node.group] }}){% endif %}">
              <span class="tt-img"><img src="{{ theme_asset(node.image) }}" width="36" height="36" alt="" loading="lazy">{% if node.level > 0 %}<span class="tt-lv" title="{{ LNG.tt_lvl|trim }} {{ node.level }}">{{ LNG.tt_lv_short }} {{ node.level }}</span>{% endif %}</span>
              <span class="tt-name">{{ node.name }}</span>
            </div>
            <a href="#" class="tt-info" data-action="dialog-info" data-id="{{ id }}" aria-label="{{ node.name }}">{{ icon('info') }}</a>
          </div>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endfor %}
  <div class="tt-detail" id="tt-detail" aria-live="polite"><p class="tt-hint">{{ LNG.tt_hint }}</p></div>
</section>
{% endblock %}
{% block script %}{{ parent() }}
  {# graph data for scripts/game/techtree.js #}
  {{ data_island('techtree-data', {
    nodes: TechTree.nodes,
    labels: {
      requirements: LNG.tt_requirements,
      unlocks: LNG.tt_unlocks,
      level: LNG.tt_lvl|trim,
      none: LNG.tt_none,
      hint: LNG.tt_hint,
      status: { owned: LNG.tt_status_owned, available: LNG.tt_status_available, locked: LNG.tt_status_locked },
    },
  }) }}
<script type="module" src="./scripts/game/techtree.js?v={{ asset_version }}"></script>
{% endblock %}
