{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.ins_step_legal }}{% endblock %}
{% block panel %}
  <p>{{ LNG.ins_legal_desc }}</p>
  {% if error is defined and error %}
    <div class="notice notice--danger" role="alert">{{ icon('circle-alert') }}<div>{{ error }}</div></div>
  {% endif %}
  <form class="install-form" action="./?mode=install&amp;step=7" method="post">
    <input type="hidden" name="post" value="1">
    <input type="hidden" name="bots" value="{{ bots|default(0) }}">
    <fieldset>
      <legend>{{ LNG.ins_group_privacy }}</legend>
      <p class="install-field--wide install-hint">{{ LNG.ins_privacy_info }}</p>
      <label class="install-check install-field--wide">
        <input type="radio" name="privacy_region" value="eu"{% if values.privacy_region == 'eu' %} checked{% endif %}>
        <span><strong>{{ LNG.ins_privacy_eu }}</strong><small class="install-hint">{{ LNG.ins_privacy_eu_info }}</small></span>
      </label>
      <label class="install-check install-field--wide">
        <input type="radio" name="privacy_region" value="other"{% if values.privacy_region == 'other' %} checked{% endif %}>
        <span><strong>{{ LNG.ins_privacy_other }}</strong><small class="install-hint">{{ LNG.ins_privacy_other_info }}</small></span>
      </label>
      <label class="install-check install-field--wide"><input type="checkbox" name="cookie_consent" value="1"{% if values.cookie_consent %} checked{% endif %}> <span>{{ LNG.ins_cookie_consent }}<small class="install-hint">{{ LNG.ins_cookie_consent_info }}</small></span></label>
    </fieldset>
    <fieldset>
      <legend>{{ LNG.ins_group_rules }}</legend>
      <label class="install-check install-field--wide">
        <input type="radio" name="rules_default" value="default"{% if values.rules_default == 'default' %} checked{% endif %}>
        <span><strong>{{ LNG.ins_rules_default }}</strong><small class="install-hint">{{ LNG.ins_rules_default_info }}</small></span>
      </label>
      <label class="install-check install-field--wide">
        <input type="radio" name="rules_default" value="blank"{% if values.rules_default == 'blank' %} checked{% endif %}>
        <span><strong>{{ LNG.ins_rules_blank }}</strong><small class="install-hint">{{ LNG.ins_rules_blank_info }}</small></span>
      </label>
    </fieldset>
    <fieldset>
      <legend>{{ LNG.ins_group_imprint }}</legend>
      <p class="install-field--wide install-hint">{{ LNG.ins_imprint_info }}</p>
      {% if values.privacy_region == 'eu' and not values.disclamer_mail %}
        <div class="notice notice--info install-field--wide" role="note">{{ icon('info') }}<div>{{ LNG.ins_imprint_eu_hint }}</div></div>
      {% endif %}
      <label class="install-field install-field--wide">{{ LNG.ins_imprint_mail }}<input type="email" name="disclamer_mail" value="{{ values.disclamer_mail }}" maxlength="255"></label>
      <label class="install-field install-field--wide">{{ LNG.ins_imprint_address }}<textarea name="disclamer_address" rows="3" maxlength="1000">{{ values.disclamer_address }}</textarea></label>
    </fieldset>
    <p class="install-hint">{{ LNG.ins_legal_note }}</p>
    <div class="install-actions"><button type="submit" class="btn--primary">{{ LNG.continue }}</button></div>
  </form>
{% endblock %}
