{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.ins_check_head }}{% endblock %}
{% block panel %}
  <p>{{ LNG.req_desc }}</p>
  {% if passed %}
    <div class="notice notice--success" role="status">{{ icon('circle-check') }}<div>{{ LNG.ins_check_ok }}</div></div>
    <details class="install-advanced">
      <summary>{{ LNG.ins_check_show }}</summary>
      {% include 'install/ins_checks.html.twig' %}
    </details>
  {% else %}
    <div class="notice notice--danger" role="alert">{{ icon('circle-alert') }}<div>{{ LNG.ins_check_fail }}</div></div>
    {% include 'install/ins_checks.html.twig' %}
  {% endif %}

  <form class="install-form" action="./?mode=install&amp;step=1" method="post">
    <input type="hidden" name="post" value="1">
    <details class="install-advanced">
      <summary>{{ LNG.licence_head }} (GNU AGPL v3)</summary>
      <p>{{ LNG.licence_desc }}</p>
      <pre class="install-licence" tabindex="0">{{ licenceText|e }}</pre>
    </details>
    <label class="install-check"><input type="checkbox" name="accept" required{% if not passed %} disabled{% endif %}> {{ LNG.licence_accept }}</label>
    {% if not accept %}
      <div class="notice notice--danger" role="alert">{{ icon('circle-alert') }}<div>{{ LNG.licence_need_accept }}</div></div>
    {% endif %}
    <div class="install-actions">
      <a class="button" href="./">{{ LNG.back }}</a>
      {% if passed %}
        <button type="submit" class="btn--primary">{{ LNG.continue }}</button>
      {% else %}
        <a class="button btn--primary" href="./?mode=install&amp;step=1">{{ icon('refresh-cw') }}{{ LNG.ins_recheck }}</a>
      {% endif %}
    </div>
  </form>
{% endblock %}
