{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.ins_step_game }}{% endblock %}
{% block panel %}
  <p>{{ LNG.ins_game_desc }}</p>
  {% if error is defined and error %}
    <div class="notice notice--danger" role="alert">{{ icon('circle-alert') }}<div>{{ error }}</div></div>
  {% endif %}
  <form class="install-form" action="./?mode=install&amp;step=6" method="post">
    <input type="hidden" name="post" value="1">
    <fieldset>
      <legend>{{ LNG.ins_group_general }}</legend>
      <label class="install-field install-field--wide">{{ LNG.ins_game_name }}<input type="text" name="game_name" value="{{ values.game_name|e('html_attr') }}" maxlength="64" required><small>{{ LNG.ins_game_name_info }}</small></label>
      <label class="install-field">{{ LNG.ins_uni_name }}<input type="text" name="uni_name" value="{{ values.uni_name|e('html_attr') }}" maxlength="60" placeholder="{{ (LNG.fcm_universe ~ ' 1')|e('html_attr') }}"><small>{{ LNG.ins_uni_name_info }}</small></label>
      <label class="install-field">{{ LNG.ins_language }}
        <select name="language">
          {% for key, name in languages %}<option value="{{ key }}"{% if key == values.language %} selected{% endif %}>{{ name }}</option>{% endfor %}
        </select>
        <small>{{ LNG.ins_language_info }}</small>
      </label>
      <label class="install-field">{{ LNG.ins_timezone }}
        <select name="timezone">
          {% for zone in timezones %}<option value="{{ zone }}"{% if zone == values.timezone %} selected{% endif %}>{{ zone }}</option>{% endfor %}
        </select>
        <small>{{ LNG.ins_timezone_info }}</small>
      </label>
      <label class="install-field">{{ LNG.ins_default_theme }}
        <select name="default_theme">
          {% for themeKey, themeName in themes %}<option value="{{ themeKey }}"{% if themeKey == values.default_theme %} selected{% endif %}>{{ themeName }}</option>{% endfor %}
        </select>
        <small>{{ LNG.ins_default_theme_info }}</small>
      </label>
    </fieldset>
    <fieldset>
      <legend>{{ LNG.ins_group_speed }}</legend>
      <p class="install-field--wide install-hint">{{ LNG.ins_speed_info }}</p>
      {% for speed in speeds %}
        <label class="install-check install-field--wide install-speed">
          <input type="radio" name="speed" value="{{ speed }}"{% if speed == values.speed %} checked{% endif %}>
          <span><strong>{{ attribute(LNG, 'ins_speed_' ~ speed) }}</strong> &ndash; {{ attribute(LNG, 'ins_speed_' ~ speed ~ '_info') }}
            <small>{{ LNG.ins_speed_detail|replace({'%b': presets[speed].building_speed, '%f': presets[speed].fleet_speed, '%r': presets[speed].resource_multiplier}) }}</small></span>
        </label>
      {% endfor %}
    </fieldset>
    <fieldset>
      <legend>{{ LNG.ins_group_players }}</legend>
      <label class="install-field install-field--wide">{{ LNG.ins_registration }}
        <select name="registration">
          <option value="open"{% if values.registration == 'open' %} selected{% endif %}>{{ LNG.ins_registration_open }}</option>
          <option value="closed"{% if values.registration == 'closed' %} selected{% endif %}>{{ LNG.ins_registration_closed }}</option>
        </select>
        <small>{{ LNG.ins_registration_info }}</small>
      </label>
      <label class="install-field">{{ LNG.ins_bots }}<input type="number" name="bots" value="{{ values.bots }}" min="0" max="50"><small>{{ LNG.ins_bots_info }}</small></label>
    </fieldset>
    <details class="install-more">
      <summary>{{ LNG.ins_more_settings }}</summary>
      <fieldset>
        <label class="install-check install-field--wide"><input type="checkbox" name="update_check" value="1"{% if values.update_check %} checked{% endif %}> <span>{{ LNG.ins_update_check }}<small class="install-hint">{{ LNG.ins_update_check_info }}</small></span></label>
        <label class="install-field install-field--wide">{{ LNG.ins_discord_url }}<input type="url" name="discord_url" value="{{ values.discord_url }}" maxlength="255" placeholder="https://discord.gg/..."><small>{{ LNG.ins_discord_url_info }}</small></label>
      </fieldset>
    </details>
    <div class="install-actions"><button type="submit" class="btn--primary">{{ LNG.continue }}</button></div>
  </form>
{% endblock %}
