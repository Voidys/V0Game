{% extends 'install/ins_layout.html.twig' %}
{% block heading %}{{ LNG.step4_head }}{% endblock %}
{% block panel %}
  <p>{{ LNG.step4_desc }}</p>
  {% if error is defined and error %}
    <div class="notice notice--danger" role="alert">{{ icon('circle-alert') }}<div>{{ error }}</div></div>
  {% endif %}
  <form class="install-form" action="./?mode=install&amp;step=10" method="post">
    <input type="hidden" name="post" value="1">
    <input type="hidden" name="bots" value="{{ bots|default(0) }}">
    <fieldset>
      <label class="install-field install-field--wide">{{ LNG.step4_admin_name|trim(':') }}<input type="text" name="username" value="{{ username|default('')|e('html_attr') }}" minlength="3" maxlength="20" required autocomplete="username"><small>{{ LNG.step4_admin_name_desc }}</small></label>
      <label class="install-field install-field--wide">{{ LNG.step4_admin_mail|trim(':') }}<input type="email" name="email" value="{{ mail|default('')|e('html_attr') }}" required autocomplete="email"><small>{{ LNG.ins_admin_mail_info }}</small></label>
      <label class="install-field">{{ LNG.step4_admin_pass|trim(':') }}<input type="password" name="password" value="{{ password|default('')|e('html_attr') }}" minlength="{{ minLength|default(8) }}" maxlength="64" required autocomplete="new-password"></label>
      <label class="install-field">{{ LNG.ins_admin_pass_confirm }}<input type="password" name="password_confirm" value="{{ password|default('')|e('html_attr') }}" minlength="{{ minLength|default(8) }}" maxlength="64" required autocomplete="new-password"></label>
      <p class="install-field--wide install-hint">{{ LNG.ins_admin_pass_rules|replace({'%d': minLength|default(8)}) }}</p>
    </fieldset>
    <div class="install-actions"><button type="submit" class="btn--primary">{{ icon('user-plus') }}{{ LNG.continue }}</button></div>
  </form>
{% endblock %}
