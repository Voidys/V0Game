<!DOCTYPE html>
<html lang="{{ html_lang(lang) }}" data-dialog-ok="{{ LNG.dialog_ok }}" data-dialog-cancel="{{ LNG.dialog_cancel }}">
<head>
  <meta charset="utf-8">
  {# pages live below the site root (/account/board, /news/7): relative asset URLs resolve against the universe directory #}
  <base href="{{ app.request.basePath }}/{{ app.request.attributes.get('uni') }}">
  {{ import_map() }}
  <style>
    .colorPositive {
      color:{{ signalColors.colorPositive }}
    }
  
    .colorNegative {
      color:{{ signalColors.colorNegative }} !important;
    }
  
    .colorNeutral {
      color:{{ signalColors.colorNeutral }}
    }
  </style>
  <title>{% block title %} - {{ uni_name }} - {{ game_name }}{% endblock %}</title>
  {{ csrf_meta() }}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if goto %}
    <meta http-equiv="refresh" content="{{ gotoinsec }};URL={{ goto }}">
  {% endif %}
  <link rel="stylesheet" type="text/css" href="./styles/resource/css/app/base.css?v={{ asset_version }}">
  {# the player's skin, as in the game: contract (token mapping) + theme tokens #}
  <link rel="stylesheet" type="text/css" href="./styles/resource/css/app/theme-contract.css?v={{ asset_version }}">
  <link rel="stylesheet" type="text/css" href="{{ themeCssPath }}?v={{ asset_version }}">
  <link rel="stylesheet" type="text/css" href="./styles/resource/css/account/account.css?v={{ asset_version }}">
  <link rel="stylesheet" type="text/css" href="./styles/resource/css/app/rte.css?v={{ asset_version }}">
  {% include 'shared/icons.html.twig' with {p: './'} only %}

  {% include 'shared/page_config.html.twig' %}
  <script type="module" src="./scripts/page/config.js?v={{ asset_version }}"></script>
  <script type="module" src="./scripts/app/main.js?v={{ asset_version }}"></script>
  <script type="module" src="./scripts/app/rte.js?v={{ asset_version }}"></script>

  {% block script %}{% endblock %}
</head>

<body id="{{ app.request.attributes.get('_page')|default('overview') }}" class="account-page account-page--popup">
<div id="tooltip" class="tip"></div>
<header class="acc-topbar">
  <a class="acc-topbar__brand" href="./"><span class="wordmark">V<b>0</b>Game</span></a>
</header>
<main class="acc-main" id="content">{% block content %}{% endblock %}</main>
<footer class="acc-footer">
</footer>
