{% macro state(status) %}{% if status == constant('STATUS_OPEN') %}{{ LNG["uni_status_regopen_gameopen"] }}{% elseif status == constant('STATUS_REG_ONLY') %}{{ LNG["uni_status_regopen_gameclosed"] }}{% elseif status == constant('STATUS_LOGIN_ONLY') %}{{ LNG["uni_status_regclosed_gameopen"] }}{% else %}{{ LNG["uni_status_regclosed_gameclosed"] }}{% endif %}{% endmacro %}
{% extends layout_template %}

{% block title %}
{{ LNG.Achievements }}{{ parent() }}{% endblock %}

{% block content %}


<div class="account-login">
  <section class="acc-section" aria-labelledby="your-universes">
    <h1 class="acc-title" id="your-universes">{{ LNG["Your_universes"] }}</h1>
    <div class="universe-grid">
    {% for universe in playerUniverses %}
      <article class="panel universe-card">
        <h2 class="universe-card__title">{{ icon('globe') }}{{ universe["uni_name"] }}</h2>
        <dl class="universe-card__facts">
          <dt>{{ LNG["Playername"] }}</dt><dd>{{ universe["username"] }}</dd>
          <dt>{{ LNG["al_position"] }}</dt><dd>{{ universe["total_rank"] }}</dd>
          <dt>{{ LNG["Universe_start"] }}</dt><dd>{{ universe["start"] }}</dd>
          <dt>{{ LNG["Universe_end"] }}</dt><dd>{{ universe["end"]|default('-') ?: '-' }}</dd>
          <dt>{{ LNG["Universe_status"]|trim(' :') }}</dt><dd>{{ _self.state(universe["uni_status"]) }}</dd>
        </dl>
        <div class="universe-card__actions">
          <form action="{{ path('account_account_send') }}" method="post">
            <input type="hidden" name="userID" value="{{ universe["user_id"] }}">
            {% if universe["uni_status"] == constant('STATUS_OPEN') or universe["uni_status"] == constant('STATUS_LOGIN_ONLY') or universe["authlevel"] == constant('App\\Game\\Enum\\AuthLevel::Admin').value or authlevel == constant('App\\Game\\Enum\\AuthLevel::Admin').value %}
              <input type="hidden" name="action" value="login">
              <input class="btn btn--primary" value="{{ LNG["Play"] }}" type="submit">
            {% else %}
              <button type="button" class="btn" disabled aria-disabled="true">{{ LNG["uni_status_regclosed_gameclosed"] }}</button>
            {% endif %}
          </form>
        </div>
      </article>
    {% endfor %}
    </div>
  </section>

  {% if newUniverses %}
  <section class="acc-section" aria-labelledby="other-universes">
    <h1 class="acc-title" id="other-universes">{{ LNG["Other_universes"] }}</h1>
    <div class="universe-grid">
    {% for universe in newUniverses %}
      <article class="panel universe-card">
        <h2 class="universe-card__title">{{ icon('globe') }}{{ universe["uni_name"] }}</h2>
        <dl class="universe-card__facts">
          <dt>{{ LNG["Active_players"] }}</dt><dd>{{ (universe["active"]=="") ? 0 : universe["active"] }}</dd>
          <dt>{{ LNG["Universe_start"] }}</dt><dd>{{ universe["start"] }}</dd>
          <dt>{{ LNG["Universe_end"] }}</dt><dd>{{ universe["end"]|default('-') ?: '-' }}</dd>
        </dl>
        <div class="universe-card__actions">
          {% if universe["uni_status"] == constant('STATUS_OPEN') or universe["uni_status"] == constant('STATUS_REG_ONLY') or authlevel == constant('App\\Game\\Enum\\AuthLevel::Admin').value %}
            <a class="btn btn--primary" href="{{ path('account_register_show', {universe: universe["uni"]}) }}">{{ LNG["Register"] }}</a>
          {% else %}
            <button class="btn" disabled>{{ LNG["uni_status_regclosed_gameclosed"] }}</button>
          {% endif %}
        </div>
      </article>
    {% endfor %}
    </div>
  </section>
  {% endif %}
</div>
{% endblock %}
