{
    "name": "voidys/v0game",
    "description": "An open source space strategy game",
    "type": "project",
    "homepage": "https://github.com/Voidys/V0Game",
    "readme": "README.md",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Jan-Otto Kröpke",
            "email": "kroepke@outlook.com"
        },
        {
            "name": "pr0game Community"
        },
        {
            "name": "V0Game contributors",
            "homepage": "https://github.com/Voidys/V0Game"
        }
    ],
    "support": {
        "issues": "https://github.com/Voidys/V0Game/issues",
        "source": "https://github.com/Voidys/V0Game"
    },
    "require": {
        "php": ">=8.4.1",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-zlib": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.4",
        "dragonmantank/cron-expression": "^3.3",
        "erusev/parsedown": "^1.7.2",
        "minishlink/web-push": "^11.0",
        "phpmailer/phpmailer": "^7.0",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "suggest": {
        "ext-openssl": "Needed to send mail through an SMTP server with TLS/SSL (PHPMailer)"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/var-dumper": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "vendor-dir": "vendor",
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Game/Support/game_constants.php",
            "src/Game/Support/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "phpstan": "phpstan analyse --memory-limit=1G"
    }
}
