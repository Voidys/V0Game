DirectoryIndex index.php

Options -Indexes +FollowSymLinks

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

AddDefaultCharset utf-8
AddCharset utf-8 .css .js .xml .json .rss .atom

# Compression for text assets and SVG (the icon sprite is the biggest uncompressed one); mod_brotli wins when the client
# accepts br, mod_deflate (gzip) otherwise
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/css application/javascript text/javascript application/json image/svg+xml text/html
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css application/javascript text/javascript application/json image/svg+xml text/html
</IfModule>

<IfModule mod_headers.c>
    # CSS and JS URLs carry a version (?v=<git hash> or the file mtime, see layout.base.html.twig and the import map):
    # they never change under the same URL, so the browser keeps them without asking again. Unversioned ones keep
    # revalidating. Local DDEV hosts are excluded: there the git hash does not change between edits.
    <FilesMatch "\.(css|js|mjs)$">
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=/ && %{HTTP_HOST} !~ /\.ddev\.site(:[0-9]+)?$/"
        Header set Cache-Control "no-cache" "expr=!(%{QUERY_STRING} =~ /(^|&)v=/) || %{HTTP_HOST} =~ /\.ddev\.site(:[0-9]+)?$/"
    </FilesMatch>
    # images may come as their WebP copy depending on the Accept header (see the rewrite below)
    <FilesMatch "\.(png|jpe?g|gif|webp)$">
        Header append Vary Accept
    </FilesMatch>
    <FilesMatch "\.(gif|png|jpe?g|pdf|xml|oga|ogg|m4a|ogv|mp4|m4v|webm|svg|svgz|eot|ttf|otf|woff2?|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, stale-while-revalidate=604800"
    </FilesMatch>
    # mod_deflate appends "-gzip" to the ETag; the browser sends that back in If-None-Match, but Apache compares it with the
    # plain ETag and answers 200 with the whole body instead of 304. DeflateAlterETag NoChange fixes it, but is allowed in the
    # server/vhost config only (docs/nginx.md, "Compression"): here the ETag of the compressible assets is dropped, the
    # browser revalidates with Last-Modified (If-Modified-Since -> 304) instead
    <FilesMatch "\.(css|js|mjs|svg|json)$">
        Header unset ETag
    </FilesMatch>
    # versioned images and the icon sprite (?v=<mtime>, e.g. srcset variants, lucide.svg): immutable as well
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=/ && %{HTTP_HOST} !~ /\.ddev\.site(:[0-9]+)?$/"
    </FilesMatch>
</IfModule>

# Theme metadata (styles/theme/*/style.cfg, settings.cfg) is read by PHP, not served
<FilesMatch "\.cfg$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Never serve dotfiles
    RewriteRule "(^|/)\." - [F]

    # Multi-universe URLs: /uni2/<path> -> <path>, universe passed as REDIRECT_UNI
    RewriteRule ^uni([0-9]+)/?(.*)$ $2 [E=UNI:$1]

    # Determine the RewriteBase automatically
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # WebP copies (bin/console app:images:webp): foo.png -> foo.png.webp for browsers that accept WebP;
    # animated images have no copy and stay as they are
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME} \.(png|jpe?g|gif)$ [NC]
    RewriteCond %{REQUEST_FILENAME}.webp -f
    RewriteRule ^(.+)$ $1.webp [T=image/webp,E=WEBP:1,L]

    # Existing files (assets, symlinked legacy asset dirs) are served directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else goes through the front controller (Symfony or the legacy bridge)
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>
